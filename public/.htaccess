# Corrêa Lima Advocacia — regras Apache para hospedagem compartilhada (HostGator)
# Site 100% estático (Astro): não há Node no servidor.

RewriteEngine On

# 1) Canonicalização de host e protocolo (uma passada, sem loop).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://correalimaadvocacia.com.br%{REQUEST_URI} [R=301,L]

# 2) Redirecionamentos permanentes (301).
# 2a) URL antiga de comércio exterior -> núcleo Direito Aduaneiro-Tributário.
#     A URL antiga não é mais gerada (ETAPA 5); o 301 preserva autoridade.
RewriteRule ^areas-de-atuacao/direito-aduaneiro-comercio-exterior/?$ /areas-de-atuacao/direito-aduaneiro-tributario/ [R=301,L]

# 2b) Auditoria 11/2026 — páginas duplicadas consolidadas (mesma intenção de busca).
RewriteRule ^areas-de-atuacao/cobranca-condominial-recuperacao-de-inadimplencia/?$ /areas-de-atuacao/cobranca-condominial/ [R=301,L]
RewriteRule ^areas-de-atuacao/execucao-cobranca-recuperacao-de-credito/?$ /areas-de-atuacao/recuperacao-de-credito/ [R=301,L]
RewriteRule ^areas-de-atuacao/inventario-e-partilha/?$ /areas-de-atuacao/inventario-e-patrimonio/ [R=301,L]
RewriteRule ^areas-de-atuacao/advogado-para-homologacao-de-sentenca-estrangeira/?$ /areas-de-atuacao/homologacao-de-sentenca-estrangeira/ [R=301,L]
RewriteRule ^blog/heredeiro-exterior-procuracao-documentos-inventario/?$ /blog/herdeiro-exterior-procuracao-documentos-inventario/ [R=301,L]
RewriteRule ^areas-de-atuacao/advocacia-empresarial/?$ /areas-de-atuacao/direito-empresarial/ [R=301,L]
RewriteRule ^areas-de-atuacao/reconhecimento-de-decisoes-estrangeiras/?$ /areas-de-atuacao/homologacao-de-sentenca-estrangeira/ [R=301,L]

# 2e) /index.html e /pasta/index.html -> URL canônica com barra (só pedidos externos, sem loop com DirectoryIndex).
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# 2d) Sitemaps antigos ainda lidos pelo Google e resíduo de spam de 2020.
RewriteRule ^sitemap-(0|index)\.xml$ /sitemap.xml [R=301,L]
# Rodada 3: artigos rasos consolidados nas páginas de serviço de mesma intenção
RewriteRule ^blog/inventario-com-herdeiro-no-exterior-o-que-muda/?$ /areas-de-atuacao/inventario-com-herdeiro-no-exterior/ [R=301,L]
RewriteRule ^blog/divorcio-exterior-precisa-ser-homologado-no-brasil/?$ /areas-de-atuacao/homologacao-de-divorcio-estrangeiro/ [R=301,L]
RewriteRule ^sitemapsindex\.xml$ - [G,L]
RewriteRule ^qcgii\.php$ - [G,L]

# 2c) Auditoria 11/2026 — conteúdos retirados do site: 410 (removido de propósito).
#     Não redirecionar para páginas de outro público (o Google trata como soft 404).
RewriteRule ^guias/direito-do-trabalho/?$ https://correalimaadv.com.br/ [R=301,L]
# Artigos trabalhistas antigos: migrados para o site trabalhista (301 preserva o histórico no Google)
RewriteRule ^blog/acidente-de-trabalho-direitos-do-trabalhador/?$ https://correalimaadv.com.br/acidente-de-trabalho/ [R=301,L]
RewriteRule ^blog/como-calcular-ferias-e-decimo-terceiro/?$ https://correalimaadv.com.br/blog/ferias-e-decimo-terceiro-na-rescisao/ [R=301,L]
RewriteRule ^blog/como-funcionam-as-horas-extras/?$ https://correalimaadv.com.br/horas-extras/ [R=301,L]
RewriteRule ^blog/fgts-nao-depositado-o-que-fazer/?$ https://correalimaadv.com.br/fgts-nao-depositado/ [R=301,L]
RewriteRule ^blog/justa-causa-pode-ser-contestada/?$ https://correalimaadv.com.br/justa-causa-indevida/ [R=301,L]
RewriteRule ^blog/o-que-caracteriza-assedio-moral-no-trabalho/?$ https://correalimaadv.com.br/assedio-moral-no-trabalho/ [R=301,L]
RewriteRule ^blog/quais-documentos-guardar-apos-a-demissao/?$ https://correalimaadv.com.br/blog/documentos-para-guardar-apos-a-demissao/ [R=301,L]
RewriteRule ^blog/reconhecimento-de-vinculo-de-emprego/?$ https://correalimaadv.com.br/trabalho-sem-carteira-assinada/ [R=301,L]
RewriteRule ^blog/trabalho-sem-carteira-assinada-direitos/?$ https://correalimaadv.com.br/trabalho-sem-carteira-assinada/ [R=301,L]
RewriteRule ^blog/verbas-devidas-na-demissao-sem-justa-causa/?$ https://correalimaadv.com.br/verbas-rescisorias-nao-pagas/ [R=301,L]
RewriteRule ^imigracao-estados-unidos(/.*)?$ - [G,L]
RewriteRule ^areas-de-atuacao/imigracao-estados-unidos/?$ - [G,L]
RewriteRule ^areas-de-atuacao/maritimo-e-portuario/?$ - [G,L]

# 3) Cabeçalhos de segurança (ETAPA 20).
<IfModule mod_headers.c>
  # Páginas de reclamante (areas-de-atuacao/direito-do-trabalho etc.): fora do menu, do sitemap e do
  # Google (noindex), mas no ar porque servem de destino de anúncios ativos. Não apagar sem checar os anúncios.
  <If "%{REQUEST_URI} =~ m#^/(areas-de-atuacao/direito-do-trabalho|advogado-trabalhista|trab/|trabalhista/)#">
    Header always set X-Robots-Tag "noindex, follow"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "unsafe-none"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://formspree.io; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://www.google-analytics.com https://*.clarity.ms; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://*.clarity.ms https://c.bing.com https://formspree.io; upgrade-insecure-requests"
</IfModule>

# 4) Compressão (Core Web Vitals).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 application/font-woff2
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml text/plain
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json image/svg+xml font/woff2
</IfModule>

# 5) Cache de assets estáticos (ETAPA 21).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:woff2|css|js|svg|webp|avif|png|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# 6) Página de erro 404 personalizada.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# 7) Nunca expor arquivos sensíveis.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "\.(config\.php|local\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.(htaccess|htpasswd|gitignore)$">
  Require all denied
</FilesMatch>
