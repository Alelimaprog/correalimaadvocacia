---
/**
 * / — Home (Sprint 1: novo posicionamento estratégico).
 * Head (SEO) e JSON-LD construídos para o novo posicionamento empresarial:
 * title/description exclusivos, canonical na raiz, Open Graph/Twitter e
 * JSON-LD (WebSite + LegalService + FAQPage coerente com a FAQ exibida).
 * Um único h1 (no HomeHero).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeContent from '@/components/home/HomeContent.astro';
import HomeContact from '@/components/home/HomeContact.astro';
import { site } from '@/lib/site.config';
import { nucleos } from '@/lib/nucleos';
import { homeFaq } from '@/lib/home-faq';
import type { PageHead } from '@/lib/institucional';

const canonical = `${site.url}/`;
const title = 'Advogado em São Paulo: Aduaneiro, Inventário e Homologação | Corrêa Lima';
const description =
  'Advogado em São Paulo: mercadoria retida e pena de perdimento, inventário (inclusive com herdeiro no exterior) e homologação de sentença e divórcio estrangeiro.';
const ogImage = `${site.url}${site.ogImage}`;

const head: PageHead = {
  title,
  description,
  canonical,
  robots: 'index, follow',
  og: {
    title,
    description,
    url: canonical,
    type: 'website',
    site_name: site.name,
    locale: site.locale,
    image: ogImage,
  },
  twitter: { card: 'summary_large_image', title, description, image: ogImage },
};

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${canonical}#website`,
    name: site.name,
    url: canonical,
    inLanguage: 'pt-BR',
    publisher: { '@id': `${canonical}#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    '@id': `${canonical}#organization`,
    name: site.name,
    url: canonical,
    image: ogImage,
    logo: `${canonical}brand/logo-wordmark.svg`,
    email: site.contact.email,
    telephone: site.contact.whatsapp.display,
    areaServed: [
      { '@type': 'City', name: 'São Paulo' },
      { '@type': 'Country', name: 'Brasil' },
    ],
    address: {
      '@type': 'PostalAddress',
      streetAddress: `${site.contact.address.street}, ${site.contact.address.detail}`,
      addressLocality: site.contact.address.city,
      addressRegion: site.contact.address.state,
      postalCode: site.contact.address.cep,
      addressCountry: 'BR',
    },
    knowsAbout: [
      'Direito aduaneiro',
      'Pena de perdimento',
      'Retenção de mercadorias na importação',
      'Inventário e partilha',
      'Inventário extrajudicial',
      'Homologação de sentença estrangeira',
      'Homologação de divórcio estrangeiro',
      ...nucleos.map((n) => n.label),
    ],
    // Rodada 4 (13/11/2026): horário, perfis oficiais e mapa — dados do Perfil da Empresa.
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
    ],
    sameAs: ['https://www.instagram.com/correalima.adv/', 'https://www.facebook.com/profile.php?id=61588715113459'],
    hasMap: 'https://www.google.com/maps/search/?api=1&query=R.+Verbo+Divino,+2001,+S%C3%A3o+Paulo+-+SP,+04719-002',
    founder: { '@id': `${site.url}/o-escritorio/#alexandre-correa-lima` },
    employee: { '@id': `${site.url}/o-escritorio/#alexandre-correa-lima` },
  },
  {
    // Entidade do advogado responsável, com @id estável reutilizável em todo o
    // site. Sem credenciais não confirmadas (award/alumniOf/memberOf).
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/o-escritorio/#alexandre-correa-lima`,
    name: site.attorney.name,
    image: `${site.url}/brand/alexandre-correa-lima-760.webp`,
    identifier: { '@type': 'PropertyValue', propertyID: 'OAB/SP', value: '234511' },
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Inscrição na Ordem dos Advogados do Brasil',
      name: 'OAB/SP 234.511',
      recognizedBy: { '@type': 'Organization', name: 'Ordem dos Advogados do Brasil, Seção de São Paulo' },
    },
    jobTitle: 'Advogado — direito aduaneiro, inventário e homologação de sentença estrangeira',
    url: `${canonical}o-escritorio/`,
    worksFor: { '@id': `${canonical}#organization` },
    knowsAbout: nucleos.map((n) => n.label),
    areaServed: 'BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout head={head} footerCta={false}>
  <Fragment slot="jsonld">
    {jsonld.map((schema) => <JsonLd schema={schema} />)}
  </Fragment>

  <main id="conteudo-principal">
    <HomeHero />
    <HomeContent />
    <HomeContact />
  </main>
</BaseLayout>
