---
/**
 * Landing de advocacia trabalhista para o trabalhador — tráfego pago.
 *
 * Direção aprovada: campo preto + retrato como acontecimento no hero,
 * ruptura para papel na leitura, alternância de campos como ritmo,
 * tipografia Archivo (eixo de largura) como única família, verde só com
 * função. Zero JavaScript: a interação do índice é <details> nativo.
 *
 * Fotografia: alexandre-correa-lima-trabalhista.png (640x641). Tratamento
 * exclusivamente fotográfico — monocromático, exposição, contraste, queda
 * de luz por posição — com o ponto de preto casado ao fundo da página no
 * hero e o ponto de branco (e a matiz) casados ao papel na assinatura.
 */
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { site } from '@/lib/site.config';

const SITUACOES = [
  {
    fala: 'Me mandaram embora e acho que pagaram errado.',
    resposta:
      'O acerto se divide em várias parcelas — aviso, férias, décimo terceiro, saldo de salário, multa do FGTS — e cada uma tem regra própria. Comparar o que foi pago com o que consta no contrato, nos holerites e no extrato do FGTS costuma ser o primeiro passo.',
  },
  {
    fala: 'Estou trabalhando sem registro na carteira.',
    resposta:
      'A falta de registro não apaga o vínculo de emprego: o que pesa é como o trabalho acontecia na prática — horário, ordens recebidas, continuidade. Conversas, escalas, comprovantes de pagamento e quem trabalhava junto costumam ser o material que sustenta essa análise.',
  },
  {
    fala: 'Faço hora extra e não recebo.',
    resposta:
      'Nem toda hora além do expediente é tratada da mesma forma. Jornada contratada, intervalos, controle de ponto e forma de pagamento precisam ser lidos em conjunto antes de qualquer conclusão.',
  },
  {
    fala: 'Meu FGTS não está sendo depositado.',
    resposta:
      'Os depósitos são mensais e ficam registrados no extrato da Caixa. Ler o extrato ao lado dos holerites mostra se existe período em aberto e desde quando — é daí que parte a análise.',
  },
  {
    fala: 'Quero sair porque a empresa não cumpre o combinado.',
    resposta:
      'Quando a empresa descumpre o que foi acordado, existe um caminho para encerrar o contrato sem que isso conte como pedido de demissão. Depende de conseguir demonstrar o descumprimento, então vale reunir o material antes de tomar qualquer atitude.',
  },
  {
    fala: 'Estão me pressionando ou me humilhando no trabalho.',
    resposta:
      'Situações assim dependem muito do contexto, da frequência e de quem praticou. Guardar datas, mensagens e lembrar quem presenciou é o que costuma tornar a análise possível.',
  },
  {
    fala: 'Levei justa causa e acho que foi injusta.',
    resposta:
      'A justa causa exige motivo previsto em lei, e a punição precisa ser compatível com o que aconteceu. Vale entender qual foi o motivo informado, o que veio antes e se já houve punição pelo mesmo fato.',
  },
  {
    fala: 'Me contrataram como PJ, mas trabalho como funcionário.',
    resposta:
      'O que define o vínculo de emprego não é o nome do contrato, e sim a rotina: horário, ordens, exclusividade, se outra pessoa poderia fazer seu trabalho no seu lugar. Contrato, mensagens e notas emitidas ajudam a mostrar como era o dia a dia.',
  },
  {
    fala: 'Me machuquei trabalhando.',
    resposta:
      'Acidente e doença ligados ao trabalho envolvem afastamento, estabilidade no emprego e benefício do INSS — cada frente com procedimento próprio. Documentos do atendimento, a CAT (Comunicação de Acidente de Trabalho) e laudos médicos são o ponto de partida.',
  },
  {
    fala: 'Meu caso é outro.',
    resposta:
      'Situação de trabalho raramente cabe numa lista. Se a sua não está aqui, contar o que aconteceu com as suas próprias palavras já é suficiente para começar.',
  },
];

const MATERIAL = [
  {
    traz: 'Holerites, extrato do FGTS, rescisão',
    mostra: 'O que foi pago, em que parcelas, e o que ficou em aberto.',
  },
  {
    traz: 'Ponto, escalas, conversas de trabalho',
    mostra: 'A jornada que existiu de fato — que nem sempre é a que está no papel.',
  },
  {
    traz: 'Contrato, mensagens, notas emitidas',
    mostra: 'Como o trabalho acontecia no dia a dia: horário, ordens, exclusividade.',
  },
  {
    traz: 'Datas, testemunhas, atendimentos',
    mostra: 'A sequência dos fatos, que é o que sustenta qualquer análise.',
  },
];

const WHATSAPP =
  'https://wa.me/5511975025611?text=' +
  encodeURIComponent('Olá. Queria contar uma situação de trabalho e entender o que pode ser feito.');

/* Endereço, e-mail, telefone e OAB vêm de src/lib/site.config.ts — a mesma
   fonte que alimenta o rodapé do site. Nada é redigitado aqui. */
const { address, email, whatsapp } = site.contact;
const MAPA =
  'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(address.full);
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Advogado trabalhista para o trabalhador | Corrêa Lima Advocacia</title>
    <meta
      name="description"
      content="Você conta o que aconteceu no seu trabalho, com as suas palavras. A gente explica o que costuma ser analisado e o que pode ser feito."
    />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://correalimaadvocacia.com.br/trab/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Corrêa Lima Advocacia" />
    <meta property="og:url" content="https://correalimaadvocacia.com.br/trab/" />
    <meta property="og:title" content="Advogado trabalhista para o trabalhador | Corrêa Lima Advocacia" />
    <meta
      property="og:description"
      content="Você conta o que aconteceu no seu trabalho, com as suas palavras. A gente explica o que costuma ser analisado e o que pode ser feito."
    />
    <meta property="og:image" content="https://correalimaadvocacia.com.br/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" as="image" href="/brand/alexandre-trabalhista-noite.jpg" />
    <style define:vars={{ archivo: `url(${archivo})` }}>
      @font-face {
        font-family: 'Archivo';
        font-style: normal;
        font-weight: 100 900;
        font-stretch: 62% 125%;
        font-display: swap;
        src: var(--archivo) format('woff2-variations');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
          U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
      }
    </style>
  </head>

  <body>
    {/* Campo escuro */}
    <div class="noite">
      <header class="cabecalho">
        <span class="marca">Corrêa Lima Advocacia</span>
        <a class="cabecalho__link" href={WHATSAPP} target="_blank" rel="nofollow noopener">Conte sua situação</a>
      </header>

      <section class="hero">
        <img
          class="hero__retrato"
          src="/brand/alexandre-trabalhista-noite.jpg"
          width="480"
          height="641"
          alt="Alexandre Corrêa Lima, advogado responsável pelo atendimento"
          fetchpriority="high"
        />
        <div class="hero__texto">
          <p class="hero__area">
            <span class="hero__marca-verde" aria-hidden="true"></span>Advocacia trabalhista para
            quem trabalha
          </p>
          <h1 class="hero__titulo">Antes de decidir, <br />entenda a sua situação.</h1>
          <p class="hero__assinatura">
            <b>Alexandre Corrêa Lima</b><span>Advogado · OAB/SP 234511</span>
          </p>
        </div>
      </section>
    </div>

    {/* Ruptura para o campo claro */}
    <main>
      <div class="campo campo--dia">
        <section class="indice" aria-label="Situações de trabalho">
        <div class="coluna">
          <h2 class="pergunta">O que está acontecendo <br />no seu trabalho?</h2>
          <p class="instrucao">Encontre a frase mais parecida com a sua situação.</p>
          <ol class="lista">
            {
              SITUACOES.map((s, i) => (
                <li class={i === SITUACOES.length - 1 ? 'linha linha--saida' : 'linha'}>
                  <details name="situacao">
                    <summary>
                      <span class="linha__marca" aria-hidden="true" />
                      <span class="linha__fala">{s.fala}</span>
                    </summary>
                    <div class="linha__resposta">
                      <p>{s.resposta}</p>
                      <a class="linha__acao" href={WHATSAPP} target="_blank" rel="nofollow noopener">
                        Contar o que aconteceu comigo
                      </a>
                    </div>
                  </details>
                </li>
              ))
            }
          </ol>
        </div>

        </section>
      </div>

      {/* 03 · O que decide um caso — volta ao campo escuro */}
      <div class="campo campo--noite">
        <section class="metodo">
          <h2 class="metodo__titulo">
            O que decide um caso não é a versão. <br />É o que dá para demonstrar.
          </h2>
          <p class="metodo__lead">
            Por isso a primeira conversa é sobre material: o que existe, o que dá para reunir e o
            que aquilo mostra sobre a sua rotina de trabalho.
          </p>

          <dl class="pauta">
            {
              MATERIAL.map((m) => (
                <div class="pauta__par">
                  <dt class="pauta__traz">{m.traz}</dt>
                  <dd class="pauta__mostra">{m.mostra}</dd>
                </div>
              ))
            }
          </dl>

          <p class="metodo__fecho">
            <b>
              Nem toda situação vira processo. Olhar esse material com calma é o que permite dizer
              do que se trata e quais medidas cabem. <span>E se você não guardou nada, isso não
              encerra a conversa — boa parte desses documentos pode ser obtida depois.</span>
            </b>
          </p>
        </section>
      </div>

      {/* 04 · Quem vai olhar — a declaração assinada */}
      <div class="campo campo--dia">
        <section class="autor">
          <h2 class="autor__declaracao">
            Antes de dizer se existe uma medida a tomar, <br />alguém precisa entender o que aconteceu.
          </h2>

          <div class="autor__corpo">
            <p>
              Esse alguém sou eu. Quem lê os seus documentos, ouve a sua versão e diz do que se
              trata é a mesma pessoa que vai conduzir o caso, se houver caso a conduzir.
            </p>
            <p>
              Por isso a primeira conversa não termina com uma proposta. Termina com você
              entendendo a sua própria situação — inclusive quando a conclusão é que não há medida
              a tomar.
            </p>
          </div>

          <div class="autor__assinatura">
            <img
              class="autor__retrato"
              src="/brand/alexandre-assinatura.jpg"
              width="248"
              height="245"
              alt=""
              loading="lazy"
            />
            <p class="autor__nome">
              <b>Alexandre Corrêa Lima</b>
              <span>Advogado responsável pelo atendimento</span>
            </p>
          </div>
        </section>
      </div>

      {/* 05 · O percurso — uma frase que anda */}
      <div class="campo campo--noite">
        <section class="percurso">
          <h2 class="percurso__frase">
            Você conta o que <span class="atado">aconteceu<span
                class="fio fio--a"
                aria-hidden="true"
              /></span>a gente entende a <span class="atado">situação<span
                class="fio fio--b"
                aria-hidden="true"
              /></span>vê o que existe para <span class="atado">analisar<span
                class="fio fio--c"
                aria-hidden="true"
              /></span>e explica quais são os próximos passos.
          </h2>
          <p class="percurso__nota">
            <b>
              Holerites, mensagens, cartão de ponto, contrato ou termo de rescisão encurtam o
              caminho. <span>Mas não são condição para começar: se você não tem tudo em mãos,
              conte primeiro o que aconteceu — o resto se busca depois.</span>
            </b>
          </p>
        </section>
      </div>

      {/* 06 · Fecho — o díptico */}
      <div class="campo campo--noite">
        <section class="saida">
          <h2 class="saida__troca">
            <span class="saida__voce">Você explica o que aconteceu.</span>
            <span class="saida__nos">Nós explicamos o que pode ser feito.</span>
          </h2>

          <div class="saida__acao">
            <a class="saida__cta" href={WHATSAPP} target="_blank" rel="nofollow noopener">
              {/* Mesmo glifo do restante do site (src/components/Icon.astro),
                  embutido porque o CSS com escopo desta página não alcança o
                  SVG renderizado por outro componente. */}
              <svg class="saida__zap" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.6 6.4A8.9 8.9 0 0 0 12 4a8.94 8.94 0 0 0-7.75 13.4L3 21l3.7-1.2A8.94 8.94 0 0 0 12 21a8.94 8.94 0 0 0 6.3-15.6zM12 19.3a7.3 7.3 0 0 1-3.73-1.02l-.27-.16-2.2.7.72-2.14-.18-.28A7.32 7.32 0 1 1 19.3 12 7.32 7.32 0 0 1 12 19.3z" />
                <path d="M15.1 13.6c-.2-.1-1.2-.6-1.4-.65-.2-.08-.34-.1-.48.1s-.55.65-.67.78-.25.15-.46.05a5.87 5.87 0 0 1-1.73-1.07 6.5 6.5 0 0 1-1.2-1.49c-.13-.2 0-.32.1-.42.1-.1.2-.25.3-.37a1.4 1.4 0 0 0 .2-.34.38.38 0 0 0 0-.36c-.05-.1-.48-1.15-.66-1.58s-.35-.36-.48-.37h-.4a.79.79 0 0 0-.57.27 2.4 2.4 0 0 0-.75 1.78 4.17 4.17 0 0 0 .87 2.2 9.5 9.5 0 0 0 3.63 3.2c1.32.57 1.85.62 2.5.52.4-.06 1.2-.5 1.38-.97s.18-.88.13-.97-.18-.14-.38-.24z" />
              </svg>
              <span>Conte o que aconteceu <span class="saida__cta__canal">pelo WhatsApp</span></span>
            </a>
            <p class="saida__canal">Você escreve — não precisa ligar.</p>
          </div>
        </section>

        {/* O contato é consequência do díptico, não um segundo fecho: mesma
            escala do aviso legal, uma coluna, sem título de seção. */}
        <footer class="rodape">
          <div class="rodape__casa">
            <p class="rodape__marca">{site.name}</p>
            <p class="rodape__endereco">
              <a href={MAPA} target="_blank" rel="noopener">
                {address.street} · {address.detail}<br />
                {address.district} · {address.city} – {address.state}
                <span class="rodape__ate-cep"> · </span>
                <br class="rodape__quebra-cep" />
                <span class="nao-quebra">CEP {address.cep}</span>
              </a>
            </p>
            <p class="rodape__canais">
              <a class="rodape__canal" href={`mailto:${email}`}>{email}</a>
              <span class="rodape__sep" aria-hidden="true"> · </span>
              <a class="rodape__canal nao-quebra" href={WHATSAPP} target="_blank" rel="nofollow noopener">
                {whatsapp.display}
              </a>
            </p>
            <p class="rodape__oab">{site.attorney.name} · {site.attorney.oab}</p>
          </div>
          <p class="rodape__aviso">
            Conteúdo informativo. Nada nesta página substitui a análise individual de um caso nem
            promete resultado.
          </p>
        </footer>
      </div>
    </main>

    <style>
      :root {
        --preto: #0a0a0b;
        --claro: #ece7de;
        --claro-fraco: #918a7e;
        --papel: #f2efe8;
        --tinta: #16150f;
        --tinta-fraca: #565046;
        --verde: #00a85a;
        --verde-tinta: #0a5230;
      }

      * {
        box-sizing: border-box;
        margin: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
        background: var(--preto);
      }

      body {
        font-family: 'Archivo', system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      /* ══ CAMPO ESCURO ══════════════════════════════════════ */
      .noite {
        background: var(--preto);
        color: var(--claro);
      }

      .cabecalho {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 22px;
      }

      .marca {
        font-size: 14px;
        font-weight: 600;
        font-variation-settings: 'wdth' 92;
      }

      .cabecalho__link {
        font-size: 13px;
        color: var(--claro);
        text-decoration: none;
        border-bottom: 1px solid rgba(236, 231, 222, 0.45);
        padding-bottom: 2px;
      }

      /* Hero mobile: o retrato sangra pela borda inferior direita e o campo
         preto envolve em L. Não é texto empilhado sobre foto. */
      .hero {
        position: relative;
        min-height: calc(100svh - 58px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* Composição B, mobile: o retrato entra pela direita e SANGRA a borda —
         não é um retrato emoldurado ao lado do texto. As bordas de cima e da
         esquerda dissolvem no preto; a de baixo não precisa de máscara porque
         o terno já está em luminância ~1. */
      /* As bordas da fotografia já caem para preto no próprio arquivo
         (queda de luz por eixo), então não há máscara CSS: o retrato funde
         no campo por conta própria, sem ficar meio dissolvido meio emoldurado. */
      .hero__retrato {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 88%;
        height: 67%;
        object-fit: cover;
        object-position: 50% 2%;
      }

      .hero__texto {
        position: relative;
        z-index: 1;
        padding: 26px 22px 0;
      }

      .hero__area {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--claro-fraco);
        white-space: nowrap;
      }

      /* Único ponto de verde do campo escuro. */
      .hero__marca-verde {
        flex: none;
        width: 18px;
        height: 2px;
        background: var(--verde);
      }

      .hero__titulo {
        margin-top: 22px;
        font-size: clamp(2.1rem, 8.4vw, 3.6rem);
        line-height: 1.04;
        letter-spacing: -0.024em;
        font-weight: 500;
        font-variation-settings: 'wdth' 84;
      }

      .hero__assinatura {
        margin-top: 18px;
        font-size: 13px;
        line-height: 1.45;
      }

      .hero__assinatura b {
        display: block;
        font-weight: 600;
      }

      .hero__assinatura span {
        color: var(--claro-fraco);
      }

      /* ══ CAMPO CLARO ═══════════════════════════════════════ */
      .campo {
        padding: 0 22px;
      }

      .campo--dia {
        background: var(--papel);
        color: var(--tinta);
      }

      .campo--noite {
        background: var(--preto);
        color: var(--claro);
      }

      /* ══ 03 · O QUE DECIDE UM CASO ═════════════════════════
         Textura deliberadamente oposta à do índice: pares em pauta,
         sem filete por linha, separados por espaço. Mesma família
         tipográfica, papel de cada peça trocado. */
      .metodo {
        padding: 76px 0 86px;
      }

      .metodo__titulo {
        font-size: clamp(1.62rem, 6.6vw, 2.3rem);
        line-height: 1.1;
        letter-spacing: -0.021em;
        font-weight: 500;
        font-variation-settings: 'wdth' 86;
      }

      .metodo__lead {
        margin-top: 20px;
        max-width: 44ch;
        font-size: 16px;
        line-height: 1.55;
        color: var(--claro-fraco);
      }

      .pauta {
        margin: 46px 0 0;
      }

      .pauta__par + .pauta__par {
        margin-top: 30px;
      }

      .pauta__traz {
        font-size: 11.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--claro);
        font-variation-settings: 'wdth' 96;
      }

      .pauta__mostra {
        margin: 7px 0 0;
        font-size: 16.5px;
        line-height: 1.5;
        color: var(--claro-fraco);
        max-width: 46ch;
      }

      .metodo__fecho {
        margin-top: 54px;
        padding-top: 22px;
        border-top: 1px solid rgba(236, 231, 222, 0.22);
        font-size: 16px;
        line-height: 1.55;
      }

      .metodo__fecho b {
        font-weight: 400;
        display: block;
        max-width: 52ch;
      }

      .metodo__fecho span {
        color: var(--claro-fraco);
      }

      .pergunta {
        padding-top: 60px;
        font-size: clamp(1.7rem, 7.2vw, 2.4rem);
        line-height: 1.06;
        letter-spacing: -0.021em;
        font-weight: 500;
        font-variation-settings: 'wdth' 88;
      }

      .instrucao {
        margin-top: 18px;
        padding-bottom: 14px;
        color: var(--tinta-fraca);
        font-size: 15px;
      }

      .lista {
        list-style: none;
        padding: 0;
        border-top: 1px solid var(--tinta);
      }

      .linha {
        border-bottom: 1px solid rgba(22, 21, 15, 0.16);
      }

      .linha summary {
        display: flex;
        align-items: baseline;
        gap: 14px;
        padding: 16px 0;
        cursor: pointer;
        list-style: none;
      }

      .linha summary::-webkit-details-marker {
        display: none;
      }

      .linha__marca {
        flex: none;
        width: 13px;
        height: 1px;
        background: rgba(22, 21, 15, 0.4);
        translate: 0 -0.42em;
        transition: width 160ms ease, background-color 160ms ease;
      }

      details[open] .linha__marca {
        width: 26px;
        background: var(--verde-tinta);
      }

      .linha__fala {
        font-size: 18px;
        line-height: 1.32;
        letter-spacing: -0.006em;
        font-variation-settings: 'wdth' 96;
      }

      details[open] .linha__fala {
        font-weight: 600;
      }

      .linha--saida {
        border-bottom: none;
      }

      .linha--saida summary {
        padding-top: 24px;
      }

      .linha--saida .linha__fala {
        color: var(--tinta-fraca);
        font-style: italic;
      }

      .linha__resposta {
        margin-left: 27px;
        padding: 0 0 26px 15px;
        border-left: 1px solid var(--verde-tinta);
        max-width: 34rem;
      }

      .linha__resposta p {
        color: var(--tinta-fraca);
        font-size: 16px;
        line-height: 1.56;
      }

      .linha__acao {
        display: inline-block;
        margin-top: 16px;
        font-size: 15px;
        font-weight: 500;
        color: var(--verde-tinta);
        text-decoration: none;
        border-bottom: 1px solid var(--verde-tinta);
        padding-bottom: 2px;
      }



      /* ══ 04 · QUEM VAI OLHAR ═══════════════════════════════
         A página troca de voz: depois de dois blocos impessoais,
         a primeira pessoa entra em escala grande. O retrato volta
         minúsculo e no campo claro — inversão total do hero — com
         o ponto de BRANCO casado ao papel, do mesmo modo que no
         hero o ponto de preto foi casado ao fundo escuro. */
      .autor {
        padding: 78px 0 56px;
      }

      .autor__declaracao {
        font-size: clamp(1.78rem, 7.4vw, 2.6rem);
        line-height: 1.08;
        letter-spacing: -0.024em;
        font-weight: 500;
        font-variation-settings: 'wdth' 84;
      }

      .autor__corpo {
        margin-top: 34px;
        max-width: 46ch;
      }

      .autor__corpo p {
        font-size: 16.5px;
        line-height: 1.58;
        color: var(--tinta-fraca);
      }

      .autor__corpo p + p {
        margin-top: 18px;
      }

      .autor__assinatura {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 46px;
        padding-top: 26px;
        border-top: 1px solid rgba(22, 21, 15, 0.2);
      }

      .autor__retrato {
        flex: none;
        width: 76px;
        height: auto;
        display: block;
      }

      .autor__nome {
        font-size: 14px;
        line-height: 1.45;
      }

      .autor__nome b {
        display: block;
        font-weight: 600;
      }

      .autor__nome span {
        color: var(--tinta-fraca);
      }

      /* ══ 05 · O PERCURSO ═══════════════════════════════════
         Banda curta e escura, quebrando o compasso das anteriores.
         O caminho é UMA frase; os filetes de comprimentos desiguais
         fazem o papel do conectivo, no lugar de seta, número ou card. */
      .percurso {
        padding: 62px 0 28px;
      }

      .percurso__frase {
        font-size: clamp(1.42rem, 5.8vw, 2rem);
        line-height: 1.32;
        letter-spacing: -0.017em;
        font-weight: 500;
        font-variation-settings: 'wdth' 88;
      }

      /* O filete fica atado à palavra anterior: assim nunca abre linha,
         onde seria lido como marcador de lista. */
      .atado {
        white-space: nowrap;
      }

      .fio {
        display: inline-block;
        height: 1px;
        vertical-align: 0.3em;
        margin: 0 12px;
        background: rgba(236, 231, 222, 0.5);
      }

      .fio--a { width: 30px; }
      .fio--b { width: 48px; }
      .fio--c { width: 38px; }

      .percurso__nota {
        margin-top: 34px;
        padding-top: 20px;
        border-top: 1px solid rgba(236, 231, 222, 0.18);
        font-size: 15px;
        line-height: 1.55;
      }

      .percurso__nota b {
        font-weight: 500;
        display: block;
        max-width: 64ch;
      }

      .percurso__nota span {
        color: var(--claro-fraco);
      }




      /* ══ 06 · FECHO — o díptico ════════════════════════════
         A pagina vinha comprimindo (1111 -> 1084 -> 624 -> 406).
         Aqui ela reabre: silencio longo no topo, depois a maior massa
         tipografica desde o hero. O filete que separa as duas sentencas
         atravessa a largura inteira e e o fulcro da frase — o mesmo
         vocabulario de filete do indice, da pauta e do percurso, agora
         na sua maior escala. Sem fotografia: aqui o acontecimento e
         tipografia e espaco. */
      .saida {
        padding: 118px 0 0;
      }

      .saida__troca {
        font-size: clamp(1.95rem, 8vw, 2.9rem);
        line-height: 1.1;
        letter-spacing: -0.024em;
        font-weight: 500;
        font-variation-settings: 'wdth' 84;
      }

      .saida__voce,
      .saida__nos {
        display: block;
      }

      .saida__voce {
        padding-bottom: 22px;
        color: var(--claro-fraco);
      }

      .saida__nos {
        padding-top: 22px;
        border-top: 1px solid rgba(236, 231, 222, 0.34);
      }

      .saida__acao {
        margin-top: 76px;
      }

      /* O CTA repete a primeira metade da frase: a acao e a frase sendo
         executada, nao um botao pedindo clique. Link tipografico com
         filete — nunca pilula. */
      .saida__cta {
        display: inline-block;
        font-size: clamp(0.8rem, 4.1vw, 1.32rem);
        font-weight: 500;
        letter-spacing: -0.012em;
        color: var(--claro);
        text-decoration: none;
        border-bottom: 2px solid var(--verde);
        padding-bottom: 5px;
      }

      /* O símbolo identifica o canal e nada mais: monocromático, na cor do
         texto, do tamanho de uma maiúscula. O verde da página continua sendo
         um só — o filete sob a frase. */
      .saida__zap {
        width: 0.92em;
        height: 0.92em;
        margin-right: 10px;
        vertical-align: -0.06em;
      }

      /* Só o canal é indivisível; a frase pode quebrar se algum aparelho
         muito estreito exigir — melhor duas linhas do que estourar a coluna. */
      .saida__cta__canal {
        white-space: nowrap;
      }

      .saida__canal {
        margin-top: 20px;
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--claro-fraco);
        max-width: 34ch;
      }

      .rodape {
        margin-top: 104px;
        padding: 22px 0 40px;
        border-top: 1px solid rgba(236, 231, 222, 0.14);
      }

      .rodape__marca {
        font-size: 12.5px;
        letter-spacing: 0.055em;
        text-transform: uppercase;
        color: var(--claro-fraco);
      }

      /* Endereço, canais e OAB: uma coluna de linhas curtas, todas na mesma
         escala do aviso legal. Prova de que existe uma casa — não um bloco
         de conversão. */
      .rodape__endereco,
      .rodape__canais,
      .rodape__oab {
        margin-top: 7px;
        font-size: 12.5px;
        line-height: 1.55;
        color: rgba(145, 138, 126, 0.9);
      }

      .rodape__oab {
        margin-top: 9px;
      }

      .nao-quebra {
        white-space: nowrap;
      }

      /* Três blocos sublinhados empilhados viram listra. O endereço fica em
         texto limpo — abre o mapa, mas não anuncia isso o tempo todo; só
         e-mail e telefone, que o leitor procura para acionar, trazem filete. */
      .rodape a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: color 140ms ease, border-color 140ms ease;
      }

      .rodape__canais a {
        border-bottom-color: rgba(145, 138, 126, 0.32);
      }

      /* Mesma solução de alvo de toque usada no resto da página: a área
         clicável cresce por pseudo-elemento, sem deslocar o filete. O espaço
         entre os dois canais empilhados é do tamanho da área, para que uma
         não roube o toque da outra. */
      .rodape__canal {
        position: relative;
        display: inline-block;
      }

      .rodape__canal::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: -8px;
        bottom: -8px;
      }

      .rodape a:hover {
        color: var(--claro);
        border-bottom-color: var(--claro-fraco);
      }

      .rodape__aviso {
        margin-top: 26px;
        font-size: 12.5px;
        line-height: 1.5;
        color: rgba(145, 138, 126, 0.62);
        max-width: 64ch;
      }

      /* ── Estados: foco visível nos dois campos, hover discreto, e alvo
         de toque de 44px nos links de texto sem mover nada na tela. ── */
      :focus-visible {
        outline: 2px solid var(--verde);
        outline-offset: 4px;
      }

      .campo--dia :focus-visible,
      .campo--dia summary:focus-visible {
        outline-color: var(--verde-tinta);
      }

      summary:focus-visible {
        outline-offset: 2px;
      }

      /* Alvo de toque ≥ 44px sem mover o sublinhado: a área clicável é
         estendida por um pseudo-elemento invisível, não por padding. */
      .cabecalho__link,
      .linha__acao,
      .saida__cta {
        position: relative;
        transition: border-color 140ms ease, color 140ms ease;
      }

      .cabecalho__link::before,
      .linha__acao::before,
      .saida__cta::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: -12px;
        bottom: -12px;
      }

      .cabecalho__link:hover {
        border-bottom-color: var(--claro);
      }

      .linha__acao:hover {
        color: var(--tinta);
        border-bottom-color: var(--tinta);
      }

      .saida__cta:hover {
        color: #fff;
        border-bottom-color: var(--claro);
      }

      summary:hover .linha__fala {
        color: var(--tinta);
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }

      /* ══ Abaixo de 390px ══════════════════════════════════
         O rótulo do cabeçalho é mais longo do que a régua de 390px
         supõe. Só aqui o compasso do topo aperta; nada muda em 390+. */
      @media (max-width: 389px) {
        .cabecalho {
          padding: 18px 16px;
          gap: 12px;
        }

        .cabecalho__link {
          font-size: 12px;
        }
      }

      /* Até 768px os dois canais ocupam uma linha cada: sem separador
         sobrando no fim da linha e sem "·" abrindo linha como marcador.
         O filete acompanha o texto, nunca a coluna. */
      @media (max-width: 767px) {
        .rodape__sep {
          display: none;
        }

        /* No celular o CEP desce para a própria linha: sem isso a linha
           anterior termina num "·" solto, e um "·" abrindo linha vira
           marcador de lista. */
        .rodape__ate-cep {
          display: none;
        }

        /* Empilhados, os dois canais precisam de 16px entre si para que as
           áreas de toque não se sobreponham. Os grupos vizinhos afastam-se
           mais do que isso, senão o rodapé vira quatro itens soltos em vez
           de nome / endereço / canais / registro. */
        .rodape__canais,
        .rodape__oab {
          margin-top: 22px;
        }

        .rodape__canal {
          display: block;
          width: fit-content;
        }

        .rodape__canal ~ .rodape__canal {
          margin-top: 16px;
        }
      }

      /* ══ 768px ═════════════════════════════════════════════ */
      @media (min-width: 768px) {
        .rodape__quebra-cep {
          display: none;
        }

        .cabecalho {
          padding: 22px 40px;
        }

        .hero {
          min-height: min(calc(100svh - 64px), 650px);
        }

        .hero__retrato {
          width: 48%;
          height: 78%;
          object-position: 50% 3%;
        }

        .hero__texto {
          padding: 44px 40px 0;
        }

        .hero__titulo {
          font-size: clamp(2.8rem, 5vw, 3.8rem);
        }

        .campo {
          padding: 0 40px;
        }

        .indice {
          padding-bottom: 120px;
        }

        .coluna {
          max-width: 40rem;
        }

        .metodo {
          padding: 104px 0 112px;
        }

        .pauta__par {
          display: grid;
          grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
          gap: 0 36px;
          align-items: baseline;
        }

        .pauta__traz {
          text-align: right;
        }

        .pauta__par + .pauta__par {
          margin-top: 34px;
        }

        .pauta__mostra {
          margin-top: 0;
        }

        .autor {
          padding: 108px 0 72px;
        }

        .autor__corpo {
          margin-top: 40px;
        }

        .percurso {
          padding: 76px 0 34px;
        }

        .saida {
          padding: 148px 0 0;
        }

        .saida__acao {
          margin-top: 92px;
        }

        .rodape {
          margin-top: 120px;
        }


      }

      /* ══ 1024px+ ═══════════════════════════════════════════ */
      @media (min-width: 1024px) {
        .cabecalho {
          padding: 26px clamp(48px, 5vw, 88px);
        }

        .hero {
          justify-content: flex-end;
        }

        .hero__retrato {
          right: 0;
          bottom: 0;
          width: 33%;
          height: 80%;
          object-position: 52% 0%;
          -webkit-mask-image: linear-gradient(to right, transparent, #000 38%),
            linear-gradient(to bottom, transparent 2%, #000 28%);
          mask-image: linear-gradient(to right, transparent, #000 38%),
            linear-gradient(to bottom, transparent 2%, #000 28%);
        }

        .hero__texto {
          padding: 0 35% 118px clamp(48px, 5vw, 88px);
        }

        .hero__titulo {
          font-size: clamp(3.2rem, 4.6vw, 4.3rem);
          font-variation-settings: 'wdth' 82;
        }

        .hero__assinatura {
          margin-top: 40px;
        }

        .campo {
          padding: 0 clamp(48px, 5vw, 88px);
        }

        .indice {
          padding-bottom: 148px;
        }

        .coluna {
          max-width: 52rem;
        }

        .metodo {
          padding: 132px 0 140px;
        }

        .metodo__titulo {
          font-size: clamp(2.3rem, 3.2vw, 2.9rem);
        }

        .metodo__lead {
          margin-top: 30px;
          margin-left: calc((100% - 56px) * 4 / 11 + 56px);
          font-size: 17px;
          max-width: 46ch;
        }

        .pauta {
          margin-top: 76px;
        }

        /* Duas colunas: material à esquerda, o que ele mostra à direita.
           Relação, não lista — é o que separa esta seção do índice. */
        .pauta__par {
          display: grid;
          grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
          gap: 0 52px;
          align-items: baseline;
        }

        .pauta__traz {
          text-align: right;
        }

        .pauta__par + .pauta__par {
          margin-top: 40px;
        }

        .pauta__traz {
          padding-top: 4px;
        }

        .pauta__mostra {
          margin-top: 0;
          font-size: 18px;
        }

        .metodo__fecho {
          margin-top: 84px;
          padding-top: 26px;
          font-size: 17px;
        }

        .metodo__fecho b {
          max-width: 62ch;
        }

        /* Massa invertida em relação ao bloco 03: lá o texto vai para a
           coluna da direita e a esquerda fica vazia; aqui o texto ocupa a
           esquerda e o retrato vive na margem direita — a mesma coluna onde
           mora a marginália do índice. Os dois blocos deixam de ter o mesmo
           esqueleto. */
        .autor {
          display: grid;
          grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
          gap: 0 56px;
          padding: 140px 0 96px;
        }

        .autor__declaracao {
          grid-column: 1 / -1;
          font-size: clamp(2.2rem, 3.1vw, 2.9rem);
        }

        .autor__corpo {
          grid-column: 1;
          margin-top: 52px;
          max-width: 46ch;
        }

        .autor__corpo p {
          font-size: 17.5px;
        }

        .autor__assinatura {
          grid-column: 2;
          align-self: start;
          margin-top: 58px;
          padding-top: 26px;
          gap: 20px;
        }

        .autor__retrato {
          width: 84px;
        }

        .percurso {
          padding: 92px 0 40px;
        }

        /* O silencio antes da frase e o que produz a sensacao de chegada. */
        .saida {
          padding: 208px 0 0;
        }

        .saida__troca {
          font-size: clamp(2.6rem, 3.9vw, 3.55rem);
          max-width: 30ch;
        }

        .saida__voce {
          padding-bottom: 30px;
        }

        .saida__nos {
          padding-top: 30px;
        }

        .saida__acao {
          display: grid;
          grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
          gap: 0 56px;
          align-items: baseline;
          margin-top: 124px;
        }

        /* Sem isso o inline-block estica pela coluna do grid e o filete do
           CTA atravessa 700px atras de um texto de 240px. */
        .saida__cta {
          justify-self: start;
        }

        .saida__canal {
          margin-top: 0;
          justify-self: start;
        }

        .rodape {
          margin-top: 148px;
          padding: 24px 0 54px;
          display: grid;
          grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
          gap: 0 56px;
          align-items: start;
        }

        .rodape__aviso {
          margin-top: 0;
        }

        .percurso__frase {
          font-size: clamp(1.85rem, 2.6vw, 2.35rem);
          max-width: 64ch;
        }

        .fio--a { width: 44px; }
        .fio--b { width: 74px; }
        .fio--c { width: 56px; }

        .percurso__nota {
          margin-top: 44px;
          padding-top: 22px;
          font-size: 15.5px;
        }


        .pergunta {
          padding-top: 108px;
          font-size: clamp(2.6rem, 3.6vw, 3.2rem);
        }

        .instrucao {
          margin-top: 22px;
          font-size: 16px;
        }

        .linha__fala {
          font-size: 21px;
        }

        .linha summary {
          padding: 20px 0;
          gap: 20px;
        }

        .linha__marca {
          width: 20px;
        }

        details[open] .linha__marca {
          width: 40px;
        }

        .linha__resposta {
          margin-left: 40px;
        }



      }
    </style>
  </body>
</html>
