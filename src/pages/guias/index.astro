---
/**
 * /guias/ — hub dos guias (Sprint 2). Corrige o link do menu "Conteúdos"
 * (que apontava para /guias/ sem página) e reúne todos os guias de alta
 * autoridade, eliminando páginas órfãs. Lista via getCollection('guias').
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '@/lib/site.config';
import type { PageHead } from '@/lib/institucional';

const entries = (await getCollection('guias')).sort((a, b) =>
  (a.data.h1 ?? a.data.title).localeCompare(b.data.h1 ?? b.data.title, 'pt-BR')
);

const url = `${site.url}/guias/`;
const title = `Guias Jurídicos | ${site.name}`;
const description =
  'Guias completos e de alta autoridade sobre recuperação de crédito, cobrança condominial, direito ambiental, aduaneiro-tributário, internacional e inventário.';
const ogImage = `${site.url}${site.ogImage}`;

const head: PageHead = {
  title,
  description,
  canonical: url,
  robots: 'index, follow',
  og: { title, description, url, site_name: site.name, locale: site.locale, image: ogImage },
  twitter: { card: 'summary_large_image', title, description, image: ogImage },
};

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guias', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url,
    hasPart: entries.map((e) => ({
      '@type': 'Article',
      headline: e.data.h1 ?? e.data.title,
      url: `${site.url}/guias/${e.id}/`,
    })),
  },
];
---

<BaseLayout head={head}>
  <Fragment slot="jsonld">{jsonld.map((schema) => <JsonLd schema={schema} />)}</Fragment>

  <main id="conteudo-principal" class="guias-hub">
    <section class="g-hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Você está em">
          <a href="/">Início</a><span>/</span><span>Guias</span>
        </nav>
        <p class="eyebrow">Conteúdo de referência</p>
        <h1>Guias Jurídicos</h1>
        <p class="g-desc">
          Materiais completos, organizados por área, para quem quer entender o tema com
          profundidade antes de decidir os próximos passos. Conteúdo informativo geral,
          sem promessa de resultado.
        </p>
      </div>
    </section>

    <section class="g-list">
      <div class="wrap">
        <ul class="cards">
          {entries.map((e, i) => (
            <li>
              <a href={`/guias/${e.id}/`}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="corpo">
                  <span class="t">{e.data.h1 ?? e.data.title}</span>
                  <span class="d">{e.data.description}</span>
                </span>
                <span class="more" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hub de guias. Um guia é um documento longo, não um produto numa
     prateleira: a lista numerada em filetes lê melhor que a grade de cartões,
     que obrigava a cortar a descrição para igualar as alturas. */
  .wrap { width: 100%; max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-pad); }

  .g-hero {
    padding-block: var(--section-y) var(--section-y-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .g-hero .crumbs { margin-bottom: var(--space-8); }
  .g-hero h1 { font-size: var(--text-5xl); color: var(--color-ink); margin-top: var(--space-4); }
  .g-desc { margin-top: var(--space-6); color: var(--color-text-muted); font-size: var(--text-lg); line-height: var(--leading-relaxed); max-width: 54ch; }

  .g-list { padding-block: var(--section-y); }
  .cards { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-border); }
  .cards li { border-bottom: 1px solid var(--color-border); }
  .cards a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-5);
    padding: var(--space-6) 0;
    text-decoration: none;
    transition: padding-inline var(--dur) var(--ease);
  }
  @media (min-width: 780px) { .cards a { gap: var(--space-8); } }
  .cards a:hover { padding-inline: var(--space-3) 0; }

  .num {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-accent);
    padding-top: 0.45rem;
  }
  .corpo { display: block; }
  .t {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    transition: color var(--dur) var(--ease);
  }
  .cards a:hover .t { color: var(--color-accent); }
  .d { display: block; margin-top: var(--space-3); max-width: 72ch; color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .more { display: inline-flex; align-items: center; color: var(--color-text-subtle); padding-top: 0.4rem; transition: color var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .cards a:hover .more { color: var(--color-accent); transform: translateX(3px); }
</style>
