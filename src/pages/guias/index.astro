---
/**
 * /guias/ — hub dos guias (Sprint 2). Corrige o link do menu "Conteúdos"
 * (que apontava para /guias/ sem página) e reúne todos os guias de alta
 * autoridade, eliminando páginas órfãs. Lista via getCollection('guias').
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getCollection } from 'astro:content';
import Container from '@/components/Container.astro';
import ContentCard from '@/components/content/ContentCard.astro';
import { nucleos } from '@/lib/nucleos';
import { whatsappHrefForPath } from '@/lib/site.config';
import { site } from '@/lib/site.config';
import type { PageHead } from '@/lib/institucional';

// Rodada 4 (13/11/2026): as três frentes principais primeiro; as demais em ordem alfabética.
const PRIORIDADE = ['direito-aduaneiro-tributario-guia-completo', 'inventario-guia-completo', 'homologacao-de-sentenca-estrangeira-no-brasil'];
const rank = (id: string) => (PRIORIDADE.includes(id) ? PRIORIDADE.indexOf(id) : PRIORIDADE.length);
const entries = (await getCollection('guias')).sort(
  (a, b) => rank(a.id) - rank(b.id) || (a.data.h1 ?? a.data.title).localeCompare(b.data.h1 ?? b.data.title, 'pt-BR')
);

const url = `${site.url}/guias/`;
const title = `Guias Jurídicos | ${site.name}`;
const description =
  'Guias informativos sobre recuperação de crédito, cobrança condominial, direito ambiental, aduaneiro-tributário, internacional e inventário.';
const ogImage = `${site.url}${site.ogImage}`;

const head: PageHead = {
  title,
  description,
  canonical: url,
  robots: 'index, follow',
  og: { title, description, url, site_name: site.name, locale: site.locale, image: ogImage },
  twitter: { card: 'summary_large_image', title, description, image: ogImage },
};

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guias', item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url,
    hasPart: entries.map((e) => ({
      '@type': 'Article',
      headline: e.data.h1 ?? e.data.title,
      url: `${site.url}/guias/${e.id}/`,
    })),
  },
];

const clusterLabel = Object.fromEntries(nucleos.map((n) => [n.slug, n.label]));
const guiaWaHref = whatsappHrefForPath('/guias/');
---

<BaseLayout head={head} footerCta={false}>
  <Fragment slot="jsonld">{jsonld.map((schema) => <JsonLd schema={schema} />)}</Fragment>

  <main id="conteudo-principal" class="cx">
    <section class="cx-hero">
      <Container>
        <nav class="crumbs" aria-label="Você está em">
          <a href="/">Início</a><span aria-hidden="true">/</span><span>Guias</span>
        </nav>
        <p class="eyebrow"><span class="dot"></span>Conteúdo de referência</p>
        <h1>Guias completos</h1>
        <p class="cx-hero-desc">
          Materiais completos, organizados por área, para quem quer entender o tema com
          profundidade antes de decidir os próximos passos. Conteúdo informativo geral,
          sem promessa de resultado.
        </p>
      </Container>
    </section>

    <section class="cx-section cx-section--muted">
      <Container>
        <h2 class="sr-only">Guias por tema</h2>
        <ul class="cx-grid">
          {entries.map((e) => (
            <ContentCard
              href={`/guias/${e.id}/`}
              title={e.data.h1 ?? e.data.title}
              tag={e.data.cluster ? clusterLabel[e.data.cluster] : 'Guia'}
              desc={e.data.description}
              moreLabel="Ler o guia"
            />
          ))}
        </ul>
      </Container>
    </section>

    <section class="cx-cta">
      <Container>
        <div class="cx-cta-inner">
          <h2>Tem um caso concreto sobre um desses temas?</h2>
          <p>Fale com o escritório para uma orientação sobre a sua situação.</p>
          <div class="cx-cta-actions">
            <a class="btn btn--primary" href={guiaWaHref} target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
            <a class="btn btn--secondary" href="/contato/">Enviar meu caso</a>
          </div>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
