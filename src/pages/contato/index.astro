---
/**
 * /contato/ — migração fiel (Fase 3). Head + JSON-LD do export; formulário
 * reconstruído (ContactForm) mantendo Formspree, honeypot e o fluxo de
 * conversão para /contato/obrigado/. Textos reproduzidos verbatim do site atual.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Container from '@/components/Container.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ContactForm from '@/components/ContactForm.astro';
import { getPage } from '@/lib/institucional';
import { site, whatsappHrefForPath } from '@/lib/site.config';

const page = getPage('/contato/');
---

<BaseLayout head={page.head} footerCta={false}>
  <Fragment slot="jsonld">
    {page.jsonld.map((schema) => <JsonLd schema={schema} />)}
  </Fragment>

  <main id="conteudo-principal" class="contato">
    <Container>
      <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Contato' }]} />

      <p class="eyebrow"><span class="dot"></span>Contato</p>
      <h1>Fale com o escritório</h1>
      <p class="lead">Descreva a situação em poucas linhas. Quem responde é o advogado {site.attorney.name} ({site.attorney.oab}), por WhatsApp ou e-mail, conforme você preferir.</p>
      <p class="wa-line">Prefere conversar agora?
        <a class="btn btn--secondary btn--sm" href={whatsappHrefForPath(Astro.url.pathname)} target="_blank" rel="noopener noreferrer" data-cta-position="contato-topo">WhatsApp {site.contact.whatsapp.display}</a>
      </p>

      <div class="contact-card">
        <div class="grid">
          <section class="form-col" aria-labelledby="form-title">
            <h2 id="form-title">Envie os detalhes do seu caso</h2>
            <p>Preencha o formulário abaixo. Retornaremos por e-mail ou WhatsApp.</p>

            <ContactForm />

            <p class="fineprint">
              O envio deste formulário é apenas um primeiro contato e não cria, por si só,
              relação de advogado e cliente entre o remetente e o escritório.
            </p>
          </section>

          <aside class="channels">
            <div>
              <p class="ch-title">Outros canais</p>
              <ul>
                <li>
                  <span class="ch-label">Horário</span>
                  <span>Segunda a sexta, das 9h às 18h</span>
                </li>
                <li>
                  <span class="ch-label">WhatsApp</span>
                  <a href={whatsappHrefForPath(Astro.url.pathname)} target="_blank" rel="noopener noreferrer">
                    {site.contact.whatsapp.display}
                  </a>
                </li>
                <li>
                  <span class="ch-label">E-mail</span>
                  <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
                </li>
                <li>
                  <span class="ch-label">Endereço</span>
                  <span class="ch-address">{site.contact.address.street} — {site.contact.address.detail}<br />{site.contact.address.district}<br />{site.contact.address.city} – {site.contact.address.state} · CEP {site.contact.address.cep}</span>
                </li>
              </ul>
            </div>
            <div>
              <p class="ch-title">Responsável técnico</p>
              <p class="responsible">{site.attorney.name} — {site.attorney.oab}</p>
            </div>
            <p class="privacy-note">
              As informações enviadas por este formulário são tratadas conforme nossa{' '}
              <a href="/politica-de-privacidade/">Política de Privacidade</a> e utilizadas
              exclusivamente para retorno ao contato realizado.
            </p>
          </aside>
        </div>
      </div>
    </Container>
  </main>
</BaseLayout>

<style>
  /* Rodada 4 (13/11/2026): canais com horário de atendimento e cartão sem moldura no celular. */
  .wa-line .btn{min-height:48px}
  .wa-line{margin-top:var(--space-4);gap:var(--space-3);color:var(--color-text-muted);font-size:var(--text-sm);flex-wrap:wrap;align-items:center;display:flex}
  .contato{padding-block:var(--section-y-sm) var(--section-y-lg)}
  .contato .eyebrow{margin-top:var(--space-5);margin-bottom:var(--space-3)}
  .contato h1{font-size:var(--text-4xl);color:var(--color-ink);max-width:20ch}
  .lead{margin-top:var(--space-2);color:var(--color-text-muted);font-size:var(--text-md)}
  .contact-card{margin-top:var(--space-6);border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--surface);padding:clamp(1.25rem,1rem + 1.2vw,2.5rem)}
  @media (width<=639.98px){.contact-card{border:0;border-top:1px solid var(--border-strong);padding:var(--space-6) 0 0;border-radius:0}
  }
  .grid{gap:var(--space-8);grid-template-columns:minmax(0,1fr);align-items:start;display:grid}
  .grid>*{min-width:0}
  @media (width>=900px){.grid{gap:var(--space-10);grid-template-columns:minmax(0,1.35fr) minmax(0,.85fr)}
  }
  .form-col h2{font-size:var(--text-xl);color:var(--color-ink);margin-bottom:var(--space-2)}
  .form-col>p{color:var(--color-text-muted);margin-bottom:var(--space-5);font-size:var(--text-sm)}
  .form-col :global(.cform){max-width:none}
  .fineprint{margin-top:var(--space-4);font-size:var(--text-xs);line-height:var(--leading-normal);color:var(--color-text-muted);max-width:34rem}
  .channels{gap:var(--space-5);padding:var(--space-6);border-left:2px solid var(--color-accent);background:var(--surface-cream);border-radius:0;flex-direction:column;display:flex}
  .ch-title{font-family:var(--font-display);font-size:var(--text-md);font-weight:var(--weight-semibold);color:var(--color-ink);margin-bottom:var(--space-3)}
  .channels ul{gap:var(--space-3);flex-direction:column;padding:0;list-style:none;display:flex}
  .channels li{flex-direction:column;gap:.1rem;display:flex}
  .ch-label{font-size:var(--text-xs);font-weight:var(--weight-semibold);letter-spacing:.02em;color:var(--color-accent);display:block}
  .channels li>span:not(.ch-label){color:var(--color-ink);font-size:var(--text-sm)}
  .channels ul a{min-height:2.75rem;color:var(--color-navy);text-decoration:underline;text-decoration-color:var(--border-accent);text-underline-offset:.2em;font-weight:var(--weight-medium);font-size:var(--text-sm);overflow-wrap:anywhere;align-items:center;margin-block:-.5rem;display:inline-flex}
  .channels ul a:hover{color:var(--color-accent);text-decoration-color:currentColor}
  .channels a:focus-visible{outline:2px solid var(--ring-color);outline-offset:2px}
  .ch-address{color:var(--color-ink);font-weight:var(--weight-regular);font-size:var(--text-sm);line-height:var(--leading-normal)}
  .responsible{color:var(--color-ink);font-size:var(--text-sm)}
  .channels>div+div{padding-top:var(--space-4);border-top:1px solid var(--color-border)}
  .privacy-note{font-size:var(--text-xs);color:var(--color-text-muted);line-height:var(--leading-normal)}
  .privacy-note a{color:var(--color-navy)}
</style>
