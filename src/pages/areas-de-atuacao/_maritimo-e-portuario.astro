---
/**
 * Direito Marítimo e Portuário — RASCUNHO, não publicado.
 *
 * O briefing pede "grande destaque" para esta matéria. O projeto não tem nada
 * sobre ela: nenhum arquivo em src/content/, nenhum núcleo em nucleos.ts,
 * nenhuma menção no texto institucional. A única palavra do vocabulário
 * marítimo que aparece no site é "demurrage", e ela aparece dentro do núcleo
 * aduaneiro, como custo de carga retida — o que é comércio exterior, não
 * direito marítimo.
 *
 * Escrever a página assim mesmo seria anunciar uma competência que o projeto
 * não comprova. Fica o esqueleto e ficam as perguntas.
 */
import AreaRascunho from '@/components/AreaRascunho.astro';
---

<AreaRascunho
  eyebrow="Área em preparação"
  h1="Direito Marítimo e Portuário"
  resumo="O briefing do redesenho coloca esta matéria em destaque, mas o acervo do site não a documenta em nenhum ponto. A estrutura da página está pronta; o conteúdo depende de confirmação."
  lacunas={[
    {
      pergunta: 'O escritório atua em direito marítimo propriamente dito?',
      porque: 'Responsabilidade do transportador marítimo, conhecimento de embarque, afretamento, avaria grossa, salvamento e seguro marítimo. Nada disso aparece no acervo atual — o que existe é comércio exterior e aduaneiro, que é matéria vizinha, não a mesma.',
    },
    {
      pergunta: 'E em direito portuário?',
      porque: 'Arrendamento de área portuária, regulação da ANTAQ, operação de terminal, praticagem, relação com a autoridade portuária. São temas regulatórios com lógica própria.',
    },
    {
      pergunta: 'Há casos conduzidos nessa matéria que possam sustentar a página?',
      porque: 'Não para publicar o caso — isso o Código de Ética veda —, mas para que o texto descreva situações que o escritório efetivamente enfrenta, em vez de uma lista genérica copiada de doutrina.',
    },
    {
      pergunta: 'Que perfil de cliente se quer atingir?',
      porque: 'Armador, afretador, embarcador, operador portuário, terminal, agente marítimo e transportador têm problemas diferentes. A página precisa escolher um eixo.',
    },
  ]}
  adjacente={{
    texto:
      'Há material publicado em matérias adjacentes, que hoje é o que o site pode legitimamente afirmar sobre a cadeia de transporte internacional: retenção de carga, custos de armazenagem e demurrage, contratos de importação e Incoterms.',
    links: [
      { label: 'Direito Aduaneiro-Tributário', href: '/areas-de-atuacao/direito-aduaneiro-tributario/' },
      { label: 'Contratos de Importação e Comércio Exterior', href: '/areas-de-atuacao/contratos-de-importacao-comercio-exterior/' },
      { label: 'Assessoria Jurídica para Importadores', href: '/areas-de-atuacao/assessoria-juridica-para-importadores/' },
      { label: 'Incoterms e responsabilidade contratual para importadores', href: '/blog/incoterms-responsabilidade-contratual-importadores/' },
    ],
  }}
/>
