---
/**
 * /areas-de-atuacao/[slug]/ — rota dinâmica das páginas da coleção "areas" (Fase 4).
 * Conteúdo em Markdown (Content Collection); head e JSON-LD preservados.
 */
import { getCollection, render } from 'astro:content';
import EntryPage from '@/layouts/EntryPage.astro';
import { buildChildHead } from '@/lib/child-head';
import {
  getJsonLd,
  getBreadcrumb,
  buildAreaJsonLd,
  buildAreaCrumbs,
  buildFaqJsonLd,
} from '@/lib/structured-data';

export async function getStaticPaths() {
  // ETAPA 5 — slugs aposentados: NÃO geram página (a URL antiga responde 301
  // via .htaccess para o núcleo atual). Assim não aparecem em sitemap, JSON-LD,
  // breadcrumb nem como rota indexável.
  const RETIRED_AREA_SLUGS = ['direito-aduaneiro-comercio-exterior'];
  const entries = await getCollection('areas');
  return entries
    .filter((entry) => !RETIRED_AREA_SLUGS.includes(entry.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/areas-de-atuacao/${entry.id}/`;
const head = buildChildHead('areas', entry.data, path);

// Páginas de área PRESERVADAS (site atual) trazem o JSON-LD verbatim de
// _child-data.json. Páginas de área NOVAS não constam nesse arquivo: para elas,
// geramos LegalService + BreadcrumbList a partir do frontmatter e FAQPage a
// partir do conteúdo visível, mantendo uma única fonte da verdade.
let jsonld = getJsonLd('areas', entry.id);
let crumbs = getBreadcrumb('areas', entry.id);
if (jsonld.length === 0) {
  jsonld = buildAreaJsonLd({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    h1: entry.data.h1,
    path,
  });
  const faq = buildFaqJsonLd(entry.body ?? '');
  if (faq) jsonld.push(faq);
  crumbs = buildAreaCrumbs(entry.data.h1);
} else {
  // Rodada 4: o FAQPage preservado passa a espelhar as perguntas visíveis do corpo atual.
  const fresh = buildFaqJsonLd(entry.body ?? '');
  if (fresh) jsonld = jsonld.map((sch) => ((sch as { '@type'?: string })['@type'] === 'FAQPage' ? fresh : sch));
}
---

<EntryPage head={head} jsonld={jsonld} crumbs={crumbs} variant="area">
  <Content />
</EntryPage>
