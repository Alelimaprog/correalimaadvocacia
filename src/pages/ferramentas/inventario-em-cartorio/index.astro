---
/**
 * Ferramenta 1 — Verificador: o inventário pode ser feito em cartório?
 * Árvore de decisão baseada no art. 610, §§1º e 2º, do CPC. Sem dependências;
 * JS mínimo e acessível. Encerra com CTA contextual do cluster de inventário.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Container from '@/components/Container.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { site } from '@/lib/site.config';
import { whatsappHrefForPath } from '@/lib/site.config';

const canonical = `${site.url.replace(/\/$/, '')}/ferramentas/inventario-em-cartorio/`;
const waHref = whatsappHrefForPath('/ferramentas/inventario-em-cartorio/');
const toolSchema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Meu inventário pode ser feito em cartório?', description: 'Responda 3 perguntas e veja se o inventário pode ser feito em cartório, inclusive com menor ou testamento (Res. CNJ 571/2024), ou se é judicial.', url: 'https://correalimaadvocacia.com.br/ferramentas/inventario-em-cartorio/', applicationCategory: 'BusinessApplication', operatingSystem: 'Qualquer (navegador)', inLanguage: 'pt-BR', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' }, author: { '@type': 'Person', name: 'Alexandre Corrêa Lima' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://correalimaadvocacia.com.br/' },
    { '@type': 'ListItem', position: 2, name: 'Ferramentas', item: 'https://correalimaadvocacia.com.br/ferramentas/' },
    { '@type': 'ListItem', position: 3, name: 'Meu inventário pode ser feito em cartório?', item: 'https://correalimaadvocacia.com.br/ferramentas/inventario-em-cartorio/' } ] },
];
---

<BaseLayout
  title="Inventário em cartório: o meu caso pode? Teste em 3 perguntas"
  description="Responda 3 perguntas e veja se o inventário pode ser feito em cartório, inclusive com menor ou testamento (Res. CNJ 571/2024), ou se é judicial."
  canonical={canonical}
>
  <JsonLd schema={toolSchema} />
  <main id="conteudo-principal" class="tool" data-tool="inventario-em-cartorio">
    <Container>
      <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Ferramentas', href: '/ferramentas/' }, { label: 'Inventário em cartório' }]} />

      <p class="eyebrow"><span class="dot"></span>Ferramenta de orientação</p>
      <h1>Meu inventário pode ser feito em cartório?</h1>
      <p class="lead">
        O inventário extrajudicial costuma ser bem mais rápido e barato que o
        judicial, mas depende de requisitos legais. Responda às perguntas abaixo
        para entender qual via se aplica ao seu caso.
      </p>

      <form class="quiz" id="quiz">
        <fieldset>
          <legend>1. Todos os herdeiros são maiores de 18 anos e plenamente capazes?</legend>
          <label><input type="radio" name="q1" value="sim" required /> Sim</label>
          <label><input type="radio" name="q1" value="nao" /> Não — há menor ou pessoa sob curatela</label>
        </fieldset>

        <fieldset>
          <legend>2. Todos os herdeiros estão de acordo quanto à divisão dos bens?</legend>
          <label><input type="radio" name="q2" value="sim" required /> Sim, há consenso</label>
          <label><input type="radio" name="q2" value="nao" /> Não, há divergência</label>
        </fieldset>

        <fieldset>
          <legend>3. O falecido deixou testamento?</legend>
          <label><input type="radio" name="q3" value="nao" required /> Não</label>
          <label><input type="radio" name="q3" value="sim" /> Sim</label>
          <label><input type="radio" name="q3" value="naosei" /> Não sei</label>
        </fieldset>

        <button class="btn btn--primary btn--lg" type="submit">Ver o resultado</button>
      </form>

      <div class="result" id="result" hidden aria-live="polite">
        <p class="result-tag" id="rtag"></p>
        <h2 id="rtitle"></h2>
        <div id="rbody"></div>

        <div class="result-cta">
          <a class="btn btn--primary" href="/contato/?area=inventario" data-cta-position="ferramenta">Enviar meu caso</a>
          <a class="btn btn--secondary" href={waHref} target="_blank" rel="noopener noreferrer" data-cta-position="ferramenta">Falar no WhatsApp</a>
        </div>
      </div>

      <aside class="note">
        <p>
          Esta ferramenta tem caráter informativo e não substitui a análise
          individual do caso. Ela considera o art. 610, §§ 1º e 2º, do Código de
          Processo Civil e a Resolução CNJ 35/2007, com as alterações da
          Resolução CNJ 571/2024. Em qualquer das vias, a assistência de
          advogado é obrigatória.
        </p>
        <p>
          Para entender o procedimento completo, veja o{' '}
          <a href="/guias/inventario-guia-completo/">guia completo de inventário</a>
          {' '}e o artigo sobre{' '}
          <a href="/blog/inventario-extrajudicial-quando-cabe-e-como-funciona/">inventário extrajudicial</a>.
        </p>
      </aside>

      <section class="tool-explain" aria-labelledby="tx-title">
        <h2 id="tx-title">Inventário em cartório: o que você precisa saber</h2>
        <h3>Quais são os requisitos?</h3>
        <p>A regra básica do art. 610 do CPC é: todos os herdeiros de acordo, todos capazes, sem testamento, e um advogado acompanhando a escritura. A Resolução CNJ 571/2024 ampliou a via do cartório para dois casos que antes iam obrigatoriamente ao juiz: herdeiro menor ou incapaz (com manifestação favorável do Ministério Público e partilha em fração ideal) e testamento já processado judicialmente, quando o juiz autoriza a via extrajudicial.</p>
        <h3>Quanto tempo leva?</h3>
        <p>Depende sobretudo de documentos e do ITCMD. Com a documentação completa e o imposto recolhido, a escritura pode ser lavrada em pouco tempo; o que costuma atrasar são certidões, avaliação de imóveis, pendências de registro e herdeiros que moram fora do Brasil e precisam enviar procuração.</p>
        <h3>Quanto custa?</h3>
        <p>Há três custos principais: o ITCMD (em São Paulo, regido pela Lei estadual 10.705/2000), os emolumentos do cartório, que seguem a tabela oficial do estado conforme o valor dos bens, e os honorários do advogado. O valor de cada um depende do patrimônio e é informado após a análise dos documentos.</p>
        <h3>E se um herdeiro mora no exterior?</h3>
        <p>O inventário em cartório continua possível. O herdeiro assina por procuração pública feita no consulado brasileiro ou em notário local com apostila. Veja <a href="/areas-de-atuacao/inventario-com-herdeiro-no-exterior/">inventário com herdeiro no exterior</a>.</p>
        <p>Mais detalhes em <a href="/areas-de-atuacao/inventario-e-patrimonio/inventario-extrajudicial/">inventário extrajudicial em São Paulo</a> e <a href="/areas-de-atuacao/inventario-e-patrimonio/inventario-judicial/">inventário judicial</a>.</p>
      </section>
    </Container>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('quiz').addEventListener('submit', function (e) {
    e.preventDefault();
    var f = new FormData(e.target);
    var q1 = f.get('q1'), q2 = f.get('q2'), q3 = f.get('q3');
    var tag = document.getElementById('rtag');
    var title = document.getElementById('rtitle');
    var body = document.getElementById('rbody');
    var res = document.getElementById('result');

    var extra = '';
    if (q2 === 'nao') {
      tag.textContent = 'Via judicial';
      tag.className = 'result-tag result-tag--alert';
      title.textContent = 'Sem consenso, o caminho é o inventário judicial';
      body.innerHTML =
        '<p>A escritura pública exige acordo integral entre os herdeiros. Havendo divergência, a partilha será decidida judicialmente.</p>' +
        '<p>Importante: <strong>um herdeiro sozinho pode requerer a abertura</strong> — não é preciso esperar que todos concordem. Veja <a href="/blog/herdeiros-em-conflito-inventario-travado/">o que fazer quando o inventário trava</a>.</p>';
    } else if (q1 === 'nao' || q3 === 'sim' || q3 === 'naosei') {
      tag.textContent = 'Cartório possível, com requisitos adicionais';
      tag.className = 'result-tag result-tag--warn';
      title.textContent = 'O cartório pode ser possível, mas há condições a cumprir';
      if (q1 === 'nao') {
        extra +=
          '<p><strong>Herdeiro menor ou incapaz:</strong> desde a Resolução CNJ 571/2024, o inventário pode ser feito em cartório se houver consenso, se a parte do incapaz for paga em fração ideal de cada bem (sem bens escolhidos para ele) e se o Ministério Público se manifestar favoravelmente. O incapaz não pode renunciar à herança nem ceder direitos. Havendo impugnação, o caso vai ao juiz.</p>';
      }
      if (q3 === 'sim') {
        extra +=
          '<p><strong>Testamento:</strong> a escritura é admitida depois que o testamento é aberto e registrado judicialmente, com autorização do juiz para o inventário seguir em cartório. Se o testamento reconhece filho ou contém outra declaração irrevogável, o inventário deve ser judicial.</p>';
      }
      if (q3 === 'naosei') {
        extra +=
          '<p><strong>Não sabe se há testamento?</strong> Essa é a primeira providência: o cartório exige a certidão de buscas na Central de Testamentos (CENSEC) antes da escritura.</p>';
      }
      body.innerHTML = extra +
        '<p>O consenso entre os herdeiros, com assistência de advogado, continua sendo o ponto de partida. Cada uma das condições acima precisa ser conferida antes de escolher o caminho. Veja o que muda em <a href="/blog/herdeiro-menor-ou-incapaz-o-que-muda-no-inventario/">herdeiro menor ou incapaz no inventário</a>.</p>';
    } else {
      tag.textContent = 'Via extrajudicial';
      tag.className = 'result-tag result-tag--ok';
      title.textContent = 'Seu inventário provavelmente pode ser feito em cartório';
      body.innerHTML =
        '<p>Consenso entre os herdeiros, com assistência de advogado, e ausência de testamento: o caso reúne as condições do art. 610, §1º, do CPC para a via extrajudicial, que costuma ser bem mais rápida que a judicial.</p>' +
        '<p>Próximos passos: reunir a documentação, apurar o ITCMD e elaborar a minuta da escritura. Use o <a href="/ferramentas/checklist-documentos-inventario/">checklist de documentos</a> para organizar.</p>' +
        '<p>Atenção ao prazo: o art. 611 do CPC prevê a abertura em até 2 meses do óbito. Em SP, a multa é de 10% do ITCMD após 60 dias e de 20% após 180 dias do óbito (Lei 10.705/2000, art. 21, I).</p>';
    }
    res.hidden = false;
    res.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .tool-explain { margin-top: var(--space-10); max-width: 46rem; }
  .tool-explain h2 { font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-ink); }
  .tool-explain h3 { margin-top: var(--space-6); font-size: var(--text-lg); color: var(--color-ink); }
  .tool-explain p { margin-top: var(--space-2); line-height: var(--leading-relaxed, 1.7); }
  .tool { padding-block: var(--section-y); }
  .tool h1 { font-size: var(--text-4xl); color: var(--color-ink); margin-top: var(--space-3); max-width: 20ch; line-height: 1.1; }
  .lead { margin-top: var(--space-4); max-width: 60ch; color: var(--color-text); font-size: var(--text-md); line-height: var(--leading-normal); }
  .quiz { margin-top: var(--space-8); max-width: 46rem; display: flex; flex-direction: column; gap: var(--space-6); }
  .quiz fieldset { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); background: var(--surface); }
  .quiz legend { font-family: var(--font-display); font-weight: var(--weight-bold); color: var(--color-ink); font-size: var(--text-md); padding-inline: var(--space-2); }
  .quiz label { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; color: var(--color-text); font-size: var(--text-sm); cursor: pointer; }
  .quiz input[type='radio'] { width: 1.05rem; height: 1.05rem; accent-color: var(--color-green-strong); flex: none; }
  .quiz button { align-self: flex-start; }
  .result { margin-top: var(--space-8); max-width: 46rem; border: 1px solid var(--color-border); border-left: 2px solid var(--color-accent); background: var(--surface-cream); border-radius: 0; padding: var(--space-6); }
  .result[hidden] { display: none; }
  .result h2 { font-size: var(--text-xl); color: var(--color-ink); margin-top: var(--space-2); }
  .result :global(p) { margin-top: var(--space-3); color: var(--color-text); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .result :global(a) { color: var(--color-green-strong); font-weight: var(--weight-medium); }
  .result-tag { display: inline-block; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; font-weight: var(--weight-semibold); padding: 0.25rem 0.6rem; border-radius: var(--radius-sm); }
  .result-tag--ok { background: var(--color-green-strong); color: #fff; }
  .result-tag--warn { background: var(--color-warning); color: #fff; }
  .result-tag--alert { background: var(--color-navy); color: #fff; }
  .result-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .note { margin-top: var(--space-8); max-width: 46rem; border-top: 1px solid var(--color-border); padding-top: var(--space-5); }
  .note p { color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); margin-top: var(--space-2); }
  .note a { color: var(--color-green-strong); }
</style>
