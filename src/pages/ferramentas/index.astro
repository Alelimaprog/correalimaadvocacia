---
/**
 * Índice das ferramentas gratuitas — hub de entrada para os materiais de apoio.
 * Serve à conversão (materiais úteis atraem contato qualificado) e evita que as
 * ferramentas fiquem órfãs na arquitetura.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Icon from '@/components/Icon.astro';
import JsonLd from '@/components/JsonLd.astro';
import { site, whatsappHrefForPath } from '@/lib/site.config';

const canonical = `${site.url.replace(/\/$/, '')}/ferramentas/`;

const ferramentas = [
  {
    titulo: 'Calculadora de demurrage e detention',
    desc: 'Free time, diárias progressivas por faixa, vários contêineres e conversão pela PTAX do Banco Central. Confira a fatura do armador.',
    href: '/ferramentas/calculadora-de-demurrage/',
    tag: 'Calculadora',
    icon: 'clock',
  },
  {
    titulo: 'Simulador de tributos na importação',
    desc: 'II, IPI, PIS e COFINS-Importação, AFRMM, Taxa Siscomex e ICMS por dentro, com custo total e unitário nacionalizado.',
    href: '/ferramentas/simulador-de-tributos-na-importacao/',
    tag: 'Simulador',
    icon: 'coins',
  },
  {
    titulo: 'Validador de número de contêiner',
    desc: 'Confere o formato e o dígito verificador pela norma ISO 6346. Valide vários números de uma vez.',
    href: '/ferramentas/validador-de-conteiner/',
    tag: 'Validador',
    icon: 'package',
  },
  {
    titulo: 'Calculadora de cubagem e peso cubado',
    desc: 'Metros cúbicos, peso taxável no aéreo e no rodoviário, unidades de frete marítimo (W/M) e ocupação de contêiner.',
    href: '/ferramentas/calculadora-de-cubagem/',
    tag: 'Calculadora',
    icon: 'route',
  },
  {
    titulo: 'Atualização de dívida',
    desc: 'IPCA, INPC ou IGP-M com índices do Banco Central, juros pela taxa legal (Selic − IPCA) ou taxa fixa, multa e honorários.',
    href: '/ferramentas/atualizacao-de-divida/',
    tag: 'Calculadora',
    icon: 'coins',
  },
  {
    titulo: 'Condomínio atrasado',
    desc: 'Cotas condominiais vencidas com multa de até 2%, juros e correção, parcela por parcela.',
    href: '/ferramentas/calculadora-de-condominio-atrasado/',
    tag: 'Calculadora',
    icon: 'building',
  },
  {
    titulo: 'Meu inventário pode ser feito em cartório?',
    desc: 'Três perguntas para descobrir se o seu caso admite a via extrajudicial, mais rápida e barata, ou exige processo judicial.',
    href: '/ferramentas/inventario-em-cartorio/',
    tag: 'Verificador',
    icon: 'scale',
  },
  {
    titulo: 'Checklist de documentos para o inventário',
    desc: 'Lista completa e interativa, com barra de progresso e versão para impressão. Organize o que já tem e o que falta.',
    href: '/ferramentas/checklist-documentos-inventario/',
    tag: 'Checklist',
    icon: 'check',
  },
  {
    titulo: 'Preciso homologar minha decisão estrangeira?',
    desc: 'Descubra se a sua decisão obtida no exterior exige homologação no STJ, está dispensada por lei ou segue regime próprio.',
    href: '/ferramentas/preciso-homologar-sentenca-estrangeira/',
    tag: 'Verificador',
    icon: 'globe',
  },
];

const listSchema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Calculadoras e ferramentas jurídicas gratuitas', url: canonical, mainEntity: { '@type': 'ItemList', itemListElement: ferramentas.map((f, i) => ({ '@type': 'ListItem', position: i + 1, name: f.titulo, url: `https://correalimaadvocacia.com.br${f.href}` })) } };
const ferrWaHref = whatsappHrefForPath('/ferramentas/');
---

<BaseLayout
  title="Calculadoras e Ferramentas Jurídicas Gratuitas | Corrêa Lima Advocacia"
  description="Ferramentas gratuitas: calculadora de demurrage, simulador de tributos na importação, validador de contêiner, cubagem, inventário em cartório e homologação."
  canonical={canonical}
>
  <JsonLd schema={listSchema} />
  <main id="conteudo-principal" class="cx">
    <section class="cx-hero">
      <Container>
        <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Ferramentas' }]} />
        <p class="eyebrow"><span class="dot"></span>Ferramentas</p>
        <h1>Ferramentas de orientação</h1>
        <p class="cx-hero-desc">
          Materiais de apoio para quem precisa entender rapidamente a própria situação, sem
          cadastro. Servem para organizar informações e identificar o caminho
          provável; a análise do caso concreto continua exigindo orientação jurídica.
        </p>
      </Container>
    </section>

    <section class="cx-section cx-section--muted">
      <Container>
        <ul class="cx-grid cx-grid--3">
          {ferramentas.map((f) => (
            <li class="cx-card">
              <span class="cx-card-ic"><Icon name={f.icon} size={20} /></span>
              <div class="cx-card-top"><span class="cx-card-tag">{f.tag}</span></div>
              <h2 class="cx-card-title"><a href={f.href}>{f.titulo}</a></h2>
              <p class="cx-card-desc">{f.desc}</p>
              <div class="cx-card-foot">
                <span class="cx-card-more">Abrir ferramenta<Icon name="arrow-right" size={15} /></span>
              </div>
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <section class="cx-cta">
      <Container>
        <div class="cx-cta-inner">
          <h2>Precisa de uma análise do seu caso?</h2>
          <p>As ferramentas dão um direcionamento inicial. Para o caso concreto, fale com o escritório.</p>
          <div class="cx-cta-actions">
            <a class="btn btn--primary" href={ferrWaHref} target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
            <a class="btn btn--secondary" href="/contato/">Enviar meu caso</a>
          </div>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
