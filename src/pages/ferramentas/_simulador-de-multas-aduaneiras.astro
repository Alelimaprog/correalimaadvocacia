---
// RASCUNHO (o prefixo _ impede a publicação). Aguarda o LOTE-02 de revisão jurídica.
// Para publicar: renomear para simulador-de-multas-aduaneiras.astro e incluir no índice de ferramentas.
import ToolLayout from '@/components/ToolLayout.astro';
import { HIPOTESES } from '@/lib/calc/multas-aduaneiras.js';
const ops = Object.entries(HIPOTESES);
---

<ToolLayout
  slug="simulador-de-multas-aduaneiras"
  title="Simulador de multas na importação: perdimento, multa de ofício e erro na DI/DUIMP"
  description="Estime as principais multas aduaneiras na importação a partir do valor aduaneiro: multa substitutiva do perdimento, multa de ofício, cessão de nome, falta de licença e erro de informação, com a base legal de cada uma."
  h1="Simulador de multas na importação"
  lead="Escolha as situações do seu caso e veja uma estimativa de cada multa, com o fundamento legal ao lado. Serve para entender a ordem de grandeza de um auto de infração antes de decidir a defesa."
  crumb="Multas na importação"
  categoria="Simulador · direito aduaneiro"
  atualizado="2026-11-28"
  area="direito-aduaneiro-tributario"
  premissas={[
    'Os percentuais e valores fixos são os previstos na lei indicada em cada linha do resultado.',
    'A multa de ofício incide sobre a diferença de tributo lançada; informe essa diferença em reais.',
    'As multas são estimadas separadamente. Se mais de uma se aplica ao mesmo fato é questão do caso concreto.',
  ]}
  fontes={[
    { label: 'Lei 9.430/1996, art. 44 (Planalto)', href: 'https://www.planalto.gov.br/ccivil_03/leis/L9430compilada.htm' },
    { label: 'Decreto-Lei 1.455/1976, art. 23 (Planalto)', href: 'https://www.planalto.gov.br/ccivil_03/decreto-lei/del1455.htm' },
    { label: 'Lei 11.488/2007, art. 33 (Planalto)', href: 'https://www.planalto.gov.br/ccivil_03/_ato2007-2010/2007/lei/l11488.htm' },
    { label: 'Decreto-Lei 37/1966, art. 169 (Planalto)', href: 'https://www.planalto.gov.br/ccivil_03/decreto-lei/Del0037compilado.htm' },
    { label: 'Lei Complementar 227/2026 (Senado)', href: 'https://legis.senado.leg.br/norma/42042119' },
  ]}
  limitacoes={[
    'Não substitui a leitura do auto de infração: o enquadramento escolhido pela fiscalização pode ser outro.',
    'Reduções por pagamento no prazo, retroatividade de lei mais benéfica e cumulação de multas não estão no cálculo.',
    'A multa por erro de informação mudou com a LC 227/2026, e o alcance da mudança ainda é discutido.',
  ]}
>
  <form class="calc-form" id="f" novalidate>
    <fieldset>
      <legend>Valores</legend>
      <label>Valor aduaneiro (R$) <input type="text" inputmode="decimal" name="va" required /></label>
      <label>Diferença de tributo lançada (R$) <input type="text" inputmode="decimal" name="dif" /></label>
      <label>Valor da operação (R$) <small>se diferente do valor aduaneiro</small><input type="text" inputmode="decimal" name="op" /></label>
    </fieldset>
    <fieldset>
      <legend>Situações do caso</legend>
      {ops.map(([k, h]) => <label class="check"><input type="checkbox" name="h" value={k} /> {h.titulo}</label>)}
      <label>Multa de ofício <select name="oficio"><option value="normal">75% (padrão)</option><option value="qualificada">100% (qualificada)</option><option value="reincidencia">150% (reincidência)</option></select></label>
      <label>Erro de informação: regime <select name="regime"><option value="anterior">Fatos anteriores à LC 227/2026 (1%)</option><option value="lc227">LC 227/2026 (UPF)</option></select></label>
      <label>Número de informações incorretas <input type="number" min="1" name="n" value="1" /></label>
      <label>Valor da UPF (R$) <input type="text" inputmode="decimal" name="upf" /></label>
    </fieldset>
    <button class="btn btn--primary btn--lg" type="submit">Simular</button>
  </form>
  <div class="calc-erros" id="erros" hidden role="alert"></div>
  <div class="calc-result" id="res" hidden aria-live="polite">
    <p class="result-tag">Estimativa</p>
    <h2>Soma das multas escolhidas</h2>
    <p class="big" id="total"></p>
    <table class="calc-table"><thead><tr><th>Multa</th><th>Cálculo</th><th class="n">Valor (R$)</th><th>Base legal</th></tr></thead><tbody id="linhas"></tbody></table>
  </div>
  <section class="calc-explica" slot="explica">
    <h2>Depois da simulação</h2>
    <p>Recebeu um auto de infração ou um termo de retenção? Veja <a href="/blog/multa-aduaneira-retencao-de-mercadoria-o-que-fazer/">o que fazer diante de multa aduaneira e retenção</a>, <a href="/blog/perdimento-convertido-em-multa-mercadoria-nao-localizada/">quando o perdimento vira multa</a> e a página de <a href="/areas-de-atuacao/direito-aduaneiro-tributario/">direito aduaneiro</a>.</p>
  </section>
</ToolLayout>

<script>
  import { simularMultas } from '@/lib/calc/multas-aduaneiras.js';
  import { num } from '@/lib/calc/comex.js';
  const f = document.getElementById('f') as HTMLFormElement;
  const R = (n: number) => n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;
    const hs = [...f.querySelectorAll<HTMLInputElement>('input[name=h]:checked')].map((i) => i.value);
    const r = simularMultas({ valorAduaneiro: num(v('va')), diferencaTributo: num(v('dif')), valorOperacao: num(v('op')), oficio: v('oficio') as any, regimeInformacao: v('regime') as any, informacoes: Number(v('n')), upf: num(v('upf')), hipoteses: hs });
    const er = document.getElementById('erros')!, res = document.getElementById('res')!;
    if (!r.ok) { er.innerHTML = '<strong>Confira os dados:</strong><ul>' + r.erros.map((x) => `<li>${x}</li>`).join('') + '</ul>'; er.hidden = false; res.hidden = true; return; }
    er.hidden = true;
    document.getElementById('linhas')!.innerHTML = r.itens.map((i) => `<tr><td>${i.titulo}</td><td>${i.memoria}</td><td class="n">${R(i.valor)}</td><td>${i.fonte}</td></tr>`).join('');
    document.getElementById('total')!.textContent = 'R$ ' + R(r.total);
    res.hidden = false; res.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
