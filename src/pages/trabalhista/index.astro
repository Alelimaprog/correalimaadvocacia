---
/**
 * PROTÓTIPO — Landing de advocacia trabalhista (tráfego pago).
 * Escopo desta rodada: navegação mínima, primeira dobra, mecanismo de
 * identificação e primeira resposta. O restante da página ainda não existe.
 *
 * Direção: estrutura de "A Pergunta" + linguagem visual de "O Dossiê" +
 * situações em primeira pessoa. Página deliberadamente autônoma: não consome
 * os partials do site institucional, cujo vocabulário visual (pílulas, cards
 * arredondados, gradientes) é justamente o que esta landing não deve repetir.
 */
import piazzolla from '@fontsource-variable/piazzolla/files/piazzolla-latin-opsz-normal.woff2?url';

const SITUACOES = [
  {
    fala: 'Me mandaram embora e acho que pagaram errado.',
    resposta:
      'O acerto se divide em várias parcelas — aviso, férias, décimo terceiro, saldo de salário, multa do FGTS — e cada uma tem regra própria. Comparar o que foi pago com o que consta no contrato, nos holerites e no extrato do FGTS costuma ser o primeiro passo.',
  },
  {
    fala: 'Estou trabalhando sem registro na carteira.',
    resposta:
      'A falta de registro não apaga o vínculo: o que pesa é como o trabalho acontecia na prática — horário, ordens recebidas, continuidade. Conversas, escalas, comprovantes de pagamento e quem trabalhava junto costumam ser o material que sustenta essa análise.',
  },
  {
    fala: 'Faço hora extra e não recebo.',
    resposta:
      'Nem toda hora além do expediente é tratada da mesma forma. Jornada contratada, intervalos, controle de ponto e forma de pagamento precisam ser lidos em conjunto antes de qualquer conclusão.',
  },
  {
    fala: 'Meu FGTS não está sendo depositado.',
    resposta:
      'Os depósitos são mensais e ficam registrados no extrato da Caixa. Ler o extrato ao lado dos holerites mostra se existe período em aberto e desde quando — é daí que parte a análise.',
  },
  {
    fala: 'Quero sair porque a empresa não cumpre o combinado.',
    resposta:
      'Quando a empresa descumpre o que foi acordado, existe um caminho para encerrar o contrato sem que isso conte como pedido de demissão. Depende de conseguir demonstrar o descumprimento, então vale reunir o material antes de tomar qualquer atitude.',
  },
  {
    fala: 'Estão me pressionando ou me humilhando no trabalho.',
    resposta:
      'Situações assim dependem muito do contexto, da frequência e de quem praticou. Guardar datas, mensagens e lembrar quem presenciou é o que costuma tornar a análise possível.',
  },
  {
    fala: 'Levei justa causa e acho que foi injusta.',
    resposta:
      'A justa causa exige motivo previsto em lei e proporcionalidade entre o que aconteceu e a punição. Vale entender qual foi o motivo informado, o que veio antes e se já houve punição pelo mesmo fato.',
  },
  {
    fala: 'Me contrataram como PJ, mas trabalho como funcionário.',
    resposta:
      'O que define o vínculo não é o nome do contrato, e sim a rotina: horário, ordens, exclusividade, se outra pessoa poderia fazer seu trabalho no seu lugar. Contrato, mensagens e notas emitidas ajudam a mostrar como era o dia a dia.',
  },
  {
    fala: 'Me machuquei trabalhando.',
    resposta:
      'Acidente e doença ligados ao trabalho envolvem afastamento, estabilidade no emprego e benefício do INSS — cada frente com procedimento próprio. Documentos do atendimento, a CAT e laudos médicos são o ponto de partida.',
  },
  {
    fala: 'Meu caso é outro.',
    resposta:
      'Situação de trabalho raramente cabe numa lista. Se a sua não está aqui, contar o que aconteceu com as suas próprias palavras já é suficiente para começar.',
  },
];

const WHATSAPP =
  'https://wa.me/5511975025611?text=' +
  encodeURIComponent('Olá. Queria contar uma situação de trabalho e entender o que pode ser feito.');
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Advogado trabalhista para o trabalhador | Corrêa Lima Advocacia</title>
    <meta
      name="description"
      content="Você conta o que aconteceu no seu trabalho, com as suas palavras. A gente explica o que costuma ser analisado e o que pode ser feito."
    />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={piazzolla} as="font" type="font/woff2" crossorigin />
    <style define:vars={{ piazzolla: `url(${piazzolla})` }}>
      @font-face {
        font-family: 'Piazzolla';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: var(--piazzolla) format('woff2-variations');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
          U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
      }
    </style>
  </head>

  <body>
    <header class="cabecalho">
      <div class="marca">
        <span class="marca__nome">Corrêa Lima Advocacia</span>
        <span class="marca__area">Direito do trabalho, para quem trabalha</span>
      </div>
      <a class="cabecalho__link" href={WHATSAPP} rel="nofollow noopener">Falar agora</a>
    </header>

    <main>
      <section class="abertura">
        <h1 class="pergunta">O que está acontecendo<br />no seu trabalho?</h1>
      </section>

      <section class="indice" aria-label="Situações de trabalho">
        <div class="coluna">
          <p class="instrucao">Encontre a frase mais parecida com a sua situação.</p>
          <ol class="lista">
          {
            SITUACOES.map((s, i) => (
              <li class={i === SITUACOES.length - 1 ? 'linha linha--saida' : 'linha'}>
                <details name="situacao">
                  <summary>
                    <span class="linha__marca" aria-hidden="true" />
                    <span class="linha__fala">{s.fala}</span>
                  </summary>
                  <div class="linha__resposta">
                    <p>{s.resposta}</p>
                    <a class="linha__acao" href={WHATSAPP} rel="nofollow noopener">
                      Contar o que aconteceu comigo
                    </a>
                  </div>
                </details>
              </li>
            ))
          }
          </ol>
        </div>

        <aside class="margem">
          <p class="margem__nota">
            As explicações acima são orientação geral. O que muda o desfecho de um caso são os
            documentos e o que de fato aconteceu no dia a dia — por isso nada aqui substitui a
            análise da sua situação.
          </p>
          <p class="margem__assinatura">
            Alexandre Corrêa Lima<br />
            <span>OAB/SP 234511</span>
          </p>
        </aside>
      </section>

      <section class="fecho">
        <p class="fecho__frase">
          Você explica o que aconteceu.<br />Nós explicamos o que pode ser feito.
        </p>
        <a class="fecho__acao" href={WHATSAPP} rel="nofollow noopener">Contar a minha situação</a>
      </section>
    </main>

    <style>
      :root {
        --papel: #faf8f4;
        --tinta: #191713;
        --tinta-fraca: #57524a;
        --filete: #191713;
        --verde: #0a5230;
        --medida: 34rem;
      }

      * {
        box-sizing: border-box;
        margin: 0;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        background: var(--papel);
        color: var(--tinta);
        font-family: 'Piazzolla', Georgia, 'Times New Roman', serif;
        font-variation-settings: 'opsz' 12;
        font-size: 17px;
        line-height: 1.5;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        padding: 0 22px 96px;
      }

      /* ── Cabeçalho ─────────────────────────────────────────── */
      .cabecalho {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 0 16px;
        border-bottom: 1px solid var(--filete);
      }

      .marca__nome {
        display: block;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.01em;
        font-variation-settings: 'opsz' 10;
      }

      .marca__area {
        display: block;
        margin-top: 2px;
        font-size: 13px;
        color: var(--tinta-fraca);
        font-variation-settings: 'opsz' 8;
      }

      .cabecalho__link {
        flex: none;
        font-size: 13px;
        color: var(--verde);
        text-decoration: none;
        border-bottom: 1px solid var(--verde);
        padding-bottom: 1px;
        font-variation-settings: 'opsz' 8;
      }

      /* ── Abertura ──────────────────────────────────────────── */
      .abertura {
        padding: 76px 0 40px;
      }

      .pergunta {
        font-size: clamp(2.5rem, 11.6vw, 4rem);
        line-height: 0.98;
        letter-spacing: -0.026em;
        font-weight: 400;
        font-variation-settings: 'opsz' 30;
      }

      /* Instrução da lista: ancorada ao filete do índice, não sob o H1. */
      .instrucao {
        color: var(--tinta-fraca);
        font-size: 15px;
        line-height: 1.4;
        padding-bottom: 12px;
      }

      /* ── Índice de situações ───────────────────────────────── */
      .lista {
        list-style: none;
        padding: 0;
        border-top: 1px solid var(--filete);
      }

      .linha {
        border-bottom: 1px solid rgba(25, 23, 19, 0.18);
      }

      .linha summary {
        display: flex;
        align-items: baseline;
        gap: 14px;
        padding: 17px 0;
        cursor: pointer;
        list-style: none;
      }

      .linha summary::-webkit-details-marker {
        display: none;
      }

      .linha__fala {
        font-size: 19px;
        line-height: 1.3;
        letter-spacing: -0.008em;
        font-variation-settings: 'opsz' 16;
      }

      /* Marca de índice: um filete no início da linha, como entrada de sumário.
         Cresce e ganha cor quando aberta — nunca um sinal de mais/menos. */
      .linha__marca {
        flex: none;
        width: 13px;
        height: 1px;
        background: rgba(25, 23, 19, 0.42);
        translate: 0 -0.42em;
        transition: width 160ms ease, background-color 160ms ease;
      }

      details[open] .linha__marca {
        width: 26px;
        background: var(--verde);
      }

      details[open] .linha__fala {
        font-weight: 600;
      }

      /* "Meu caso é outro." não é uma situação: é a saída da lista. */
      .linha--saida {
        border-bottom: none;
      }

      .linha--saida summary {
        padding-top: 26px;
      }

      .linha--saida .linha__fala {
        color: var(--tinta-fraca);
        font-style: italic;
      }

      .linha__resposta {
        margin-left: 27px;
        padding: 0 0 28px 15px;
        border-left: 1px solid var(--verde);
        max-width: var(--medida);
      }

      .linha__resposta p {
        color: var(--tinta-fraca);
        font-size: 16.5px;
        line-height: 1.58;
      }

      .linha__acao {
        display: inline-block;
        margin-top: 18px;
        font-size: 15px;
        color: var(--verde);
        text-decoration: none;
        border-bottom: 1px solid var(--verde);
        padding-bottom: 1px;
      }

      /* ── Margem (marginália) ───────────────────────────────── */
      .margem {
        margin-top: 40px;
        max-width: 40ch;
      }

      .margem__nota {
        font-size: 14px;
        line-height: 1.55;
        color: var(--tinta-fraca);
        font-variation-settings: 'opsz' 8;
      }

      .margem__assinatura {
        margin-top: 22px;
        font-size: 14px;
        line-height: 1.45;
        font-variation-settings: 'opsz' 8;
      }

      .margem__assinatura span {
        color: var(--tinta-fraca);
      }

      /* ── Fecho ─────────────────────────────────────────────── */
      .fecho {
        margin-top: 92px;
        padding-top: 30px;
        border-top: 1px solid var(--filete);
      }

      .fecho__frase {
        font-size: clamp(1.35rem, 5.7vw, 2rem);
        line-height: 1.16;
        letter-spacing: -0.018em;
        font-variation-settings: 'opsz' 24;
      }

      .fecho__acao {
        display: inline-block;
        margin-top: 28px;
        font-size: 17px;
        color: var(--verde);
        text-decoration: none;
        border-bottom: 1px solid var(--verde);
        padding-bottom: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }

      /* ── 768px: a margem sai do fluxo e vira marginália ────── */
      @media (min-width: 768px) {
        body {
          padding: 0 40px 120px;
        }

        .abertura {
          padding: 104px 0 48px;
        }

        .indice {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 15rem;
          gap: 0 48px;
          align-items: start;
        }

        .margem {
          margin-top: 116px;
          padding-top: 15px;
          border-top: 1px solid rgba(25, 23, 19, 0.3);
          max-width: none;
        }
      }

      /* ── 1024px+: composição assimétrica de documento ──────── */
      @media (min-width: 1024px) {
        body {
          padding: 0 clamp(48px, 6vw, 104px) 160px;
        }

        .cabecalho {
          padding: 26px 0 18px;
        }

        .abertura {
          padding: 136px 0 56px;
        }

        .pergunta {
          font-size: clamp(4rem, 6.4vw, 6.25rem);
          letter-spacing: -0.032em;
        }

        .instrucao {
          font-size: 16px;
          padding-bottom: 14px;
        }

        .indice {
          grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
          gap: 0 56px;
        }

        .linha__fala {
          font-size: 22px;
          font-variation-settings: 'opsz' 20;
        }

        .linha summary {
          padding: 21px 0;
          gap: 20px;
        }

        .linha__marca {
          width: 20px;
        }

        details[open] .linha__marca {
          width: 40px;
        }

        .linha__resposta {
          margin-left: 40px;
        }

        .margem {
          margin-top: 132px;
        }

        .fecho {
          margin-top: 140px;
          display: grid;
          grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
          gap: 56px;
          align-items: end;
        }

        .fecho__acao {
          margin-top: 0;
          justify-self: start;
          padding-bottom: 0.55em;
        }
      }
    </style>
  </body>
</html>
