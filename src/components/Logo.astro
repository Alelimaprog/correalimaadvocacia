---
/**
 * Logo — assinatura tipográfica do escritório, link para a home.
 *
 * O logotipo anterior (/brand/logo-dark-bg.svg) trazia um martelo de juiz em
 * verde vivo. Dois motivos para sair: o martelo é o clichê mais difundido da
 * categoria, e o verde não pertence mais ao sistema. O arquivo segue no
 * projeto — para voltar a ele, basta reintroduzir a <img> aqui.
 *
 * variant 'dark' = para fundo claro (tinta navy); 'light' = para fundo escuro.
 */
import { site } from '@/lib/site.config';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: cls } = Astro.props;
---

<a
  class:list={['logo', `logo--${variant}`, cls]}
  href="/"
  aria-label={`${site.name} — página inicial`}
>
  <span class="logo-nome">Corrêa&nbsp;Lima</span>
  <span class="logo-regra" aria-hidden="true"></span>
  <span class="logo-tipo">Advocacia</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .logo--light { color: var(--color-text-on-dark); }

  .logo-nome {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.375rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.012em;
    font-optical-sizing: auto;
  }

  /* Um filete curto separa o nome da natureza da atividade — a mesma régua
     que organiza o resto do site, na menor escala em que ela aparece. */
  .logo-regra {
    width: 1px;
    height: 0.9em;
    align-self: center;
    background: currentColor;
    opacity: 0.3;
  }

  .logo-tipo {
    font-family: var(--font-body);
    font-size: clamp(0.6875rem, 0.64rem + 0.18vw, 0.8125rem);
    font-weight: var(--weight-medium);
    letter-spacing: 0.17em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  @media (max-width: 420px) {
    .logo-regra,
    .logo-tipo { display: none; }
  }
</style>
