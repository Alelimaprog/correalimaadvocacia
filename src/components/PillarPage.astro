---
/**
 * PillarPage — layout compartilhado das seis páginas-pilar (Sprint 1).
 * Recebe `slug` e monta a página completa a partir de src/lib/nucleos.ts:
 * head (title/description exclusivos), JSON-LD (BreadcrumbList + Service +
 * FAQPage), breadcrumb, hero, problemas, serviços, para quem, como atuamos,
 * FAQ, conteúdos/áreas relacionados e CTA final. Um único h1 por página.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Icon from '@/components/Icon.astro';
import { site, whatsappHrefForPath } from '@/lib/site.config';
import { getNucleo } from '@/lib/nucleos';
import { pillarExtra } from '@/lib/pillar-extra';
import { getSubtopicsByNucleo } from '@/lib/subtopics';
import RelatedHub from '@/components/content/RelatedHub.astro';
import type { PageHead } from '@/lib/institucional';

interface Props { slug: string }
const { slug } = Astro.props;
const n = getNucleo(slug)!;
const waHref = whatsappHrefForPath(`/areas-de-atuacao/${slug}/`); // ETAPA 18
const extra = pillarExtra[slug];
const subs = getSubtopicsByNucleo(slug);
const guideForNucleo: Record<string, { slug: string; label: string }> = {
  'recuperacao-de-credito': { slug: 'cobranca-execucao-e-recuperacao-de-credito-empresarial', label: 'Guia completo de cobrança, execução e recuperação de crédito' },
  'cobranca-condominial': { slug: 'cobranca-condominial-guia-completo', label: 'Guia completo da cobrança condominial' },
  'direito-ambiental': { slug: 'direito-ambiental-guia-completo', label: 'Guia completo do direito ambiental' },
  'direito-aduaneiro-tributario': { slug: 'direito-aduaneiro-tributario-guia-completo', label: 'Guia completo do direito aduaneiro-tributário' },
  'direito-internacional': { slug: 'homologacao-de-sentenca-estrangeira-no-brasil', label: 'Guia completo da homologação de sentença estrangeira' },
  'inventario-e-patrimonio': { slug: 'inventario-guia-completo', label: 'Guia completo do inventário' },
};
const guide = guideForNucleo[slug];
// Rodada 3 (A4): checklist objetivo no cartão do hero, que qualifica o contato sem prometer nada.
const firstMessageByNucleo: Record<string, string[]> = {
  'direito-aduaneiro-tributario': [
    'número da DI ou DUIMP e o canal de conferência',
    'a exigência fiscal ou o auto de infração recebido',
    'fatura comercial, conhecimento de embarque e packing list',
    'a data em que a carga chegou e a armazenagem já cobrada',
  ],
  'inventario-e-patrimonio': [
    'certidão de óbito e data do falecimento',
    'relação dos bens conhecidos (imóveis, contas, veículos, empresas)',
    'quem são os herdeiros e se algum mora fora do Brasil',
    'se há testamento ou herdeiro menor de idade',
  ],
  'direito-internacional': [
    'a decisão estrangeira (sentença, divórcio, acordo) e o país de origem',
    'se ela trata de guarda, pensão ou partilha de bens',
    'se já tem apostila e tradução juramentada',
    'onde as partes moram hoje',
  ],
};
const firstMessage = firstMessageByNucleo[slug];

const canonical = `${site.url}${n.href}`;
const title = `${n.seoTitle} | ${site.name}`;
const ogImage = `${site.url}${site.ogImage}`;

const head: PageHead = {
  title,
  description: n.seoDescription,
  canonical,
  robots: 'index, follow',
  og: {
    title,
    description: n.seoDescription,
    url: canonical,
    type: 'website',
    site_name: site.name,
    locale: site.locale,
    image: ogImage,
  },
  twitter: { card: 'summary_large_image', title, description: n.seoDescription, image: ogImage },
};

const steps = [
  { nn: '01', t: 'Análise inicial da situação', d: 'Entendemos o problema, o objetivo e o contexto antes de qualquer medida.' },
  { nn: '02', t: 'Avaliação documental e estratégia', d: 'Analisamos os documentos e definimos a estratégia adequada ao caso.' },
  { nn: '03', t: 'Medidas cabíveis', d: 'Conduzimos as medidas extrajudiciais, administrativas ou judiciais pertinentes.' },
  { nn: '04', t: 'Acompanhamento', d: 'Acompanhamos o andamento e comunicamos cada etapa com clareza.' },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Áreas de Atuação', item: `${site.url}/areas-de-atuacao/` },
      { '@type': 'ListItem', position: 3, name: n.label, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: n.label,
    name: n.seoTitle,
    description: n.seoDescription,
    areaServed: 'BR',
    url: canonical,
    provider: {
      '@type': 'LegalService',
      name: site.name,
      url: `${site.url}/`,
      email: site.contact.email,
      telephone: site.contact.whatsapp.display,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: n.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
import AuthorNote from '@/components/AuthorNote.astro';
---

<BaseLayout head={head} footerCta={false}>
  <Fragment slot="jsonld">
    {jsonld.map((schema) => <JsonLd schema={schema} />)}
  </Fragment>

  <main id="conteudo-principal" class="pillar">
    <!-- Hero — primeira dobra padronizada (ver src/styles/first-fold.css) -->
    <section class="p-hero internal-first-fold">
      <div class="wrap">
        <nav class="crumbs" aria-label="Você está em">
          <a href="/">Início</a><span aria-hidden="true">/</span>
          <a href="/areas-de-atuacao/">Áreas de Atuação</a><span aria-hidden="true">/</span>
          <span>{n.label}</span>
        </nav>
        <div class="p-hero-grid">
          <div>
            <p class="eyebrow"><span class="dot"></span>{n.eyebrow}</p>
            <h1>{n.h1}</h1>
            <p class="p-hero-desc">{n.heroDescription}</p>
            <div class="p-cta">
              <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener noreferrer" data-cta-position="hero">Falar no WhatsApp</a>
              <a class="btn btn--secondary" href={`/contato/?area=${slug}`} data-cta-position="hero">Enviar meu caso</a>
            </div>
          </div>
          <aside class="p-hero-card" aria-label={firstMessage ? 'O que enviar na primeira mensagem' : 'Resumo'}>
            <span class="p-hero-ic"><Icon name={n.icon} size={28} /></span>
            {firstMessage ? (
              <div class="p-hero-card-t">
                <p class="p-fm-t">Para a primeira análise, tenha em mãos:</p>
                <ul class="p-fm">{firstMessage.map((i) => <li>{i}</li>)}</ul>
                <a class="p-fm-cta" href={`/contato/?area=${slug}`} data-cta-position="hero-card">Enviar meu caso →</a>
              </div>
            ) : (
              <p class="p-hero-card-t">{n.short}</p>
            )}
          </aside>
        </div>
      </div>
    </section>

    <!-- Entenda o problema — só existe se houver texto. Sem a guarda, um núcleo
         sem entrada em pillar-extra.ts rendereizava cabeçalho e vazio. -->
    {extra?.problem && (
      <section class="p-sec p-sec--white">
        <div class="wrap wrap--narrow">
          <p class="eyebrow"><span class="dot"></span>O problema</p>
          <h2>Entenda o problema</h2>
          <p class="p-lead">{extra.problem}</p>
        </div>
      </section>
    )}

    <!-- Conteúdo complementar opcional (tabela, passo a passo, atuação local),
         continuação visual de "Entenda o problema". Só existe com dados. -->
    {(extra?.table || extra?.local) && (
      <section class="p-sec p-sec--white p-more">
        <div class="wrap wrap--narrow">
          {extra.table && (
            <div class="x-block">
              <p class="eyebrow"><span class="dot"></span>Visão rápida</p>
              <h2 id="x-table-t">{extra.table.title}</h2>
              <div class="x-table-wrap is-stacked" role="region" aria-labelledby="x-table-t" tabindex="0">
                <table class="x-table tbl-stack" aria-labelledby="x-table-t">
                  <thead><tr>{extra.table.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
                  <tbody>
                    {extra.table.rows.map((r) => (
                      <tr><th scope="row">{r[0]}</th>{r.slice(1).map((c, i) => <td data-label={extra.table!.cols[i + 1]}>{c}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
          {extra.local && (
            <div class="x-block">
              <p class="eyebrow"><span class="dot"></span>Atuação local</p>
              <h2>{extra.local.title}</h2>
              <p class="p-lead">{extra.local.text}</p>
              {extra.local.links && (
                <ul class="x-links">
                  {extra.local.links.map((l) => <li><a href={l.href}>{l.label}<Icon name="arrow-right" size={15} /></a></li>)}
                </ul>
              )}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Problemas atendidos -->
    <section class="p-sec p-sec--white">
      <div class="wrap">
        <p class="eyebrow"><span class="dot"></span>Onde atuamos</p>
        <h2>Situações em que atuamos</h2>
        <ul class="check-grid">
          {n.situations.map((s) => (
            <li><Icon name="check" size={18} class="ck" /><span>{s}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Serviços -->
    <section class="p-sec p-sec--paper">
      <div class="wrap">
        <p class="eyebrow"><span class="dot"></span>Serviços</p>
        <h2>O que a atuação abrange</h2>
        <ul class="chip-grid">
          {n.services.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <!-- Riscos — idem: só renderiza com lista preenchida. -->
    {extra?.risks?.length ? (
      <section class="p-sec p-sec--white">
        <div class="wrap">
          <p class="eyebrow"><span class="dot"></span>Prazos e custos</p>
          <h2>Por que o tempo importa</h2>
          <ul class="risk-grid">
            {extra.risks.map((r) => (<li><Icon name="shield" size={18} class="rk" /><span>{r}</span></li>))}
          </ul>
        </div>
      </section>
    ) : null}

    <!-- CTA intermediário -->
    <section class="p-cta-mid">
      <div class="wrap cta-mid-inner">
        <p>Cada situação tem particularidades que só aparecem na leitura dos documentos.</p>
        <a class="btn btn--primary" href={`/contato/?area=${slug}`} data-cta-position="meio">Enviar meu caso</a>
      </div>
    </section>
    <div class="wrap"><AuthorNote /></div>

    <!-- Temas específicos (subpáginas) -->
    {subs.length > 0 && (
      <section class="p-sec p-sec--paper">
        <div class="wrap">
          <p class="eyebrow"><span class="dot"></span>Temas específicos</p>
          <h2>Explore em profundidade</h2>
          <ul class="sub-grid">
            {subs.map((x) => (
              <li><a href={`/areas-de-atuacao/${x.nucleo}/${x.slug}/`}><strong>{x.label}</strong><span>{x.seoDescription}</span><Icon name="arrow-right" size={16} class="sg-arrow" /></a></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Guia completo (linkagem pilar -> guia) -->
    {guide && (
      <section class="p-sec p-guide-band">
        <div class="wrap guide-inner">
          <div>
            <p class="eyebrow"><span class="dot"></span>Aprofunde no tema</p>
            <h2>{guide.label}</h2>
            <p class="p-lead">Um material de referência, organizado do básico ao avançado, para entender o tema com profundidade antes de decidir os próximos passos.</p>
            {slug === 'direito-aduaneiro-tributario' && (
              <p class="p-lead p-guide-extra">Termos técnicos da importação explicados em linguagem simples: <a href="/guias/glossario-aduaneiro/">glossário aduaneiro</a>.</p>
            )}
          </div>
          <a class="btn btn--primary" href={`/guias/${guide.slug}/`}>Ler o guia completo</a>
        </div>
      </section>
    )}

    <!-- Para quem / Como atuamos -->
    <section class="p-sec p-sec--white">
      <div class="wrap two-col">
        <div>
          <p class="eyebrow"><span class="dot"></span>Para quem</p>
          <h2>A quem se destina</h2>
          <ul class="check-grid check-grid--single">
            {n.forWhom.map((w) => (
              <li><Icon name="users" size={18} class="ck" /><span>{w}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow"><span class="dot"></span>Como atuamos</p>
          <h2>Do contato à condução</h2>
          <ol class="steps">
            {steps.map((s) => (
              <li><span class="s-n">{s.nn}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="p-sec p-sec--paper">
      <div class="wrap wrap--narrow">
        <p class="eyebrow"><span class="dot"></span>Perguntas frequentes</p>
        <h2>Dúvidas comuns</h2>
        <div class="faq">
          {n.faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<span class="faq-mark" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p class="faq-note">As respostas têm caráter informativo geral e não substituem a análise individual do caso.</p>
      </div>
    </section>

    <!-- Relacionados (hub rico: subáreas, guia, ferramenta, artigos, ver todos) -->
    <section class="p-sec p-sec--white">
      <div class="wrap">
        <RelatedHub cluster={slug} currentPath={n.href} />
      </div>
    </section>

    <!-- CTA final -->
    <section class="p-sec p-sec--navy">
      <div class="wrap cta-inner">
        <div>
          <h2 class="cta-title">Entenda os riscos e as medidas possíveis para o seu caso</h2>
          <p class="cta-text">Entre em contato para uma análise inicial da situação e dos documentos disponíveis.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn--primary" href={`/contato/?area=${slug}`} data-cta-position="final">Enviar meu caso</a>
          <a class="btn btn--ghost-light" href={waHref} target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* PillarPage — identidade própria (hero editorial claro), sistema compartilhado.
     Botões, eyebrow, faq, crumbs e chips vêm de ui.css (global). */
  .pillar :where(h2) {
    font-size: var(--text-2xl);
    color: var(--color-ink);
    margin-top: var(--space-2);
  }

  /* Hero claro.
     Altura: definida pela regra da primeira dobra (.internal-first-fold →
     first-fold.css) em desktop; o padding abaixo é respiro simétrico mínimo,
     que também define a altura natural no mobile (< 900px). O conteúdo é
     centralizado verticalmente pela regra global — sem faixa vazia embaixo. */
  .p-hero {
    background: var(--surface-warm);
    padding-block: clamp(2rem, 1.5rem + 2.4vw, 3.25rem);
    border-bottom: 1px solid var(--border-subtle);
  }
  .p-hero .crumbs { margin-bottom: var(--space-4); }
  .p-hero-grid { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 900px) { .p-hero-grid { grid-template-columns: 1.6fr 1fr; gap: var(--space-12); } }
  .p-hero h1 {
    font-size: var(--text-4xl);
    color: var(--color-ink);
    margin-top: var(--space-3);
    max-width: 16ch;
  }
  .p-hero-desc {
    margin-top: var(--space-4);
    color: var(--color-text);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    max-width: var(--measure-narrow);
  }
  .p-cta { margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (max-width: 519.98px) { .p-cta { flex-direction: column; } .p-cta .btn { width: 100%; } }

  .p-hero-card {
    display: flex; align-items: flex-start; gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-accent);
    border-radius: 0;
    padding: var(--space-6);
  }
  .p-hero-ic {
    display: inline-flex; height: 2.5rem; width: 2.5rem; flex: none; align-items: center;
    justify-content: center; border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: transparent; color: var(--color-accent);
  }
  .p-hero-card-t { margin-top: var(--space-4); color: var(--color-text); line-height: var(--leading-normal); font-size: var(--text-base); }
  div.p-hero-card-t { margin-top: 0.4rem; font-size: var(--text-sm); }
  .p-fm-t { font-weight: var(--weight-semibold); color: var(--color-ink); }
  .p-fm { margin: var(--space-2) 0 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; }
  .p-fm-cta { display: inline-block; margin-top: var(--space-3); font-weight: var(--weight-semibold); color: var(--color-navy); }
  @media (max-width: 939px) { .p-hero-card { margin-top: var(--space-5); padding: var(--space-4); } .p-hero-ic { display: none; } }

  /* Seções — ritmo claro/alternado */
  .p-sec { padding-block: var(--section-y); }
  .p-sec--white { background: var(--surface); }
  .p-sec--paper { background: var(--surface-subtle); }
  .p-sec--navy { background: var(--surface-strong); color: var(--color-text-on-dark); }
  .p-sec--navy :where(h2) { color: #fff; }
  .p-lead { margin-top: var(--space-4); color: var(--color-text); font-size: var(--text-md); line-height: var(--leading-relaxed); max-width: var(--measure); }

  .check-grid { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .check-grid { grid-template-columns: repeat(2, 1fr); } }
  .check-grid--single { grid-template-columns: 1fr; }
  .check-grid li { display: flex; gap: var(--space-3); align-items: flex-start; color: var(--color-text); line-height: var(--leading-normal); }
  .ck { color: var(--color-accent); flex: none; margin-top: 3px; }

  .chip-grid { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; gap: 0 var(--space-8); grid-template-columns: 1fr; border-top: 1px solid var(--border-strong); }
  @media (min-width: 720px) { .chip-grid { grid-template-columns: repeat(2, 1fr); } }
  .chip-grid li {
    position: relative; border-bottom: 1px solid var(--color-border);
    padding: 0.8rem 0 0.8rem 1.4rem; font-size: var(--text-base); line-height: var(--leading-normal); color: var(--color-text);
  }
  .chip-grid li::before { content: ''; position: absolute; left: 0; top: calc(0.8rem + 0.78em); width: 0.7rem; height: 1px; background: var(--color-accent); }

  .risk-grid { list-style: none; padding: 0; margin: var(--space-5) 0 0; display: grid; gap: 0 var(--space-8); grid-template-columns: 1fr; border-top: 1px solid var(--border-strong); }
  @media (min-width: 720px) { .risk-grid { grid-template-columns: repeat(2, 1fr); } }
  .risk-grid li {
    display: flex; gap: var(--space-3); align-items: flex-start;
    border-bottom: 1px solid var(--color-border); padding: var(--space-4) 0;
    color: var(--color-text); font-size: var(--text-base); line-height: var(--leading-normal);
  }
  .rk { color: var(--color-warn); flex: none; margin-top: 3px; }

  /* CTA intermediário — realce de ação suave */
  .p-cta-mid { background: var(--surface-cream); border-block: 1px solid var(--color-border); }
  .cta-mid-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-6); }
  .cta-mid-inner p { font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-ink); }

  .sub-grid { list-style: none; padding: 0; margin: var(--space-6) 0 0; display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
  @media (min-width: 860px) { .sub-grid { grid-template-columns: repeat(2, 1fr); } }
  .sub-grid li { display: flex; }
  .sub-grid a {
    position: relative; flex: 1;
    display: grid; grid-template-columns: 1fr auto; align-items: start; align-content: start; gap: var(--space-2) var(--space-3);
    padding: var(--space-5); background: var(--surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-sm); text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .sub-grid a::after { content: ''; position: absolute; inset: -1px -1px auto -1px; height: 2px; background: var(--color-accent); opacity: 0; transition: opacity var(--dur) var(--ease); }
  .sub-grid a:hover { border-color: var(--border-strong); }
  .sub-grid a:hover::after { opacity: 1; }
  .sub-grid strong { color: var(--color-ink); font-weight: var(--weight-semibold); }
  .sub-grid span { grid-column: 1 / -1; color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
  /* O ícone é outro componente: :global para o estilo chegar ao <svg>. */
  .sub-grid :global(.sg-arrow) { color: var(--color-accent); grid-area: 1 / 2; align-self: center; }
  .sub-grid a:focus-visible { outline: 2px solid var(--ring-color); outline-offset: 2px; }

  .p-guide-extra { margin-top: var(--space-3); }
  .p-guide-extra a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  /* Banda "Guia completo" — superfície distinta e clara (não escura) */
  .p-guide-band { background: var(--surface-muted); border-block: 1px solid var(--border-subtle); }
  .p-guide-band :where(h2) { color: var(--color-ink); }
  .p-guide-band .p-lead { color: var(--color-text); }
