---
/** Contact block and professional notice for English pages. */
import { site } from '@/lib/site.config';
interface Props { wa: string }
const { wa } = Astro.props;
---
<aside class="en-notice">
  <h2>Contact</h2>
  <p>Corrêa Lima Advocacia, {site.contact.address.full}. Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>. Meetings by video call in English are available.</p>
  <div class="en-cta"><a class="btn btn--primary" href={wa} target="_blank" rel="noopener noreferrer" data-cta-position="en-page">WhatsApp</a><a class="btn btn--secondary" href={`mailto:${site.contact.email}`}>Email</a></div>
  <p class="small">Alexandre Corrêa Lima is admitted to practise law in Brazil (OAB/SP 234,511) and advises on Brazilian law only. This page is general information, not legal advice, and does not create a lawyer–client relationship.</p>
</aside>
<style>
  .en-notice { margin-top: var(--space-10); max-width: 46rem; background: var(--surface-muted); padding: var(--space-6); border-radius: var(--radius-lg); }
  .en-notice h2 { font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-ink); }
  .en-notice p { margin-top: var(--space-3); line-height: var(--leading-relaxed); }
  .en-notice a { color: var(--color-green-strong); }
  .en-cta { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  .en-cta a { color: inherit; }
  .small { font-size: var(--text-xs); color: var(--color-text-muted); }
</style>
