---
/**
 * ContextualCta — bloco de conversão contextual para artigos/guias.
 * Usa a mensagem de WhatsApp por página (helper existente) e mantém a linguagem
 * de CTA padronizada. O título/texto vêm por prop para refletir a área.
 * Uso: <ContextualCta titulo="…" texto="…" areaHref="/areas-de-atuacao/…/" />
 */
import { whatsappHrefForPath } from '@/lib/site.config';
import Icon from '@/components/Icon.astro';
interface Props { titulo?: string; texto?: string; areaHref?: string; }
const {
  titulo = 'Precisa avaliar a sua situação?',
  texto = 'Apresente o caso e entenda quais podem ser os próximos passos.',
  areaHref,
} = Astro.props;
const waHref = whatsappHrefForPath(Astro.url.pathname);
---
<aside class="ec-cta">
  <div>
    <p class="ec-cta-t">{titulo}</p>
    <p class="ec-cta-d">{texto}</p>
  </div>
  <div class="ec-cta-actions">
    <a class="btn btn--primary" href="/contato/" data-cta-position="artigo">Falar sobre o meu caso</a>
    <a class="btn btn--secondary" href={waHref} target="_blank" rel="noopener noreferrer" data-cta-position="artigo">Falar pelo WhatsApp</a>
    {areaHref && (
      <a class="ec-area" href={areaHref}>Conhecer esta área <span class="ec-area-ic"><Icon name="arrow-right" size={15} /></span></a>
    )}
  </div>
</aside>

<style>
  /* Fecho do texto: uma faixa delimitada por filetes, na largura da leitura.
     O cartão de fundo colorido competia com a prosa e destoava do resto do
     sistema — aqui o bloco se separa pelo espaço e pela régua, não pela cor. */
  .ec-cta {
    display: grid; gap: var(--space-5);
    border: 0; border-block: 1px solid var(--color-border);
    background: none; border-radius: 0;
    padding-block: var(--space-8);
    margin: var(--space-12) 0 var(--space-8);
  }
  @media (min-width: 720px) { .ec-cta { grid-template-columns: 1.3fr 1fr; align-items: center; gap: var(--space-8); } }
  .ec-cta-t { font-family: var(--font-display); font-weight: var(--weight-regular); letter-spacing: var(--tracking-tight); color: var(--color-ink); font-size: var(--text-2xl); line-height: var(--leading-snug); max-width: 24ch; }
  .ec-cta-d { margin-top: var(--space-3); color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .ec-cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .ec-area { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-ink); font-weight: var(--weight-medium); font-size: var(--text-sm); text-decoration: none; border-bottom: 1px solid var(--color-accent); padding-bottom: 2px; transition: color var(--dur) var(--ease); }
  .ec-area:hover { color: var(--color-accent); }
  .ec-area-ic { display: inline-flex; }
</style>
