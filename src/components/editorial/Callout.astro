---
/**
 * Callout — bloco de destaque editorial (Nota / Atenção / Importante).
 * Reutilizável em guias e artigos. Sem conteúdo jurídico embutido: o texto vem
 * do slot. Acessível (role e cor + ícone, não só cor).
 * Uso: <Callout tipo="atencao" titulo="Prazo">Conteúdo…</Callout>
 */
import Icon from '@/components/Icon.astro';
interface Props { tipo?: 'nota' | 'atencao' | 'importante'; titulo?: string; }
const { tipo = 'nota', titulo } = Astro.props;
const cfg = {
  nota: { icon: 'message', label: 'Nota' },
  atencao: { icon: 'shield', label: 'Atenção' },
  importante: { icon: 'scale', label: 'Importante' },
}[tipo];
---
<aside class:list={['callout', `callout--${tipo}`]} role="note">
  <span class="callout-ic"><Icon name={cfg.icon} size={18} /></span>
  <div class="callout-body">
    <p class="callout-title">{titulo ?? cfg.label}</p>
    <div class="callout-content"><slot /></div>
  </div>
</aside>

<style>
  /* Destaque por filete lateral, não por campo colorido: dentro da leitura,
     o fundo tingido competia com a prosa em vez de apoiá-la. */
  .callout { display: flex; gap: var(--space-4); border: 0; border-left: 2px solid var(--color-border); border-radius: 0; padding: var(--space-1) 0 var(--space-1) var(--space-5); background: none; margin: var(--space-6) 0; }
  .callout-ic { flex: none; display: inline-flex; color: var(--color-accent); }
  .callout-title { font-family: var(--font-body); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--color-text-subtle); font-size: var(--text-xs); }
  .callout-content { margin-top: 0.25rem; color: var(--color-text); font-size: var(--text-sm); line-height: var(--leading-relaxed); }
  .callout--nota { border-left-color: var(--color-accent); }
  .callout--atencao { border-left-color: var(--color-warning); background: none; }
  .callout--atencao .callout-ic { color: var(--color-warning); }
  .callout--importante { border-left-color: var(--color-navy); background: none; }
</style>
