---
/**
 * SEO — emite o <head> de cada página. Na Fase 3, reproduz FIELMENTE o head do
 * site atual: recebe um objeto `head` (capturado do export) e emite exatamente
 * title, description, canonical, robots, author e as tags Open Graph/Twitter
 * que a página realmente tinha (os três padrões observados são reproduzidos:
 * OG por-página, OG estático e ausência de OG).
 *
 * Sem `head`, cai no modo simples (title via template + defaults) usado por
 * páginas utilitárias.
 */
import { site, buildTitle, canonicalUrl } from '@/lib/site.config';
import type { PageHead } from '@/lib/institucional';

interface Props {
  head?: PageHead;
  // Modo simples (fallback)
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** Quando true, NUNCA emite <link rel="canonical"> (ex.: página 404). */
  noCanonical?: boolean;
}
const { head, title, description, canonical, noindex, noCanonical } = Astro.props;

// Resolve valores (modo fiel via `head`, ou modo simples)
const tituloBruto = head?.title ?? buildTitle(title);

/**
 * Sufixo de marca no <title> — três degraus.
 *
 * Diagnóstico desta rodada: 105 das 168 páginas passavam de 65 caracteres, e
 * três (as de /ferramentas/) traziam o nome do escritório DUAS vezes, porque o
 * `title` já vinha com a marca e ainda passava pelo template que a acrescenta.
 *
 * O Google corta o título por largura; acima de ~60 caracteres o que se perde
 * é justamente o final — ou seja, a marca. Então:
 *   base curta  -> " | Corrêa Lima Advocacia"
 *   base média  -> " | Corrêa Lima"
 *   base longa  -> sem sufixo, porque um "| Corrêa Lim…" cortado é pior do que
 *                  nenhum sufixo (e o Google costuma acrescentar o nome do site
 *                  por conta própria).
 *
 * Nenhum título editorial é reescrito aqui: só o sufixo é negociado.
 */
const MARCA_LONGA = ` | ${site.name}`;
const MARCA_CURTA = ' | Corrêa Lima';

function tituloComMarca(bruto: string): string {
  // Remove toda repetição do sufixo já presente (inclusive a duplicada).
  let base = bruto;
  while (base.endsWith(MARCA_LONGA)) base = base.slice(0, -MARCA_LONGA.length);
  while (base.endsWith(MARCA_CURTA)) base = base.slice(0, -MARCA_CURTA.length);
  base = base.trim();

  if (base.length + MARCA_LONGA.length <= 62) return base + MARCA_LONGA;
  // Até 68 caracteres a perda na SERP é de um ou dois caracteres do sufixo —
  // preferível a abrir mão da marca. Acima disso, o sufixo não sobreviveria.
  if (base.length + MARCA_CURTA.length <= 65) return base + MARCA_CURTA;
  return base;
}

const t = tituloComMarca(tituloBruto);

const desc = head?.description ?? description ?? site.defaultDescription;
const canon = noCanonical
  ? null
  : head?.canonical ?? canonical ?? canonicalUrl(Astro.url.pathname);
const robots = head?.robots ?? (noindex ? 'noindex, follow' : 'index, follow');
const author = head?.author ?? null;
const authorLink = head?.authorLink ?? null;
const og = head?.og;
const tw = head?.twitter;
// Rodada 2 (11/2026): OG/Twitter SEMPRE coerentes com a página. Valores
// genéricos herdados (título = nome do site, og:url = home) são substituídos
// pelos da própria página; páginas no modo simples ganham OG/Twitter.
const homeUrl = `${site.url}/`;
const ogTitle = og?.title ?? t;
const ogDesc = og?.description ?? desc;
const ogUrl = og?.url && !(og.url === homeUrl && canon && canon !== homeUrl) ? og.url : canon;
const ogType = og?.type ?? 'website';
const ogImage = og?.image ?? `${site.url}${site.ogImage}`;
const twTitle = tw?.title && tw.title !== site.name ? tw.title : ogTitle;
const twDesc = tw?.description && tw.description !== site.defaultDescription ? tw.description : ogDesc;
const twImage = tw?.image ?? ogImage;
---

<title>{t}</title>
{desc && <meta name="description" content={desc} />}
{canon && <link rel="canonical" href={canon} />}
{robots && <meta name="robots" content={robots} />}
{author && <meta name="author" content={author} />}
{authorLink && <link rel="author" href={authorLink} />}

{/* Open Graph */}
{ogTitle && <meta property="og:title" content={ogTitle} />}
{ogDesc && <meta property="og:description" content={ogDesc} />}
{ogUrl && <meta property="og:url" content={ogUrl} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="pt_BR" />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={site.name} />}

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
{twTitle && <meta name="twitter:title" content={twTitle} />}
{twDesc && <meta name="twitter:description" content={twDesc} />}
{twImage && <meta name="twitter:image" content={twImage} />}
