---
/**
 * SEO — emite o <head> de cada página. Na Fase 3, reproduz FIELMENTE o head do
 * site atual: recebe um objeto `head` (capturado do export) e emite exatamente
 * title, description, canonical, robots, author e as tags Open Graph/Twitter
 * que a página realmente tinha (os três padrões observados são reproduzidos:
 * OG por-página, OG estático e ausência de OG).
 *
 * Sem `head`, cai no modo simples (title via template + defaults) usado por
 * páginas utilitárias.
 *
 * Open Graph e Twitter Card têm um piso: toda página emite ao menos title,
 * description, url, type, site_name, locale e imagem. Antes, páginas no modo
 * simples — ferramentas, /contato/obrigado/, 404 — saíam sem nenhuma dessas
 * tags, e qualquer compartilhamento delas no WhatsApp ou no LinkedIn aparecia
 * como link cru. Onde a página traz `head.og`, o valor dela prevalece: a
 * fidelidade ao head capturado continua intacta.
 */
import { site, buildTitle, canonicalUrl } from '@/lib/site.config';
import type { PageHead } from '@/lib/institucional';

interface Props {
  head?: PageHead;
  // Modo simples (fallback)
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** Quando true, NUNCA emite <link rel="canonical"> (ex.: página 404). */
  noCanonical?: boolean;
}
const { head, title, description, canonical, noindex, noCanonical } = Astro.props;

// Resolve valores (modo fiel via `head`, ou modo simples)
const t = head?.title ?? buildTitle(title);
const desc = head?.description ?? description ?? site.defaultDescription;
const canon = noCanonical
  ? null
  : head?.canonical ?? canonical ?? canonicalUrl(Astro.url.pathname);
const robots = head?.robots ?? (noindex ? 'noindex, follow' : 'index, follow');
const author = head?.author ?? null;
const authorLink = head?.authorLink ?? null;
const og = head?.og;
const tw = head?.twitter;

/** Piso de compartilhamento: o que a página declarar vence; o resto é derivado. */
const ogTitle = og?.title ?? t;
const ogDescription = og?.description ?? desc;
const ogUrl = og?.url ?? canon ?? canonicalUrl(Astro.url.pathname);
const ogType = og?.type ?? 'website';
const ogSiteName = og?.site_name ?? site.name;
const ogLocale = og?.locale ?? site.locale;
const ogImage = og?.image ?? `${site.url}${site.ogImage}`;

const twCard = tw?.card ?? 'summary_large_image';
const twTitle = tw?.title ?? ogTitle;
const twDescription = tw?.description ?? ogDescription;
const twImage = tw?.image ?? ogImage;
---

<title>{t}</title>
{desc && <meta name="description" content={desc} />}
{canon && <link rel="canonical" href={canon} />}
{robots && <meta name="robots" content={robots} />}
{author && <meta name="author" content={author} />}
{authorLink && <link rel="author" href={authorLink} />}

{/* Open Graph — valores da página quando existirem, derivados quando não */}
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={ogUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={ogSiteName} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.name} />

{/* Twitter Card */}
<meta name="twitter:card" content={twCard} />
<meta name="twitter:title" content={twTitle} />
<meta name="twitter:description" content={twDescription} />
<meta name="twitter:image" content={twImage} />
