---
/**
 * HomeContent — Home reformulada para conversão (reconhecimento → compreensão →
 * confiança → redução de incerteza → contato). Seções: faixa de confiança,
 * entrada por problema, áreas de atuação, perfis atendidos, como funciona,
 * forma de atuação, conteúdos, FAQ (2 colunas) e CTA. Sem números inventados.
 */
import { whatsappHrefForPath } from '@/lib/site.config';
import { nucleos, getNucleo } from '@/lib/nucleos';
import { site } from '@/lib/site.config';
import Icon from '@/components/Icon.astro';
import { homeFaq as faq } from '@/lib/home-faq';

const N = (s: string) => getNucleo(s)!.href;

const problems = [
  { t: 'Mercadoria retida ou autuada na importação', d: 'Retenção na aduana, exigências da Receita, canal vermelho, multas aduaneiras e pena de perdimento.', href: '/areas-de-atuacao/direito-aduaneiro-tributario/retencao-de-mercadorias/' },
  { t: 'Há um inventário ou partilha a resolver', d: 'Inventário em cartório ou judicial em São Paulo, inclusive com herdeiros ou bens no exterior.', href: N('inventario-e-patrimonio') },
  { t: 'Uma sentença ou divórcio estrangeiro precisa valer no Brasil', d: 'Homologação no STJ ou averbação direta em cartório, conforme o que a decisão dispõe.', href: '/areas-de-atuacao/homologacao-de-sentenca-estrangeira/' },
  { t: 'A empresa precisa de assessoria jurídica recorrente', d: 'Contratos, decisões societárias e análise de risco antes de a operação ser fechada.', href: N('direito-empresarial') },
  { t: 'Há valores a receber de clientes ou parceiros', d: 'Cobrança, execução de títulos e localização de patrimônio do devedor.', href: N('recuperacao-de-credito') },
  { t: 'A empresa foi acionada na Justiça do Trabalho', d: 'Defesa do empregador, dimensionamento de passivo e consultoria preventiva.', href: N('trabalhista-empresarial') },
  { t: 'A operação recebeu multa ou embargo ambiental', d: 'Defesa administrativa ou judicial diante da autuação.', href: N('direito-ambiental') },
  { t: 'O condomínio possui cotas em atraso', d: 'Cobrança de cotas condominiais e negociação de acordos.', href: N('cobranca-condominial') },
];

const perfis = [
  { icon: 'building', t: 'Empresas e seus administradores', d: 'Contratos, relações societárias, contencioso estratégico e assessoria recorrente à operação.' },
  { icon: 'package', t: 'Importadores, exportadores e tradings', d: 'Retenção de mercadorias, autuações, perdimento, classificação fiscal e tributação na importação.' },
  // Este lugar da lista era "Operadores logísticos e terminais". Saiu: o acervo
  // do site documenta comércio exterior e aduaneiro, não a cadeia de transporte
  // nem operação portuária — afirmar o perfil seria anunciar cliente que o
  // projeto não comprova atender. Entra um perfil que tem área própria
  // publicada (cobrança condominial), e a matéria de transporte fica pendente
  // junto com o rascunho de Direito Marítimo e Portuário.
  { icon: 'home', t: 'Condomínios e administradoras', d: 'Recuperação de cotas em atraso, formalização de acordos e controle jurídico da inadimplência.' },
  { icon: 'users', t: 'Departamentos de RH e gestores', d: 'Defesa do empregador, auditoria de passivo, políticas internas e contratos de trabalho.' },
  { icon: 'coins', t: 'Credores e áreas financeiras', d: 'Cobrança, execução de títulos, habilitação de crédito e recuperação judicial do devedor.' },
  { icon: 'globe', t: 'Empresas e pessoas com demandas no exterior', d: 'Decisões estrangeiras, documentos, patrimônio e operações entre países.' },
];

const steps = [
  { n: '01', t: 'Entendimento inicial', d: 'Conhecemos a situação, o objetivo do cliente e os principais acontecimentos relacionados ao problema.' },
  { n: '02', t: 'Análise dos documentos e riscos', d: 'Examinamos os documentos disponíveis e identificamos os pontos que precisam de atenção.' },
  { n: '03', t: 'Definição das medidas possíveis', d: 'Apresentamos as alternativas adequadas — negociação, procedimento administrativo ou processo judicial.' },
  { n: '04', t: 'Condução e acompanhamento', d: 'Após a contratação, o escritório conduz as medidas definidas e informa os acontecimentos relevantes.' },
];

const diferenciais = [
  { icon: 'search', t: 'Análise antes da adoção de medidas', d: 'Os documentos, riscos e objetivos são examinados antes de definir o caminho jurídico.' },
  { icon: 'route', t: 'Estratégia proporcional ao problema', d: 'A medida considera urgência, custos, riscos, patrimônio envolvido e possibilidade prática de resultado.' },
  { icon: 'shield', t: 'Leitura jurídica e econômica da operação', d: 'A análise considera o processo e também os efeitos sobre contratos, crédito, estoque e continuidade da atividade.' },
  { icon: 'file', t: 'Atuação preventiva e contenciosa', d: 'Atuação tanto na prevenção de conflitos quanto em procedimentos administrativos e judiciais.' },
  { icon: 'message', t: 'Comunicação objetiva', d: 'Etapas, alternativas e acontecimentos relevantes apresentados de maneira compreensível.' },
  { icon: 'globe', t: 'Casos nacionais e internacionais', d: 'Demandas no Brasil e situações envolvendo bens, pessoas, documentos ou decisões estrangeiras.' },
];

const conteudos = [
  { tag: 'Guia', t: 'Direito Aduaneiro-Tributário', d: 'Retenção de mercadorias, exigências fiscais, multas e pena de perdimento: o que fazer e em que prazo.', href: '/guias/direito-aduaneiro-tributario-guia-completo/' },
  { tag: 'Guia', t: 'Inventário: guia completo', d: 'Inventário em cartório ou judicial, documentos, prazos, ITCMD e herdeiros no exterior.', href: '/guias/inventario-guia-completo/' },
  { tag: 'Guia', t: 'Homologação de Sentença Estrangeira no Brasil', d: 'Quando a decisão estrangeira precisa ser homologada no STJ e quando basta a averbação em cartório.', href: '/guias/homologacao-de-sentenca-estrangeira-no-brasil/' },
];

---

<!-- Entrada por problema -->
<section class="hs hs--cream">
  <div class="hc">
    <p class="eyebrow"><span class="dot"></span>Por onde começar</p>
    <h2 class="sec-h2">Qual demanda trouxe você até aqui?</h2>
    <p class="sec-intro">Cada entrada abaixo leva à área correspondente, com o escopo da atuação e o que costuma ser analisado primeiro.</p>
    <ul class="problem-grid">
      {problems.map((p) => (
        <li>
          <a href={p.href}>
            <span class="pg-body">
              <span class="pg-t">{p.t}</span>
              <span class="pg-d">{p.d}</span>
            </span>
            <span class="pg-arrow"><Icon name="arrow-right" size={18} /></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="quick-links">
      Também procurados:
      <a href="/areas-de-atuacao/direito-aduaneiro-tributario/pena-de-perdimento/">pena de perdimento</a> ·
      <a href="/areas-de-atuacao/direito-aduaneiro-tributario/defesa-administrativa-aduaneira/">auto de infração aduaneiro</a> ·
      <a href="/areas-de-atuacao/inventario-com-herdeiro-no-exterior/">inventário com herdeiro no exterior</a> ·
      <a href="/areas-de-atuacao/inventario-e-patrimonio/inventario-extrajudicial/">inventário em cartório</a> ·
      <a href="/areas-de-atuacao/homologacao-de-divorcio-estrangeiro/">divórcio feito no exterior</a> ·
      <a href="/areas-de-atuacao/homologacao-de-sentenca-dos-estados-unidos/">sentença dos EUA</a>
    </p>
  </div>
</section>

<!-- Áreas de atuação -->
<section class="hs hs--white">
  <div class="hc">
    <p class="eyebrow"><span class="dot"></span>Áreas de atuação</p>
    <h2 class="sec-h2">Atuação jurídica organizada por áreas complementares</h2>
    <p class="sec-intro">O escritório concentra sua atuação em questões da atividade empresarial: contratos, relações de trabalho do lado do empregador, crédito, importações, questões ambientais e demandas com elemento internacional.</p>
    <div class="nucleo-grid">
      {nucleos.map((n) => (
        <a class="ncard" href={n.href}>
          <span class="ncard-ic"><Icon name={n.icon} size={24} /></span>
          <h3 class="ncard-t">{n.label}</h3>
          <p class="ncard-d">{n.short}</p>
          <span class="ncard-more">Conhecer esta área <Icon name="arrow-right" size={15} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Perfis atendidos -->
<section class="hs hs--ornament">
  <div class="hc">
    <p class="eyebrow"><span class="dot"></span>Perfis atendidos</p>
    <h2 class="sec-h2">Atuação direcionada ao contexto de cada cliente</h2>
    <p class="sec-intro">Os riscos, documentos e medidas possíveis variam conforme o perfil do cliente e a natureza da demanda.</p>
    <div class="perfil-grid">
      {perfis.map((p) => (
        <article class="perfil">
          <span class="perfil-ic"><Icon name={p.icon} size={22} /></span>
          <div>
            <h3 class="perfil-t">{p.t}</h3>
            <p class="perfil-d">{p.d}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Como funciona -->
<section class="hs hs--warm">
  <div class="hc">
    <p class="eyebrow"><span class="dot"></span>Como funciona</p>
    <h2 class="sec-h2">Do primeiro contato à definição da estratégia</h2>
    <div class="step-grid">
      {steps.map((s) => (
        <article class="step">
          <span class="step-n">{s.n}</span>
          <h3 class="step-t">{s.t}</h3>
          <p class="step-d">{s.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Forma de atuação (diferenciais) -->
<section class="hs hs--white">
  <div class="hc">
    <p class="eyebrow"><span class="dot"></span>Forma de atuação</p>
    <h2 class="sec-h2">Critério técnico, estratégia e clareza na condução do caso</h2>
    <div class="dif-grid">
      {diferenciais.map((d) => (
        <article class="dif">
          <span class="dif-ic"><Icon name={d.icon} size={22} /></span>
          <div>
            <h3 class="dif-t">{d.t}</h3>
            <p class="dif-d">{d.d}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Conteúdos -->
<section class="hs hs--warm">
  <div class="hc">
    <p class="eyebrow"><span class="dot"></span>Conteúdos</p>
    <h2 class="sec-h2">Materiais para entender melhor o seu caso</h2>
    <div class="cont-grid">
      {conteudos.map((c) => (
        <a class="cont" href={c.href}>
          <span class="cont-tag">{c.tag}</span>
          <h3 class="cont-t">{c.t}</h3>
          <p class="cont-d">{c.d}</p>
          <span class="cont-more">Ler o guia <Icon name="arrow-right" size={15} /></span>
        </a>
      ))}
    </div>
    <a class="viewall" href="/guias/">Ver todos os conteúdos <Icon name="arrow-right" size={15} /></a>
  </div>
</section>

<!-- FAQ — duas colunas -->
<section class="hs hs--faq">
  <div class="hc faq-split">
    <div class="faq-aside">
      <p class="eyebrow"><span class="dot"></span>Perguntas frequentes</p>
      <h2 class="sec-h2">Antes de entrar em contato</h2>
      <p class="sec-intro">Respostas objetivas para dúvidas recorrentes sobre mercadoria retida na importação, inventário, decisões estrangeiras, cobrança e execução. As respostas têm caráter informativo e não substituem a análise individual do caso.</p>
      <div class="faq-cta">
        <p class="faq-cta-t">Não encontrou a sua dúvida?</p>
        <p class="faq-cta-d">Apresente brevemente a situação para que o escritório possa identificar a área jurídica relacionada.</p>
        <a class="btn btn--primary" href="#contato" data-cta-position="faq">Enviar meu caso</a>
      </div>
    </div>
    <div class="faq-list">
      {faq.map((f) => (
        <details class="faq-item">
          <summary>
            <span>{f.q}</span>
            <span class="faq-mark" aria-hidden="true"></span>
          </summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>


<style>
  .quick-links { margin-top: 1.25rem; font-size: 0.95rem; line-height: 1.7; color: var(--color-text-muted, #5b6472); }
  .quick-links a { color: var(--color-ink, #10233b); text-decoration: underline; text-underline-offset: 2px; }
  .hs { padding-block: var(--section-y); }
  .hs--warm { background: var(--surface-warm); }
  .hs--cream { background: var(--surface-cream); }
  .hs--white { background: var(--surface); }
  .hc { width: 100%; max-width: var(--container-max); margin-inline: auto; padding-inline: var(--container-pad); }

  .eyebrow { font-family: var(--font-body); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--color-accent); font-weight: var(--weight-semibold); display: inline-flex; align-items: center; gap: 0.5rem; }
  /* Herda a regua de ui.css; manter uma bolinha aqui recriaria o bullet. */
  .eyebrow .dot { height: 1px; width: 24px; border-radius: 0; background: currentColor; }
  .eyebrow--on-dark { color: var(--color-accent-soft); }
  .eyebrow--on-dark .dot { background: currentColor; }
  .sec-h2 { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-3xl); color: var(--color-ink); line-height: var(--leading-snug); margin-top: var(--space-3); max-width: 26ch; text-wrap: balance; }
  .sec-intro { margin-top: var(--space-3); max-width: var(--measure); color: var(--color-text-muted); font-size: var(--text-md); line-height: var(--leading-normal); }


  /* Entrada por problema */
  .problem-grid { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 760px) { .problem-grid { grid-template-columns: 1fr 1fr; } }
  .problem-grid a { position: relative; display: flex; align-items: center; gap: var(--space-4); background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1.1rem 1.25rem; text-decoration: none; transition: border-color var(--dur) var(--ease); }
  .problem-grid a::after { content: ''; position: absolute; inset: -1px -1px auto -1px; height: 2px; background: var(--color-accent); opacity: 0; transition: opacity var(--dur) var(--ease); }
  .problem-grid a:hover { border-color: var(--border-strong); }
  .problem-grid a:hover::after { opacity: 1; }
  .pg-body { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; }
  .pg-t { color: var(--color-ink); font-weight: var(--weight-semibold); font-size: var(--text-md); line-height: var(--leading-snug); }
  .pg-d { color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
  .pg-arrow { display: inline-flex; color: var(--color-green-strong); flex: none; transition: transform var(--dur) var(--ease); }
  .problem-grid a:hover .pg-arrow { transform: translateX(3px); }

  /* Cards de núcleos */
  .nucleo-grid { margin-top: var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 640px) { .nucleo-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .nucleo-grid { grid-template-columns: repeat(3, 1fr); } }
  .ncard { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-6); text-decoration: none; transition: border-color var(--dur) var(--ease); }
  .ncard::after { content: ''; position: absolute; inset: -1px -1px auto -1px; height: 2px; background: var(--color-accent); opacity: 0; transition: opacity var(--dur) var(--ease); }
  .ncard:hover { border-color: var(--border-strong); }
  .ncard:hover::after { opacity: 1; }
  .ncard-ic { display: inline-flex; height: 3rem; width: 3rem; align-items: center; justify-content: center; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: transparent; color: var(--color-accent); }
  .ncard-t { margin-top: var(--space-4); font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-ink); }
  .ncard-d { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); flex: 1; }
  .ncard-more { margin-top: var(--space-4); display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-green-strong); font-weight: var(--weight-semibold); font-size: var(--text-sm); }
  .ncard:hover .ncard-more { color: var(--color-green); }

  /* Perfis atendidos */
  .perfil-grid { margin-top: var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 700px) { .perfil-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .perfil-grid { grid-template-columns: repeat(3, 1fr); } }
  .perfil { display: flex; gap: var(--space-4); background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-5); }
  .perfil-ic { flex: none; display: inline-flex; height: 2.75rem; width: 2.75rem; align-items: center; justify-content: center; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: transparent; color: var(--color-accent); }
  .perfil-t { font-family: var(--font-display); font-size: var(--text-md); color: var(--color-ink); line-height: var(--leading-snug); }
  .perfil-d { margin-top: 0.35rem; color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }

  /* Como funciona */
  .step-grid { margin-top: var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 640px) { .step-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .step-grid { grid-template-columns: repeat(4, 1fr); } }
  .step { background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); border-top: 2px solid var(--color-accent); padding: var(--space-6); }
  .step-n { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: 2rem; color: var(--color-green); line-height: 1; }
  .step-t { margin-top: var(--space-3); font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-ink); line-height: var(--leading-snug); }
  .step-d { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }

  /* Forma de atuação */
  .dif-grid { margin-top: var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 700px) { .dif-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .dif-grid { grid-template-columns: repeat(3, 1fr); } }
  .dif { display: flex; gap: var(--space-4); background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-5); }
  .dif-ic { flex: none; display: inline-flex; height: 2.75rem; width: 2.75rem; align-items: center; justify-content: center; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background: transparent; color: var(--color-accent); }
  .dif-t { font-family: var(--font-display); font-size: var(--text-md); color: var(--color-ink); line-height: var(--leading-snug); }
  .dif-d { margin-top: 0.35rem; color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); }

  /* Conteúdos */
  .cont-grid { margin-top: var(--space-6); display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 760px) { .cont-grid { grid-template-columns: repeat(3, 1fr); } }
  .cont { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-6); text-decoration: none; transition: border-color var(--dur) var(--ease); }
  .cont::after { content: ''; position: absolute; inset: -1px -1px auto -1px; height: 2px; background: var(--color-accent); opacity: 0; transition: opacity var(--dur) var(--ease); }
  .cont:hover { border-color: var(--border-strong); }
  .cont:hover::after { opacity: 1; }
  .cont-tag { align-self: flex-start; font-family: var(--font-ui); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--color-accent); background: transparent; border: 1px solid var(--border-accent); padding: 0.25rem 0.55rem; border-radius: var(--radius-sm); }
  .cont-t { margin-top: var(--space-3); font-family: var(--font-display); font-size: var(--text-md); color: var(--color-ink); line-height: var(--leading-snug); }
  .cont-d { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-normal); flex: 1; }
  .cont-more { margin-top: var(--space-4); display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-green-strong); font-weight: var(--weight-semibold); font-size: var(--text-sm); }
  .viewall { margin-top: var(--space-5); display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; color: var(--color-navy); font-weight: var(--weight-semibold); font-size: var(--text-sm); text-decoration: none; }
  .viewall:hover { color: var(--color-accent); }

  /* FAQ — duas colunas */
  .hs--faq { position: relative; background: var(--surface-cream); }
  .faq-split { position: relative; display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
  @media (min-width: 900px) { .faq-split { grid-template-columns: 35% 1fr; gap: var(--space-10); align-items: start; } }
  .faq-cta { margin-top: var(--space-6); background: var(--surface); border: 1px solid var(--color-border); border-left: 2px solid var(--color-accent); border-radius: 0; padding: var(--space-5); }
  .faq-cta-t { font-family: var(--font-display); font-weight: var(--weight-bold); color: var(--color-ink); font-size: var(--text-md); }
