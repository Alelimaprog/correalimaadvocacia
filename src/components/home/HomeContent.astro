---
/**
 * HomeContent — corpo da home.
 *
 * Arquitetura: posicionamento → frentes de atuação → atuação empresarial →
 * comércio exterior e aduaneiro → atuação internacional → como o escritório
 * trabalha → perfis atendidos → conteúdos → perguntas.
 *
 * Linguagem visual: grade de filetes, sem cartão flutuante, sem ícone em
 * quadradinho colorido, sem pílula. O que separa um item do outro é um fio de
 * 1px — a mesma régua do cabeçalho e do rodapé.
 *
 * Nenhum dado foi inventado: números, prêmios, rankings e depoimentos não
 * existem aqui porque não existem no material do escritório.
 */
import { getNucleo } from '@/lib/nucleos';
import { bandas } from '@/lib/frentes';
import { site } from '@/lib/site.config';
import { homeFaq as faq } from '@/lib/home-faq';

const N = (s: string) => getNucleo(s)!.href;

/* Frentes empresariais — todas sustentadas por páginas já existentes. */
const empresarial = [
  {
    t: 'Contratos e estruturação de negócios',
    d: 'Redação, revisão e negociação de contratos empresariais; definição de responsabilidades, garantias e hipóteses de encerramento antes do conflito aparecer.',
    href: '/areas-de-atuacao/contratos-empresariais/',
  },
  {
    t: 'Contencioso empresarial estratégico',
    d: 'Condução de litígios relevantes para a operação, com avaliação de custo, prazo e efeito prático antes da escolha da medida.',
    href: '/areas-de-atuacao/contencioso-empresarial-estrategico/',
  },
  {
    t: 'Crédito, cobrança e execução',
    d: 'Recuperação de valores devidos à empresa: cobrança, execução de títulos, localização de patrimônio e habilitação em recuperação judicial e falência.',
    href: N('recuperacao-de-credito'),
  },
  {
    t: 'Trabalhista do lado do empregador',
    d: 'Consultivo preventivo, revisão de práticas e rotinas, gestão de passivo e defesa da empresa em reclamações trabalhistas.',
    href: '/areas-de-atuacao/trabalhista-empresarial/',
  },
  {
    t: 'Recuperação judicial e falência',
    d: 'Posição do credor diante da crise da empresa devedora: habilitação, impugnação de crédito e acompanhamento do processo.',
    href: '/areas-de-atuacao/recuperacao-judicial-e-falencia/',
  },
  {
    t: 'Criminal empresarial',
    d: 'Defesa de sócios, administradores e da pessoa jurídica em investigações e procedimentos com repercussão na atividade empresarial.',
    href: '/areas-de-atuacao/criminal-empresarial/',
  },
];

/* Comércio exterior e regime aduaneiro. */
const comex = [
  {
    t: 'Mercadoria retida na importação',
    d: 'Atuação em retenção, exigência fiscal, multa e pena de perdimento, no procedimento administrativo e, quando necessário, em juízo.',
    href: '/areas-de-atuacao/direito-aduaneiro-tributario/retencao-de-mercadorias/',
  },
  {
    t: 'Classificação fiscal e tributação na importação',
    d: 'Discussão de NCM, base de cálculo e exigências tributárias incidentes sobre a operação de importação.',
    href: '/areas-de-atuacao/direito-aduaneiro-tributario/classificacao-fiscal-ncm/',
  },
  {
    t: 'Contratos de importação e comércio exterior',
    d: 'Contratos internacionais de compra e venda, transporte e distribuição, com atenção a incoterms, responsabilidades e solução de controvérsias.',
    href: '/areas-de-atuacao/contratos-de-importacao-comercio-exterior/',
  },
  {
    t: 'Assessoria recorrente ao importador',
    d: 'Acompanhamento jurídico contínuo da operação de comércio exterior, do planejamento da importação à resposta a fiscalizações.',
    href: '/areas-de-atuacao/assessoria-juridica-para-importadores/',
  },
];

const steps = [
  { n: '01', t: 'Entendimento da operação', d: 'A conversa inicial trata do negócio, do objetivo e dos fatos relevantes — não de uma resposta pronta.' },
  { n: '02', t: 'Exame de documentos e riscos', d: 'Contratos, registros e documentos disponíveis são examinados para identificar o que sustenta e o que fragiliza a posição.' },
  { n: '03', t: 'Definição das medidas', d: 'Alternativas apresentadas com custo, prazo e efeito prático: negociação, via administrativa ou judicial.' },
  { n: '04', t: 'Condução e acompanhamento', d: 'Contratada a atuação, o escritório conduz as medidas e informa os acontecimentos relevantes ao longo do caso.' },
];

const perfis = [
  { t: 'Empresas e grupos empresariais', d: 'Contratos, contencioso, crédito a receber, relações de trabalho e questões regulatórias da atividade.' },
  { t: 'Importadores e exportadores', d: 'Retenção de mercadorias, autuações, classificação fiscal, tributação na importação e contratos internacionais.' },
  { t: 'Sócios e administradores', d: 'Conflitos societários, responsabilidade pessoal e defesa em procedimentos com reflexo na empresa.' },
  { t: 'Credores em recuperação e falência', d: 'Habilitação e impugnação de crédito, acompanhamento do processo e medidas de recuperação do valor.' },
  { t: 'Condomínios e administradoras', d: 'Recuperação de cotas, acordos e controle jurídico da inadimplência.' },
  { t: 'Operações com conexão internacional', d: 'Decisões estrangeiras a reconhecer no Brasil, documentos, patrimônio e sucessão entre países.' },
];

const conteudos = [
  { tag: 'Guia', t: 'Cobrança, execução e recuperação de crédito empresarial', d: 'Documentos necessários e medidas disponíveis para buscar a recuperação do crédito.', href: '/guias/cobranca-execucao-e-recuperacao-de-credito-empresarial/' },
  { tag: 'Guia', t: 'Homologação de sentença estrangeira no Brasil', d: 'Quando uma decisão estrangeira precisa ser homologada e como o procedimento corre.', href: '/guias/homologacao-de-sentenca-estrangeira-no-brasil/' },
  { tag: 'Guia', t: 'Recuperação judicial, falência e medidas do credor', d: 'Cuidados do credor diante da crise da empresa devedora.', href: '/guias/recuperacao-judicial-falencia-e-medidas-do-credor/' },
];
---

{/* ── Posicionamento ──────────────────────────────────────────────────── */}
<section class="sec sec--posicionamento" aria-labelledby="posicionamento">
  <div class="sec-wrap posicionamento-grid">
    <p class="eyebrow">O escritório</p>
    <div class="posicionamento-corpo">
      <h2 class="declaracao" id="posicionamento">
        Atuação jurídica voltada à operação da empresa — do contrato que a sustenta
        ao litígio que a ameaça.
      </h2>
      <p class="lead">
        O escritório atende empresas, importadores, sócios e credores em demandas que
        envolvem patrimônio, crédito, comércio exterior, relações de trabalho e
        contencioso estratégico. A atuação é conduzida por {site.attorney.name},
        {site.attorney.oab}, com atendimento nacional e online e casos que envolvem
        o Brasil e o exterior.
      </p>
      <a class="link-arrow" href="/o-escritorio/">Conhecer o escritório <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>

{/* ── Frentes de atuação ──────────────────────────────────────────────── */}
<section class="sec sec--areas" aria-labelledby="areas">
  <div class="sec-wrap">
    <header class="sec-head">
      <p class="eyebrow">Áreas de atuação</p>
      <h2 class="sec-h2" id="areas">Em que o escritório atua</h2>
      <p class="sec-intro">
        A atuação se organiza em frentes, cada uma com página própria, onde constam as
        situações tratadas, os documentos que costumam ser analisados e as medidas cabíveis.
      </p>
    </header>

    <ul class="grade grade--3">
      {bandas.map((b) => (
        <li class="grade-item">
          <a class="area" href={b.href}>
            <h3 class="area-t">{b.label}</h3>
            <p class="area-d">{b.short}</p>
            <span class="area-mais">Conhecer esta frente <span aria-hidden="true">&rarr;</span></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="sec-rodape">
      <a class="link-arrow" href="/areas-de-atuacao/">Ver todas as áreas de atuação <span aria-hidden="true">&rarr;</span></a>
    </p>
  </div>
</section>

{/* ── Atuação empresarial ─────────────────────────────────────────────── */}
<section class="sec sec--escuro" aria-labelledby="empresarial">
  <div class="sec-wrap">
    <header class="sec-head">
      <p class="eyebrow eyebrow--claro">Direito empresarial</p>
      <h2 class="sec-h2" id="empresarial">O que a empresa costuma precisar</h2>
      <p class="sec-intro sec-intro--claro">
        Da assessoria preventiva ao litígio, as frentes que sustentam a operação do dia a dia.
      </p>
    </header>

    <ul class="grade grade--2 grade--escura">
      {empresarial.map((e) => (
        <li class="grade-item">
          <a class="area area--claro" href={e.href}>
            <h3 class="area-t">{e.t}</h3>
            <p class="area-d">{e.d}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ── Comércio exterior e aduaneiro ───────────────────────────────────── */}
<section class="sec" aria-labelledby="comex">
  <div class="sec-wrap">
    <header class="sec-head">
      <p class="eyebrow">Comércio exterior</p>
      <h2 class="sec-h2" id="comex">Operações de importação e regime aduaneiro</h2>
      <p class="sec-intro">
        A mercadoria parada tem custo por dia. Esta frente trata do procedimento
        administrativo, da discussão tributária e dos contratos que organizam a operação.
      </p>
    </header>

    <ul class="grade grade--2">
      {comex.map((c) => (
        <li class="grade-item">
          <a class="area" href={c.href}>
            <h3 class="area-t">{c.t}</h3>
            <p class="area-d">{c.d}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ── Como o escritório atua ──────────────────────────────────────────── */}
<section class="sec sec--processo" aria-labelledby="processo">
  <div class="sec-wrap">
    <header class="sec-head">
      <p class="eyebrow">Como atuamos</p>
      <h2 class="sec-h2" id="processo">Do primeiro contato à definição da estratégia</h2>
    </header>

    <ol class="passos">
      {steps.map((s) => (
        <li class="passo">
          <span class="passo-n">{s.n}</span>
          <h3 class="passo-t">{s.t}</h3>
          <p class="passo-d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ── Perfis atendidos ────────────────────────────────────────────────── */}
<section class="sec" aria-labelledby="perfis">
  <div class="sec-wrap">
    <header class="sec-head">
      <p class="eyebrow">Para quem atuamos</p>
      <h2 class="sec-h2" id="perfis">Perfis atendidos</h2>
    </header>

    <ul class="perfis">
      {perfis.map((p) => (
        <li class="perfil">
          <h3 class="perfil-t">{p.t}</h3>
          <p class="perfil-d">{p.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ── Conteúdos ───────────────────────────────────────────────────────── */}
<section class="sec" aria-labelledby="conteudos">
  <div class="sec-wrap">
    <header class="sec-head sec-head--linha">
      <div>
        <p class="eyebrow">Conteúdos</p>
        <h2 class="sec-h2" id="conteudos">Material para entender o seu caso</h2>
      </div>
      <a class="link-arrow" href="/guias/">Ver todos os guias <span aria-hidden="true">&rarr;</span></a>
    </header>

    <ul class="grade grade--3">
      {conteudos.map((c) => (
        <li class="grade-item">
          <a class="area" href={c.href}>
            <p class="area-tag">{c.tag}</p>
            <h3 class="area-t">{c.t}</h3>
            <p class="area-d">{c.d}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ── Perguntas ───────────────────────────────────────────────────────── */}
<section class="sec sec--faq" aria-labelledby="faq">
  <div class="sec-wrap perg-grid">
    <header class="sec-head">
      <p class="eyebrow">Antes de entrar em contato</p>
      <h2 class="sec-h2" id="faq">Perguntas frequentes</h2>
    </header>
    <div class="perg-lista">
      {faq.map((f) => (
        <details class="perg-item">
          <summary class="perg-q">{f.q}</summary>
          <div class="perg-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Casca das seções ───────────────────────────────────────────────── */
  .sec { padding-block: var(--section-y); }
  .sec-wrap {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }
  .sec--escuro {
    background: var(--color-navy);
    color: var(--color-text-on-dark);
  }
  .sec--processo, .sec--faq { background: var(--surface-warm); }

  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .eyebrow--claro { color: var(--color-accent-soft); }

  .sec-head { margin-bottom: var(--space-12); max-width: 44rem; }
  .sec-head--linha {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
    max-width: none;
  }
  .sec-h2 {
    margin-top: var(--space-4);
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
    letter-spacing: -0.02em;
  }
  .sec--escuro .sec-h2 { color: var(--color-text-on-dark); }
  .sec-intro {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .sec-intro--claro { color: var(--color-text-on-dark-muted); }

  /* ── Posicionamento: rótulo na coluna estreita, discurso na larga ───── */
  .posicionamento-grid { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) {
    .posicionamento-grid { grid-template-columns: 14rem 1fr; gap: var(--space-16); }
  }
  .declaracao {
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .lead {
    margin-top: var(--space-6);
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .posicionamento-corpo .link-arrow { margin-top: var(--space-6); }

  .sec-rodape { margin-top: var(--space-8); }

  /* ── Grade de filetes ───────────────────────────────────────────────
     Os itens não flutuam: dividem um fio. A grade ganha o fio por fora
     com um contorno, e cada célula o repete por dentro com o gap. */
  .grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .grade--escura { background: var(--border-on-dark); border-color: var(--border-on-dark); }
  .grade-item { display: flex; }
  @media (min-width: 640px) { .grade--2, .grade--3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .grade--3 { grid-template-columns: repeat(3, 1fr); } }

  .area {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-8);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur) var(--ease);
  }
  .area:hover { background: var(--surface-warm); }
  .area--claro { background: var(--color-navy); }
  .area--claro:hover { background: var(--surface-strong-alt); }

  .area-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .area-t {
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .area--claro .area-t { color: var(--color-text-on-dark); }
  .area-d {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .area--claro .area-d { color: var(--color-text-on-dark-muted); }
  .area-mais {
    margin-top: auto;
    padding-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }
  .area:hover .area-mais { color: var(--color-accent); }

  /* ── Passos ─────────────────────────────────────────────────────────── */
  .passos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-10);
  }
  @media (min-width: 760px) { .passos { grid-template-columns: repeat(2, 1fr); gap: var(--space-12) var(--space-16); } }
  @media (min-width: 1100px) { .passos { grid-template-columns: repeat(4, 1fr); } }

  .passo { border-top: 1px solid var(--color-border); padding-top: var(--space-5); }
  .passo-n {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-accent);
  }
  .passo-t {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
  }
  .passo-d {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  /* ── Perfis ─────────────────────────────────────────────────────────── */
  .perfis { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  @media (min-width: 760px) { .perfis { grid-template-columns: repeat(2, 1fr); column-gap: var(--space-16); } }
  .perfil { border-top: 1px solid var(--color-border); padding-block: var(--space-6); }
  .perfil-t { font-size: var(--text-lg); font-weight: var(--weight-regular); }
  .perfil-d {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  /* ── FAQ ────────────────────────────────────────────────────────────── */
  .perg-grid { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) { .perg-grid { grid-template-columns: 22rem 1fr; gap: var(--space-16); } }
  .perg-grid .sec-head { margin-bottom: 0; }
  .perg-item { border-top: 1px solid var(--color-border); }
  .perg-item:last-child { border-bottom: 1px solid var(--color-border); }
  .perg-q {
    list-style: none;
    cursor: pointer;
    padding-block: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-ink);
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: baseline;
  }
  .perg-q::-webkit-details-marker { display: none; }
  .perg-q::after {
    content: '+';
    font-family: var(--font-body);
    color: var(--color-accent);
    flex: none;
  }
  .perg-item[open] .perg-q::after { content: '–'; }
  .perg-a {
    padding-bottom: var(--space-6);
    max-width: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
</style>
