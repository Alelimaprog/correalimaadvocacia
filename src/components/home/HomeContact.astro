---
/**
 * HomeContact — home. Rodada 4 (13/11/2026): reconstruída a partir do site publicado.
 */
import Icon from '@/components/Icon.astro';
import ContactForm from '@/components/ContactForm.astro';
import { whatsappHrefForPath } from '@/lib/site.config';
const waHref = whatsappHrefForPath('/');
---

<section id="contato" class="home-contact"><div class="hcx-wrap"><div class="hcx-card" data-reveal><!-- Painel de informações (mint) --><div class="hcx-info"><p class="hcx-eyebrow"><span class="hcx-eyebrow-rule"></span>Contato</p><h2 class="hcx-title">Apresente a situação ao escritório</h2><p class="hcx-lead">Informe os dados principais da situação. O envio do formulário não representa contratação e as informações são analisadas para o direcionamento inicial do atendimento.</p><ul class="hcx-channels"><li><span class="hcx-ic"><Icon name="mail" size={20} /></span><a href="mailto:contato@correalimaadvocacia.com.br">contato@correalimaadvocacia.com.br</a></li><li><span class="hcx-ic"><Icon name="whatsapp" size={20} /></span><a href={waHref} target="_blank" rel="noopener noreferrer">+55 11 97502-5611 · WhatsApp</a></li><li><span class="hcx-ic"><Icon name="file" size={20} /></span><span>Alexandre Corrêa Lima — OAB/SP 234511</span></li><li><span class="hcx-ic"><Icon name="map-pin" size={20} /></span><span>R. Verbo Divino, 2001 — Bloco B – Conjunto 902<br>Chácara Santo Antônio · São Paulo – SP · CEP 04719-002</span></li></ul><ul class="hcx-trust"><li>Atendimento nacional e online</li><li>Dados tratados conforme a Política de Privacidade</li><li>Não envie documentos confidenciais antes de orientação</li></ul></div><!-- Painel do formulário (branco) --><div class="hcx-form-panel"><ContactForm /></div></div></div></section>

<style>
  .home-contact{background:var(--surface);padding-block:var(--section-y-lg)}
  .hcx-wrap{width:100%;max-width:var(--container-max);padding-inline:var(--container-pad);margin-inline:auto}
  .hcx-card{border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--surface);grid-template-columns:minmax(0,1fr);display:grid;overflow:hidden}
  @media (width>=900px){.hcx-card{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}}
  .hcx-info{background:var(--surface-cream);border-bottom:1px solid var(--color-border);min-width:0;padding:var(--space-6) var(--space-5)}
  @media (width>=560px){.hcx-info{padding:var(--space-8)}}
  @media (width>=900px){.hcx-info{border-bottom:0;border-right:1px solid var(--color-border);padding:var(--space-12)}}
  .hcx-eyebrow{font-family:var(--font-body);font-size:var(--text-xs);text-transform:uppercase;letter-spacing:var(--tracking-eyebrow);color:var(--color-accent);font-weight:var(--weight-semibold);align-items:center;gap:.5rem;display:inline-flex}
  .hcx-eyebrow-rule{background:currentColor;width:24px;height:1px}
  .hcx-title{margin-top:var(--space-4);font-family:var(--font-display);font-size:var(--text-3xl);font-weight:var(--weight-semibold);letter-spacing:var(--tracking-tight);color:var(--color-ink);text-wrap:balance;max-width:14ch;line-height:1.1}
  .hcx-lead{margin-top:var(--space-5);max-width:30ch;font-size:var(--text-sm);line-height:var(--leading-normal);color:var(--color-text-muted)}
  .hcx-channels{margin:var(--space-10) 0 0;gap:var(--space-5);flex-direction:column;padding:0;list-style:none;display:flex}
  .hcx-channels li{align-items:flex-start;gap:var(--space-4);font-size:var(--text-sm);line-height:var(--leading-normal);color:var(--color-text-muted);display:flex}
  .hcx-channels li:not(:first-child){align-items:center}
  .hcx-ic{border-radius:var(--radius-sm);border:1px solid var(--color-border);background:var(--surface);width:2.5rem;height:2.5rem;color:var(--color-accent);flex:none;justify-content:center;align-items:center;display:inline-flex}
  .hcx-channels a{color:var(--color-text-muted);overflow-wrap:anywhere;transition:color var(--dur) var(--ease);padding-block:.15rem;text-decoration:none;display:inline-block}
  .hcx-channels a:hover{color:var(--color-navy)}
  .hcx-form-panel{padding:var(--space-8);flex-direction:column;justify-content:center;display:flex}
  @media (width>=900px){.hcx-form-panel{padding:var(--space-12)}}
  .hcx-form{gap:var(--space-5);grid-template-columns:1fr;display:grid}
  @media (width>=560px){.hcx-form{grid-template-columns:1fr 1fr}}
  .hcx-col-2{grid-column:1/-1}
  .hcx-hp{opacity:0;width:1px;height:1px;position:absolute;left:-9999px}
  .hcx-field{flex-direction:column;display:flex}
  .hcx-field label{font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--color-ink);margin-bottom:.375rem}
  .hcx-field input,.hcx-field select,.hcx-field textarea{width:100%;font-family:var(--font-body);font-size:var(--text-base);color:var(--color-ink);border:1px solid var(--border-strong);border-radius:var(--radius-sm);background:var(--surface);transition:border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);outline:none;padding:.75rem 1rem}
  .hcx-field textarea{resize:none;min-height:8.5rem}
  .hcx-field input::placeholder,.hcx-field textarea::placeholder{color:var(--color-text-subtle);opacity:.7}
  .hcx-field input:focus,.hcx-field select:focus,.hcx-field textarea:focus{border-color:var(--color-accent);box-shadow:var(--ring)}
  .hcx-select{position:relative}
  .hcx-select select{appearance:none;padding-right:2.75rem}
  .hcx-select:after{content:"";border-right:2px solid var(--color-text-subtle);border-bottom:2px solid var(--color-text-subtle);pointer-events:none;width:9px;height:9px;margin-top:-3px;position:absolute;top:50%;right:1.15rem;transform:rotate(45deg)}
  .hcx-actions{flex-direction:column;display:flex}
  .hcx-submit{justify-content:center;align-self:stretch;align-items:center;gap:var(--space-2);background:var(--color-navy);color:#fff;border-radius:var(--radius-sm);min-height:3.5rem;font-family:var(--font-ui);font-size:var(--text-base);font-weight:var(--weight-semibold);cursor:pointer;transition:background-color var(--dur) var(--ease);border:1px solid #0000;padding:1rem 2.25rem;display:inline-flex}
  @media (width>=560px){.hcx-submit{align-self:flex-start}}
  .hcx-submit:hover{background:var(--color-green-hover)}
  .hcx-submit:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}
  .hcx-submit:disabled{opacity:.5;cursor:default}
  .hcx-submit-arrow{transition:transform var(--dur) var(--ease);display:inline-flex}
  .hcx-submit:hover .hcx-submit-arrow{transform:translate(3px)}
  .hcx-note{margin-top:var(--space-4);font-size:var(--text-xs);line-height:var(--leading-relaxed);color:var(--color-text-muted)}
  .hcx-success{text-align:center;flex-direction:column;justify-content:center;align-items:center;min-height:12rem;display:flex}
  .hcx-success[hidden]{display:none}
  .hcx-error{margin-top:var(--space-3);font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--color-danger)}
  .hcx-error:empty{display:none}
  .hcx-req{color:var(--color-accent)}
  .hcx-opt{color:var(--color-text-subtle);font-weight:var(--weight-regular);font-size:var(--text-xs)}
  .hcx-hint{color:var(--color-text-muted);font-size:var(--text-xs);line-height:var(--leading-normal);margin-top:-.35rem}
  .hcx-trust{margin:var(--space-8) 0 0;flex-direction:column;gap:.4rem;padding:0;list-style:none;display:flex}
  .hcx-trust li{color:var(--color-text-muted);font-size:var(--text-xs);line-height:var(--leading-normal);padding-left:1.1rem;position:relative}
  .hcx-trust li:before{content:"";background:var(--color-accent);width:8px;height:1px;position:absolute;top:.62em;left:0}
  .hcx-success-ic{border-radius:var(--radius-sm);border:1px solid var(--border-accent);background:var(--surface-cream);width:4rem;height:4rem;color:var(--color-accent);justify-content:center;align-items:center;display:inline-flex}
  .hcx-success h3{margin-top:var(--space-6);font-family:var(--font-display);font-size:var(--text-2xl);font-weight:var(--weight-semibold);color:var(--color-ink)}
  .hcx-success p{margin-top:var(--space-3);max-width:26rem;font-size:var(--text-sm);line-height:var(--leading-normal);color:var(--color-text-muted)}
</style>
