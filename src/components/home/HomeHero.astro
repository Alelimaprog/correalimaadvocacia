---
/**
 * HomeHero — primeira tela da home.
 *
 * Campo navy de borda a borda, declaração tipográfica em serif e uma régua de
 * credenciais no pé. Sem textura, sem borrão, sem fotografia: o único material
 * fotográfico do projeto é o retrato do advogado, que tem função própria mais
 * adiante na página — usá-lo aqui o gastaria como decoração.
 *
 * O cabeçalho é transparente e fica por cima: o campo começa na borda de cima
 * da janela e o padding devolve o espaço dele.
 */
import { site } from '@/lib/site.config';
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero-wrap">
    <p class="hero-eyebrow">Advocacia empresarial · São Paulo</p>

    <h1 class="hero-h1" id="hero-titulo">
      Advocacia empresarial para operações complexas, no Brasil e no exterior.
    </h1>

    <p class="hero-lead">
      Contratos e estruturação de negócios, contencioso estratégico, comércio exterior
      e regime aduaneiro, recuperação de crédito e relações de trabalho pelo lado do
      empregador — com análise do caso concreto antes de qualquer recomendação.
    </p>

    <div class="hero-acoes">
      <a class="btn btn--on-green btn--lg" href="/contato/">Fale com nossa equipe</a>
      <a class="btn btn--on-dark btn--lg" href="/areas-de-atuacao/">Conheça nossa atuação</a>
    </div>
  </div>

  <div class="hero-regua">
    <div class="hero-regua-wrap">
      <span>{site.attorney.name} · {site.attorney.oab}</span>
      <span>Atendimento nacional e online</span>
      <span>Demandas no Brasil e no exterior</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--altura-cabecalho));
    padding-top: var(--altura-cabecalho);
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--color-navy);
    color: var(--color-text-on-dark);
  }

  .hero-wrap {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--section-y) var(--container-pad) var(--section-y-sm);
    align-self: center;
  }

  .hero-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-soft);
    margin-bottom: var(--space-8);
  }

  .hero-h1 {
    font-size: var(--text-6xl);
    font-weight: var(--weight-regular);
    line-height: 1.02;
    letter-spacing: -0.022em;
    color: var(--color-text-on-dark);
    max-width: 19ch;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: var(--space-8);
    max-width: 58ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-on-dark-muted);
  }

  .hero-acoes {
    margin-top: var(--space-10);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Régua de credenciais: encerra a primeira tela sem virar um segundo bloco.
     Mesma escala do rodapé, separada por um filete. */
  .hero-regua {
    border-top: 1px solid var(--border-on-dark);
  }

  .hero-regua-wrap {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-5) var(--container-pad);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-10);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-on-dark-muted);
  }

  @media (max-width: 767px) {
    .hero-h1 { max-width: none; }
    .hero-acoes .btn { width: 100%; }
    .hero-regua-wrap { gap: var(--space-2); flex-direction: column; }
  }
</style>
