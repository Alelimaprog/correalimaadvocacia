---
/**
 * HomeHero — capa institucional.
 *
 * O que mudou, e por quê:
 *
 * POSICIONAMENTO. O h1 anterior abria com "Proteção patrimonial" e a linha de
 * apoio listava condomínios e sucessões antes de qualquer coisa empresarial.
 * Um diretor jurídico, um importador ou um operador logístico lia aquilo e
 * concluía, em dois segundos, que não era para ele. O h1 agora nomeia o cliente
 * (empresas) e o terreno (contratos, comércio exterior, contencioso) na primeira
 * linha.
 *
 * FUNDO. Saíram o dot-grid verde e os dois "blobs" desfocados. Gradiente borrado
 * é vocabulário de landing page de SaaS; aqui o fundo é papel, e a profundidade
 * vem de uma faixa navy estreita à direita, atrás do retrato.
 *
 * RETRATO. Mantido — é a foto real do responsável, e um rosto comunica mais
 * solidez do que qualquer banco de imagens. O que mudou foi o enquadramento:
 * cantos retos, sem moldura pesada, e a placa de identificação sem vidro fosco.
 */
import { site } from '@/lib/site.config';
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-reveal><span class="dot"></span>Alexandre Corrêa Lima · OAB/SP 234511</p>

      <h1 class="hero-h1" data-reveal>
        Advogado em São Paulo para{' '}
        <em>mercadoria retida, inventário e decisões estrangeiras</em>
      </h1>

      <p class="hero-sub" data-reveal>
        Mercadoria retida e pena de perdimento na importação; inventário em cartório ou
        judicial, inclusive com herdeiros no exterior; homologação de sentenças e divórcios
        estrangeiros. Também contratos, crédito e defesa trabalhista de empresas.
      </p>

      <div class="hero-cta" data-reveal>
        <a class="btn btn--primary btn--lg" href="/contato/" data-cta-position="hero">Enviar meu caso</a>
        <a class="btn btn--secondary btn--lg" href="/areas-de-atuacao/">Conheça nossa atuação</a>
      </div>

      <dl class="hero-facts" data-reveal>
        <div>
          <dt>Atuação</dt>
          <dd>Consultiva e contenciosa</dd>
        </div>
        <div>
          <dt>Atendimento</dt>
          <dd>São Paulo · presencial e remoto</dd>
        </div>
        <div>
          <dt>Alcance</dt>
          <dd>Demandas no Brasil e no exterior</dd>
        </div>
      </dl>
    </div>

    <figure class="hero-figure" data-reveal>
      <img
        class="hero-portrait"
        src="/brand/alexandre-correa-lima.webp"
        width="760"
        height="1207"
        alt={`${site.attorney.name}, advogado responsável pelo escritório`}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="hero-id">
        <span class="hero-id-name">{site.attorney.name}</span>
        <span class="hero-id-oab">{site.attorney.oab}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Sem faixa de altura total: ela dependia da matemática das colunas e a
     legenda caía fora dela, virando texto branco sobre papel branco. A
     profundidade agora vem de um retângulo navy deslocado ATRÁS do retrato —
     recurso editorial que não depende de largura de coluna nenhuma. */

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-block: clamp(2.5rem, 1.8rem + 3vw, 5.5rem);
  }
  @media (min-width: 940px) {
    .hero-grid {
      grid-template-columns: 1.35fr 0.65fr;
      gap: clamp(2rem, 1rem + 4vw, 5rem);
      align-items: center;
    }
  }

  .hero-copy { display: flex; flex-direction: column; }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-top: var(--space-5);
    max-width: 24ch;
    text-wrap: balance;
  }
  /* O <em> não vira cor de destaque: vira recuo. A primeira oração fica em
     tinta cheia e a enumeração das matérias recua meio tom — é a mesma ideia de
     uma linha de apoio, mas dentro do próprio título. */
  .hero-h1 em {
    font-style: normal;
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .hero-sub {
    margin-top: var(--space-6);
    max-width: 56ch;
    color: var(--color-text);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }

  .hero-cta {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Os fatos substituem a antiga faixa de ícones genéricos. Três dados
     verificáveis, em lista de definição — não selos. */
  .hero-facts {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 620px) {
    .hero-facts { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  }
  .hero-facts dt {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-accent);
  }
  .hero-facts dd {
    margin: 0.4rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  /* ─── Retrato ─────────────────────────────────────────────────── */
  .hero-figure {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 19rem;
    margin-inline: auto;
  }
  /* A partir de 940px a figura encosta na margem direita do container: centrada
     na coluna, sobrava uma faixa morta entre ela e a borda da página. */
  @media (min-width: 940px) {
    .hero-figure { max-width: 21rem; margin-inline: auto 0; }
  }
  .hero-figure::before {
    content: '';
    position: absolute;
    inset: var(--space-8) calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) 0;
    background: var(--color-navy);
    z-index: 0;
  }
  @media (max-width: 939px) {
    .hero-figure::before { display: none; }
  }
  .hero-portrait {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: 314 / 420;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: var(--radius-sm);
    background: var(--surface-warm);
  }
  .hero-id {
    position: relative;
    z-index: 1;
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }
  .hero-id-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-display);
    color: var(--color-ink);
  }
  .hero-id-oab {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }
  /* Sobre o retângulo navy, a legenda inverte — e só a partir de 940px, que é
     onde o retângulo existe. */
  /* A legenda carrega o próprio fundo navy em vez de confiar que o retângulo
     desenhado por ::before esteja atrás dela. Sem isso, qualquer mudança de
     layout devolve o defeito de texto branco sobre papel branco — que já
     aconteceu uma vez nesta peça. */
  @media (min-width: 940px) {
    .hero-id {
      margin-top: 0;
      padding: var(--space-4) var(--space-5);
      background: var(--color-navy);
      border-left-color: var(--color-accent-soft);
    }
    .hero-id-name { color: #fff; }
    .hero-id-oab { color: var(--color-text-on-dark-muted); }
  }
</style>
