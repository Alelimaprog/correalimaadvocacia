---
/**
 * HomeHero — home. Rodada 4 (13/11/2026): reconstruída a partir do site publicado.
 */
import Icon from '@/components/Icon.astro';
import { whatsappHrefForPath } from '@/lib/site.config';
const waHref = whatsappHrefForPath('/');
---

<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span>Alexandre Corrêa Lima · OAB/SP 234511</p><h1 class="hero-h1">Advogado em São Paulo para <em>mercadoria retida, inventário e decisões estrangeiras</em></h1><p class="hero-sub">Mercadoria retida e pena de perdimento na importação; inventário em cartório ou judicial, inclusive com herdeiros no exterior; homologação de sentenças e divórcios estrangeiros.</p><div class="hero-cta"><a class="btn btn--primary btn--lg" href="#contato" data-cta-position="hero">Enviar meu caso</a><a class="btn btn--secondary btn--lg" href={waHref} target="_blank" rel="noopener noreferrer" data-cta-position="hero">Falar no WhatsApp</a></div><p class="hero-routes"><a href="/areas-de-atuacao/direito-aduaneiro-tributario/retencao-de-mercadorias/">Mercadoria retida</a><span aria-hidden="true">·</span><a href="/areas-de-atuacao/inventario-e-patrimonio/">Inventário em SP</a><span aria-hidden="true">·</span><a href="/areas-de-atuacao/homologacao-de-divorcio-estrangeiro/">Divórcio no exterior</a></p><dl class="hero-facts"><div><dt>Atuação</dt><dd>Consultiva e contenciosa</dd></div><div><dt>Atendimento</dt><dd>São Paulo · presencial e remoto</dd></div><div><dt>Alcance</dt><dd>Demandas no Brasil e no exterior</dd></div></dl></div><figure class="hero-figure"><img class="hero-portrait" src="/brand/alexandre-correa-lima-760.webp" srcset="/brand/alexandre-correa-lima-480.webp 480w, /brand/alexandre-correa-lima-760.webp 760w" sizes="(min-width: 940px) 336px, 304px" width="760" height="760" alt="Alexandre Corrêa Lima, advogado responsável pelo escritório" loading="eager" fetchpriority="auto" decoding="async"><figcaption class="hero-id"><span class="hero-id-name">Alexandre Corrêa Lima</span><span class="hero-id-oab">OAB/SP 234511</span></figcaption></figure></div></section>

<style>
  .hero-routes{margin-top:var(--space-4);font-size:var(--text-sm);color:var(--color-text-muted);flex-wrap:wrap;gap:.4rem .6rem;display:flex}
  .hero-routes a{color:var(--color-ink);text-underline-offset:2px;text-decoration:underline}
  .hero{background:var(--surface);border-bottom:1px solid var(--border-subtle);position:relative}
  .hero-grid{z-index:1;gap:var(--space-10);grid-template-columns:1fr;padding-block:clamp(2.5rem,1.8rem + 3vw,5.5rem);display:grid;position:relative}
  @media (width>=940px){.hero-grid{grid-template-columns:1.35fr .65fr;align-items:center;gap:clamp(2rem,1rem + 4vw,5rem)}}
  .hero-copy{flex-direction:column;display:flex}
  .hero-h1{font-family:var(--font-display);font-weight:var(--weight-display);font-size:var(--text-5xl);line-height:var(--leading-tight);letter-spacing:var(--tracking-tight);color:var(--color-ink);margin-top:var(--space-5);text-wrap:balance;max-width:24ch}
  .hero-h1 em{font-style:normal;font-weight:var(--weight-regular);color:var(--color-text-muted)}
  .hero-sub{margin-top:var(--space-6);max-width:56ch;color:var(--color-text);font-size:var(--text-md);line-height:var(--leading-relaxed)}
  .hero-cta{margin-top:var(--space-8);gap:var(--space-3);flex-wrap:wrap;display:flex}
  @media (width<=519.98px){.hero-cta{margin-top:var(--space-6);flex-direction:column}.hero-cta .btn{width:100%}}
  .hero-facts{margin-top:var(--space-10);padding-top:var(--space-6);border-top:1px solid var(--border-subtle);gap:var(--space-5);display:grid}
  @media (width>=620px){.hero-facts{gap:var(--space-6);grid-template-columns:repeat(3,1fr)}}
  .hero-facts dt{font-family:var(--font-ui);font-size:var(--text-xs);font-weight:var(--weight-semibold);text-transform:uppercase;letter-spacing:var(--tracking-eyebrow);color:var(--color-accent)}
  .hero-facts dd{font-size:var(--text-sm);color:var(--color-text-muted);line-height:var(--leading-normal);margin:.4rem 0 0}
  .hero-figure{margin:0;width:100%;max-width:19rem;margin-inline:auto;position:relative}
  @media (width>=940px){.hero-figure{max-width:21rem;margin-inline:auto 0}}
  .hero-figure:before{content:"";inset:var(--space-8) calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) 0;background:var(--color-navy);z-index:0;position:absolute}
  @media (width<=939px){.hero-figure:before{display:none}}
  .hero-portrait{z-index:1;aspect-ratio:314/420;object-fit:cover;object-position:50% 22%;border-radius:var(--radius-sm);background:var(--surface-warm);width:100%;display:block;position:relative}
  .hero-id{z-index:1;margin-top:var(--space-4);padding-left:var(--space-4);border-left:2px solid var(--color-accent);flex-direction:column;gap:.15rem;display:flex;position:relative}
  .hero-id-name{font-family:var(--font-display);font-size:var(--text-base);font-weight:var(--weight-display);color:var(--color-ink)}
  .hero-id-oab{font-family:var(--font-ui);font-size:var(--text-xs);letter-spacing:.06em;color:var(--color-text-subtle)}
  @media (width>=940px){.hero-id{padding:var(--space-4) var(--space-5);background:var(--color-navy);border-left-color:var(--color-accent-soft);margin-top:0}.hero-id-name{color:#fff}.hero-id-oab{color:var(--color-text-on-dark-muted)}}
  @media (width<=600px){.hero-h1{font-size:var(--text-3xl);margin-top:var(--space-3)}.hero-sub{margin-top:var(--space-4);font-size:var(--text-base)}.hero-sub-extra{display:none}}
</style>
