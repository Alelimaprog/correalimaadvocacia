---
/**
 * ContentCard — card editorial reutilizável (artigos e guias).
 * O card inteiro é clicável (o link do título cobre a área via ::after),
 * sem depender de sublinhado. Metadados opcionais (data, tempo de leitura).
 */
import Icon from '@/components/Icon.astro';

interface Props {
  href: string;
  title: string;
  tag?: string;
  desc?: string;
  date?: string; // já formatada
  minutes?: number;
  cluster?: string; // para filtro por categoria
  moreLabel?: string;
}
const { href, title, tag, desc, date, minutes, cluster, moreLabel = 'Ler' } = Astro.props;
---
<li class="cx-card" data-cluster={cluster}>
  {tag && (
    <div class="cx-card-top"><span class="cx-card-tag">{tag}</span></div>
  )}
  <h3 class="cx-card-title"><a href={href}>{title}</a></h3>
  {desc && <p class="cx-card-desc">{desc}</p>}
  <div class="cx-card-foot">
    {(date || minutes) && (
      <span class="cx-card-meta">
        {date && <span>{date}</span>}
        {date && minutes && <span class="sep"></span>}
        {minutes && <span>{minutes} min de leitura</span>}
      </span>
    )}
    <span class="cx-card-more">{moreLabel}<Icon name="arrow-right" size={15} /></span>
  </div>
</li>
