---
/**
 * FrentePage — página de frente de atuação fora do conjunto de núcleos.
 *
 * Usada pelas frentes que o escritório pediu para estruturar mas cujo escopo
 * factual ainda depende de confirmação (marítimo/portuário, imigração EUA).
 * A página existe, pode ser revista no ar, e sai com `noindex` e fora do
 * sitemap até que o conteúdo seja confirmado — ver PENDENCIAS-REDESIGN.md.
 *
 * Nada aqui afirma competência, habilitação ou licença que não conste do
 * material do escritório: o que se descreve é o escopo da matéria, e o bloco
 * `confirmar` lista abertamente o que falta definir.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { PageHead } from '@/lib/institucional';

export interface Bloco {
  t: string;
  d: string;
}

interface Props {
  eyebrow: string;
  h1: string;
  lead: string;
  head: PageHead;
  intro: string;
  escopo: Bloco[];
  perfis: string[];
  /** Pontos que dependem de confirmação do escritório antes da publicação. */
  confirmar: string[];
  crumbs: { label: string; href?: string }[];
}

const { eyebrow, h1, lead, head, intro, escopo, perfis, confirmar, crumbs } = Astro.props;
---

<BaseLayout head={head}>
  <main id="conteudo-principal" class="frente">
    <header class="frente-topo">
      <div class="frente-wrap">
        <Breadcrumb items={crumbs} />
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="frente-h1">{h1}</h1>
        <p class="frente-lead">{lead}</p>
        <div class="frente-acoes">
          <a class="btn btn--primary" href="/contato/">Fale com nossa equipe</a>
          <a class="btn btn--secondary" href="/areas-de-atuacao/">Ver todas as áreas</a>
        </div>
      </div>
    </header>

    <section class="frente-sec" aria-labelledby="escopo">
      <div class="frente-wrap frente-duas">
        <div>
          <p class="eyebrow">O que esta frente trata</p>
          <h2 class="frente-h2" id="escopo">Escopo da matéria</h2>
        </div>
        <div>
          <p class="frente-intro">{intro}</p>
          <ul class="frente-lista">
            {escopo.map((b) => (
              <li>
                <h3>{b.t}</h3>
                <p>{b.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="frente-sec frente-sec--claro" aria-labelledby="perfis">
      <div class="frente-wrap frente-duas">
        <div>
          <p class="eyebrow">Para quem</p>
          <h2 class="frente-h2" id="perfis">Perfis envolvidos</h2>
        </div>
        <ul class="frente-perfis">
          {perfis.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    {confirmar.length > 0 && (
      <section class="frente-sec" aria-labelledby="confirmar">
        <div class="frente-wrap">
          <div class="pendencia">
            <p class="pendencia-rotulo">Conteúdo em definição</p>
            <h2 class="pendencia-h2" id="confirmar">
              Esta página aguarda confirmação do escritório antes de ser publicada
            </h2>
            <p class="pendencia-d">
              A estrutura está pronta. O texto definitivo depende de informações que
              só o escritório pode confirmar — por isso a página está marcada como
              não indexável e fora do mapa do site.
            </p>
            <ul class="pendencia-lista">
              {confirmar.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .frente-wrap {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .frente-topo {
    padding-block: var(--section-y) var(--section-y-sm);
    background: var(--surface-warm);
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .frente-h1 {
    margin-top: var(--space-5);
    font-size: var(--text-5xl);
    font-weight: var(--weight-regular);
    letter-spacing: -0.022em;
    max-width: 18ch;
  }

  .frente-lead {
    margin-top: var(--space-6);
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .frente-acoes { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .frente-sec { padding-block: var(--section-y); }
  .frente-sec--claro { background: var(--surface-warm); }

  .frente-duas { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) { .frente-duas { grid-template-columns: 18rem 1fr; gap: var(--space-16); } }

  .frente-h2 {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
  }

  .frente-intro {
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .frente-lista { list-style: none; margin: var(--space-10) 0 0; padding: 0; }
  .frente-lista li { border-top: 1px solid var(--color-border); padding-block: var(--space-6); }
  .frente-lista h3 { font-size: var(--text-lg); font-weight: var(--weight-regular); }
  .frente-lista p {
    margin-top: var(--space-2);
    max-width: var(--measure);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .frente-perfis { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  @media (min-width: 700px) { .frente-perfis { grid-template-columns: repeat(2, 1fr); column-gap: var(--space-10); } }
  .frente-perfis li {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-4);
    font-size: var(--text-sm);
  }

  /* Bloco de pendência: deliberadamente visível enquanto a página não é
     publicada, para que a revisão aconteça olhando a própria página. */
  .pendencia {
    border: 1px solid var(--color-accent);
    padding: var(--space-10);
    max-width: 52rem;
  }
  .pendencia-rotulo {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .pendencia-h2 {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
  }
  .pendencia-d {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .pendencia-lista { margin: var(--space-6) 0 0; padding-left: 1.1rem; }
  .pendencia-lista li {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }
</style>
