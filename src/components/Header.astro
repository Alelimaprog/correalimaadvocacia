---
interface Props {
  heroEscuro?: boolean;
}
const { heroEscuro } = Astro.props;
/**
 * Header — cabeçalho flutuante em "pílula" (migração visual): fixo no topo,
 * fundo transparente até rolar; ao rolar, vira um cartão translúcido com
 * blur, borda e sombra suave, igual ao comportamento do modelo de
 * referência. Logo à esquerda, navegação central (desktop), CTA WhatsApp
 * (desktop) e menu hambúrguer (mobile). Toda a lógica de navegação/menu
 * permanece nos componentes Navigation/MobileMenu (inalterados).
 */
import Logo from '@/components/Logo.astro';
import Navigation from '@/components/Navigation.astro';
import MobileMenu from '@/components/MobileMenu.astro';
---

<header class:list={['site-header', heroEscuro && 'site-header--sobre-escuro']} data-header>
  <div class="header-shell">
    <div class="header-inner">
      <Logo variant={heroEscuro ? "light" : "dark"} />
      <Navigation />
      <div class="header-cta">
        <a class="btn btn--primary header-cta-link" href="/contato/">Fale com nossa equipe</a>
      </div>
      <MobileMenu />
    </div>
  </div>
</header>

<style>
  /* Cabeçalho institucional: uma faixa, não uma pílula flutuante. Encosta na
     largura da página e se separa do conteúdo por um filete — a mesma régua
     usada no resto do site. Ao rolar, ganha fundo sólido e a borda escurece;
     nada mais se move. */
  .site-header {
    color: var(--color-ink);
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    border-bottom: 1px solid transparent;
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .site-header.is-scrolled {
    background: var(--surface);
    border-bottom-color: var(--color-border);
  }

  .header-shell {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .header-inner {
    width: 100%;
    padding-inline: var(--container-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    height: var(--header-height);
  }

  .header-cta { display: none; }

  /* Sobre campo escuro o cabeçalho desaparece: sem fundo, sem filete, texto
     claro. Na primeira rolagem ele materializa — e aí volta ao tema claro. */
  .site-header--sobre-escuro:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: var(--color-text-on-dark);
  }

  .site-header--sobre-escuro:not(.is-scrolled) :global(.nav-link) {
    color: var(--color-text-on-dark-muted);
  }
  .site-header--sobre-escuro:not(.is-scrolled) :global(.nav-link:hover),
  .site-header--sobre-escuro:not(.is-scrolled) :global(.nav-link[aria-current='page']) {
    color: var(--color-text-on-dark);
  }
  .site-header--sobre-escuro:not(.is-scrolled) .header-cta-link {
    background: transparent;
    color: var(--color-text-on-dark);
    border-color: var(--border-on-dark);
  }
  .site-header--sobre-escuro:not(.is-scrolled) .header-cta-link:hover {
    background: rgba(247, 245, 241, 0.1);
    border-color: rgba(247, 245, 241, 0.5);
  }

  .header-cta-link {
    min-height: 2.5rem;
    padding: 0.55rem 1.25rem;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .header-cta { display: block; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 16);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
