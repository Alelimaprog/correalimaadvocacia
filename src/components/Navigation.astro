---
/**
 * Navigation — navegação principal do desktop (oculta abaixo de `lg`):
 * Início · O Escritório · Áreas de Atuação (mega-menu em colunas por banda) ·
 * Conteúdos (dropdown) · Contato. Consome src/lib/navigation.ts (DRY).
 *
 * O mega-menu abre em colunas — uma por banda de atuação, a empresarial
 * primeiro. É a estrutura que escritório empresarial usa porque é a que
 * funciona: quem procura contrato, contencioso ou aduaneiro vê a frente certa
 * sem precisar deduzi-la de um rótulo genérico.
 */
import { mainNav, areasMenu, conteudosMenu, contatoLink, isActive } from '@/lib/navigation';

const current = Astro.url.pathname;
---

<nav class="nav" aria-label="Navegação principal">
  {
    mainNav.map((link) => (
      <a class="nav-link" href={link.href} aria-current={isActive(current, link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }

  <div class="dropdown dropdown--mega" data-dropdown>
    <button class="nav-link dd-trigger" type="button" aria-expanded="false" aria-controls="areas-menu">
      {areasMenu.label}
      <svg class="caret" aria-hidden="true" width="10" height="6" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
    <div class="dd-panel dd-panel--mega" id="areas-menu">
      <div class="mega-cols">
        {
          areasMenu.bandas.map((b) => (
            <div class="mega-col">
              <a class="mega-col-title" href={b.href}>{b.label}</a>
              <ul class="mega-list">
                {b.items.map((i) => (
                  <li>
                    <a class="mega-link" href={i.href} aria-current={current === i.href ? 'page' : undefined}>
                      {i.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <a class="dd-viewall" href={areasMenu.viewAll.href}>{areasMenu.viewAll.label} &rarr;</a>
    </div>
  </div>

  <div class="dropdown" data-dropdown>
    <button class="nav-link dd-trigger" type="button" aria-expanded="false" aria-controls="conteudos-menu">
      {conteudosMenu.label}
      <svg class="caret" aria-hidden="true" width="10" height="6" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
    </button>
    <div class="dd-panel" id="conteudos-menu">
      {conteudosMenu.items.map((l) => <a class="dd-item" href={l.href}>{l.label}</a>)}
    </div>
  </div>

  <a class="nav-link" href={contatoLink.href} aria-current={isActive(current, contatoLink.href) ? 'page' : undefined}>
    {contatoLink.label}
  </a>
</nav>

<style>
  /* Navegação tipográfica: sem pílulas, sem fundo. O estado ativo e o hover
     se marcam por um filete sob a palavra — a mesma régua do resto do site. */
  .nav { display: none; align-items: center; gap: var(--space-5); }
  @media (min-width: 1024px) { .nav { display: flex; } }
  @media (min-width: 1200px) { .nav { gap: var(--space-6); } }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.005em;
    color: var(--color-text);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav-link:hover { color: var(--color-ink); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link[aria-current='page'] { color: var(--color-ink); }
  .nav-link[aria-current='page']::after { transform: scaleX(1); background: var(--color-accent); }

  .dropdown { position: relative; }
  .caret { transition: transform var(--dur) var(--ease); }
  .dropdown.is-open .caret { transform: rotate(180deg); }

  .dd-panel {
    position: absolute;
    top: calc(100% + 1.15rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 16rem;
    display: none;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    z-index: 60;
  }

  .dd-panel--mega {
    min-width: 54rem;
    max-width: min(66rem, calc(100vw - 2 * var(--container-pad)));
    padding: var(--space-6);
  }
  /* O painel largo não cabe ancorado no gatilho: em 1440 a terceira coluna
     saía pela direita da tela. Ele passa a ser posicionado pela viewport,
     alinhado à mesma coluna do conteúdo do site, logo abaixo do cabeçalho. */
  @media (min-width: 1024px) {
    .dropdown--mega .dd-panel--mega {
      position: fixed;
      top: var(--altura-cabecalho);
      left: 50%;
      transform: translateX(-50%);
      width: min(var(--container-max), calc(100vw - 2 * var(--container-pad)));
      max-width: none;
      max-height: calc(100vh - var(--altura-cabecalho) - var(--space-6));
      overflow-y: auto;
    }
  }
  .dropdown.is-open .dd-panel,
  .dropdown:hover .dd-panel,
  .dropdown:focus-within .dd-panel { display: flex; }
  .dropdown::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 1.15rem; }
  /* Com o painel ancorado na viewport, a ponte de hover precisa alcançar a
     borda do cabeçalho, não apenas 1.15rem abaixo do gatilho. */
  @media (min-width: 1024px) {
    .dropdown--mega::after { height: calc(var(--altura-cabecalho) / 2); }
  }

  .dd-item {
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .dd-item:hover { background: var(--surface-warm); color: var(--color-ink); }

  /* Colunas por banda. Os filetes verticais separam os grupos; nada flutua. */
  .mega-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--space-8);
    row-gap: var(--space-8);
  }
  @media (min-width: 1200px) {
    .mega-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .mega-col-title {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-subtle);
    text-decoration: none;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .mega-col-title:hover { color: var(--color-ink); border-color: var(--border-strong); }

  .mega-list { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-direction: column; }
  .mega-link {
    display: block;
    padding: 0.42rem 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .mega-link:hover { color: var(--color-accent); }
  .mega-link[aria-current='page'] { color: var(--color-ink); font-weight: var(--weight-medium); }

  .dd-viewall {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
  }
  .dd-viewall:hover { color: var(--color-accent); }
</style>

<script>
  document.querySelectorAll('[data-dropdown]').forEach((dd) => {
    const trigger = dd.querySelector('.dd-trigger') as HTMLButtonElement | null;
    if (!trigger) return;
    const close = () => {
      dd.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };
    const toggle = () => {
      const open = dd.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      toggle();
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) close();
    });
    dd.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        close();
        trigger.focus();
      }
    });
  });
</script>
