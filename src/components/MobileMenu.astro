---
/**
 * MobileMenu — botão hambúrguer (abaixo de `lg`) e painel deslizante.
 * Reproduz a nova hierarquia: Início · O Escritório · Áreas de Atuação
 * (6 núcleos) · Conteúdos (Artigos/Guias/Assuntos) · Contato + CTA WhatsApp.
 * Trava scroll, fecha no Escape, no overlay e ao navegar. DRY via navigation.ts.
 */
import { mainNav, areasMenu, conteudosMenu, contatoLink } from '@/lib/navigation';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
---

<div class="mobile" data-mobile-menu>
  <button class="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-panel">
    <svg aria-hidden="true" width="22" height="16" viewBox="0 0 22 16">
      <line x1="0" y1="1" x2="22" y2="1" stroke="currentColor" stroke-width="2"></line>
      <line x1="0" y1="8" x2="22" y2="8" stroke="currentColor" stroke-width="2"></line>
      <line x1="0" y1="15" x2="22" y2="15" stroke="currentColor" stroke-width="2"></line>
    </svg>
  </button>

  <div class="overlay" data-overlay hidden></div>

  <div class="panel" id="mobile-panel" role="dialog" aria-modal="true" aria-label="Navegação móvel" hidden>
    <button class="panel-close" type="button" aria-label="Fechar menu" data-close>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="2" fill="none"></path></svg>
    </button>
    <nav class="panel-nav" aria-label="Navegação móvel">
      {mainNav.map((l) => <a class="m-link" href={l.href}>{l.label}</a>)}

      <details class="m-acc">
        <summary class="m-acc-sum">
          <span>{areasMenu.label}</span>
          <svg class="m-chev" aria-hidden="true" width="12" height="8" viewBox="0 0 12 8"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        </summary>
        <div class="m-acc-body">
          <a class="m-sub" href={areasMenu.viewAll.href}>{areasMenu.viewAll.label}</a>
          {areasMenu.items.map((n) => <a class="m-sub" href={n.href}>{n.label}</a>)}
        </div>
      </details>

      <details class="m-acc">
        <summary class="m-acc-sum">
          <span>{conteudosMenu.label}</span>
          <svg class="m-chev" aria-hidden="true" width="12" height="8" viewBox="0 0 12 8"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        </summary>
        <div class="m-acc-body">
          {conteudosMenu.items.map((l) => <a class="m-sub" href={l.href}>{l.label}</a>)}
        </div>
      </details>

      <a class="m-link" href={contatoLink.href}>{contatoLink.label}</a>
    </nav>

    <div class="panel-cta">
      <a class="btn btn--on-dark panel-form" href="/contato/" data-cta-position="menu">Enviar meu caso</a>
      <WhatsAppButton />
    </div>
  </div>
</div>

<style>
  .mobile { display: flex; }
  @media (min-width: 1024px) { .mobile { display: none; } }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-navy);
    background: none;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }
  .burger:hover { background: var(--surface-cream); }

  /* z-index acima do banner de consentimento (1001) e do FAB do WhatsApp (50).
     O overlay e o painel são movidos para <body> via JS (ver script) para
     escapar do contexto de empilhamento e do containing-block criado pelo
     backdrop-filter do cabeçalho — sem isso o painel fixo colapsa para a
     altura do header. */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(6, 40, 28, 0.6);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    z-index: 1090;
    overscroll-behavior: contain;
  }

  .panel {
    position: fixed;
    /* Insets seguros (com suporte a notch do iPhone) — a altura é a distância
       entre top e bottom, então o painel nunca ultrapassa a tela e rola por
       dentro (overflow-y: auto). */
    top: max(0.6rem, env(safe-area-inset-top));
    right: max(0.6rem, env(safe-area-inset-right));
    bottom: max(0.6rem, env(safe-area-inset-bottom));
    width: min(88vw, 22rem);
    max-width: calc(100vw - 1.2rem);
    background: var(--color-navy);
    color: #fff;
    z-index: 1100;
    padding: 5rem 1.5rem 2rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }

  .panel-nav { display: flex; flex-direction: column; }
  .m-link {
    display: block;
    padding: var(--space-3) 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    border-bottom: 1px solid var(--border-on-dark);
  }
  .m-link:hover { color: var(--color-accent); }

  /* Grupos expansíveis nativos (<details>) — acessíveis por teclado e leitor de tela */
  .m-acc { border-bottom: 1px solid var(--border-on-dark); }
  .m-acc-sum {
    list-style: none;
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: rgba(255, 255, 255, 0.92);
    cursor: pointer;
  }
  .m-acc-sum::-webkit-details-marker { display: none; }
  .m-acc-sum:hover { color: var(--color-accent); }
  .m-chev { color: rgba(255, 255, 255, 0.55); transition: transform var(--dur) var(--ease); flex: none; }
  .m-acc[open] .m-chev { transform: rotate(180deg); }
  .m-acc-body { display: flex; flex-direction: column; padding-bottom: var(--space-2); }
  .m-sub {
    display: block;
    padding: var(--space-2) 0 var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    line-height: var(--leading-snug);
  }
  .m-sub:hover { color: var(--color-accent); }
  .panel-cta { margin-top: var(--space-6); display: grid; gap: var(--space-3); }
  .panel-form { justify-content: center; }
  .panel-close {
    position: absolute; top: 1rem; right: 1rem; width: 2.75rem; height: 2.75rem;
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: 0; border-radius: var(--radius-pill); color: #fff; cursor: pointer;
  }
  .panel-close:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>

<script>
  document.querySelectorAll('[data-mobile-menu]').forEach((root) => {
    const burger = root.querySelector('.burger') as HTMLButtonElement | null;
    const panel = root.querySelector('.panel') as HTMLElement | null;
    const overlay = root.querySelector('[data-overlay]') as HTMLElement | null;
    if (!burger || !panel || !overlay) return;

    // CORREÇÃO DO BUG DO MENU MOBILE
    // ------------------------------------------------------------------
    // O cabeçalho (.header-shell) usa backdrop-filter, o que o torna o
    // "containing block" de qualquer descendente position:fixed. Como o
    // painel e o overlay ficavam dentro do header, o painel fixo era
    // dimensionado em relação à pílula do cabeçalho (~64px) e colapsava,
    // exibindo só o primeiro item ("Início"); o overlay cobria apenas a
    // área do header. A correção definitiva é mover overlay e painel para
    // o final do <body>, fora do backdrop-filter e do stacking context do
    // header — assim o fixed passa a se referir à viewport (tela cheia).
    if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
    if (panel.parentElement !== document.body) document.body.appendChild(panel);

    // Trava de rolagem sem "pulo" de layout (compensa a barra de rolagem).
    const lockScroll = (lock: boolean) => {
      if (lock) {
        const sbw = window.innerWidth - document.documentElement.clientWidth;
        document.body.style.overflow = 'hidden';
        if (sbw > 0) document.body.style.paddingRight = sbw + 'px';
      } else {
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
      }
    };

    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      panel.hidden = !open;
      overlay.hidden = !open;
      lockScroll(open);
      if (open) {
        panel.scrollTop = 0;
        const first = panel.querySelector('a, button') as HTMLElement | null;
        first?.focus({ preventScroll: true });
      }
    };

    burger.addEventListener('click', () => setOpen(panel.hidden));
    overlay.addEventListener('click', () => setOpen(false));
    panel.querySelector('[data-close]')?.addEventListener('click', () => {
      setOpen(false);
      burger.focus();
    });
    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
      // Painel é um diálogo modal: o Tab circula só dentro dele.
      if ((e as KeyboardEvent).key === 'Tab' && !panel.hidden) {
        const focusables = [...panel.querySelectorAll<HTMLElement>('a[href], button, summary, input, select, textarea')].filter((el) => el.offsetParent !== null);
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const ev = e as KeyboardEvent;
        if (!panel.contains(document.activeElement)) {
          ev.preventDefault();
          first.focus();
        } else if (ev.shiftKey && document.activeElement === first) {
          ev.preventDefault();
          last.focus();
        } else if (!ev.shiftKey && document.activeElement === last) {
          ev.preventDefault();
          first.focus();
        }
      }
    });
    // Fecha ao seguir qualquer link do menu (inclui submenus <details>).
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    // Garante estado inicial fechado (após o portal).
    setOpen(false);
  });
</script>
