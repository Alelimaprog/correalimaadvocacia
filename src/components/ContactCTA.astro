---
/**
 * ContactCTA — bloco de conversão reutilizável para as páginas de conteúdo
 * (áreas via [slug], artigos do blog e guias) que usam o EntryPage e antes
 * não tinham chamada de contato ao final. Traz: convite curto, botão de
 * WhatsApp (mensagem contextual por página), atalho "Enviar meu caso" e o
 * formulário de contato global (mesmo ContactForm / Formspree usado em
 * /contato/). Segue o design system do site (tokens, cartões, verde).
 *
 * Reaproveita o ContactForm existente (data-contact-form), então os eventos
 * de Analytics (form_start/form_submit/generate_lead) já funcionam sem
 * duplicação — o redirect para /contato/obrigado/ só ocorre em /contato/.
 */
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import AuthorNote from '@/components/AuthorNote.astro';
import { site, whatsappHrefForPath } from '@/lib/site.config';

const waHref = whatsappHrefForPath(Astro.url.pathname);
---

<section class="ccta" aria-labelledby="ccta-title">
  <div class="ccta-card" data-reveal>
    <div class="ccta-info">
      <p class="ccta-eyebrow">/ Fale com o escritório</p>
      <h2 id="ccta-title" class="ccta-title">Quer entender como isso se aplica ao seu caso?</h2>
      <p class="ccta-lead">Conte em poucas linhas o que aconteceu. O envio não representa contratação nem promessa de resultado.</p>
      <AuthorNote />

      <div class="ccta-actions">
        <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener noreferrer" data-cta-position="content-cta">
          <Icon name="whatsapp" size={18} /> Falar no WhatsApp
        </a>
      </div>
    </div>

    <div class="ccta-form-panel">
      <ContactForm />
    </div>
  </div>
</section>

<style>
  @media (max-width: 600px) { .ccta-actions :global(.btn) { width: 100%; justify-content: center; } }
  .ccta { margin-top: var(--space-10); }
  .ccta-card {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    border-top: 2px solid var(--color-accent);
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  @media (min-width: 900px) {
    .ccta-card { grid-template-columns: 1fr 1fr; align-items: start; }
  }

  .ccta-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .ccta-title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }
  .ccta-lead {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    max-width: 40ch;
  }
  .ccta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .ccta-actions .btn { gap: 0.45rem; }

  .ccta-channels { margin-top: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .ccta-channels li { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-sm); color: var(--color-text); min-width: 0; overflow-wrap: anywhere; }
  .ccta-channels a { color: var(--color-navy); text-decoration: none; }
  .ccta-channels a:hover { text-decoration: underline; }
  .ccta-ic {
    display: inline-flex; height: 2rem; width: 2rem; flex: none;
    align-items: center; justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border); background: transparent; color: var(--color-accent);
  }

  .ccta-info { min-width: 0; }
  .ccta-form-panel { min-width: 0; }
  .ccta-form-panel :global(.cform) { max-width: none; }
</style>
