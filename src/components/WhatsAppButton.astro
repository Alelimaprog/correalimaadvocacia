---
/**
 * WhatsAppButton — botão de contato por WhatsApp, com ícone e a mensagem
 * pré-preenchida (site.config). O clique é rastreado automaticamente como
 * `click_whatsapp` pelo Analytics global (que detecta links wa.me).
 *
 * variant: 'pill' (verde, como no header) | 'inline' (link discreto).
 */
import { whatsappHref } from '@/lib/site.config';

interface Props {
  label?: string;
  variant?: 'pill' | 'inline';
  class?: string;
}
const { label = 'Falar no WhatsApp', variant = 'pill', class: cls } = Astro.props;
---

<a
  class:list={['wa', `wa--${variant}`, cls]}
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none">
    <path
      d="M17.6 6.4A8.9 8.9 0 0012 4a8.94 8.94 0 00-7.75 13.4L3 21l3.7-1.2A8.94 8.94 0 0012 21a8.94 8.94 0 006.3-15.6z"
      stroke="currentColor"
      stroke-width="1.6"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  /* O verde da marca WhatsApp fica reservado ao atalho flutuante, onde é
     identidade de canal. Aqui o botão veste a linguagem do site. */
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .wa--pill {
    min-height: 3rem;
    padding: 0.8rem 1.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink);
  }
  .wa--pill:hover { background: var(--surface-warm); border-color: var(--color-ink); }

  .wa--inline { color: inherit; }
  .wa--inline:hover { color: var(--color-accent); }
</style>
