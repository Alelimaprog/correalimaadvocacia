---
/**
 * WhatsAppButton — botão de contato por WhatsApp, com ícone e a mensagem
 * pré-preenchida (site.config). O clique é rastreado automaticamente como
 * `click_whatsapp` pelo Analytics global (que detecta links wa.me).
 *
 * variant: 'solid' (pastilha sóbria) | 'inline' (link discreto).
 *
 * A variante antiga era uma pastilha verde-WhatsApp totalmente arredondada, com
 * sombra colorida e elevação no hover. Num site institucional ela era o ponto
 * mais saturado da página e puxava o conjunto para o registro de landing page.
 * O canal continua — muda o traje: retângulo de contorno, na cor do texto ao
 * redor, com o ícone como único sinal da plataforma. 'pill' segue aceito como
 * apelido de 'solid' para não quebrar chamadas existentes.
 */
import { whatsappHrefForPath } from '@/lib/site.config';

interface Props {
  label?: string;
  variant?: 'solid' | 'pill' | 'inline';
  class?: string;
}
const { label = 'Falar no WhatsApp', variant = 'solid', class: cls } = Astro.props;
const estilo = variant === 'inline' ? 'inline' : 'solid';
---

<a
  class:list={['wa', `wa--${estilo}`, cls]}
  href={whatsappHrefForPath(Astro.url.pathname)}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none">
    <path
      d="M17.6 6.4A8.9 8.9 0 0012 4a8.94 8.94 0 00-7.75 13.4L3 21l3.7-1.2A8.94 8.94 0 0012 21a8.94 8.94 0 006.3-15.6z"
      stroke="currentColor"
      stroke-width="1.6"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .wa--solid {
    min-height: 3rem;
    padding: 0 1.5rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    color: inherit;
    font-family: var(--font-ui);
    letter-spacing: 0.01em;
  }
  .wa--solid:hover { background: rgba(255, 255, 255, 0.08); }
  .wa--solid:focus-visible { outline: 2px solid var(--color-accent-soft); outline-offset: 3px; }
  .wa--inline { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .wa--inline:hover { color: var(--color-accent); }
</style>
