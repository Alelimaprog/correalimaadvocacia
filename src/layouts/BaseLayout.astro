---
/**
 * BaseLayout — casca HTML única de todas as páginas.
 * Head via componente SEO (aceita o `head` fiel capturado do export, ou props
 * simples). Tipografia (Google Fonts), favicons, manifest, rastreamento e chrome
 * (Header/Footer via componentes). JSON-LD por página entra pelo slot "jsonld".
 */
// ETAPA 12 — fontes auto-hospedadas (sem dependência do Google Fonts).
// Apenas o subconjunto latino e os pesos realmente usados (400/500/600/700),
// todos com font-display: swap. Os arquivos .woff2 são versionados no build.
// Serif institucional para títulos. Substitui a Manrope (grotesca), que dava ao
// site a leitura de produto de tecnologia.
//
// O peso 700 da serifa foi acrescentado nesta rodada: 42 regras pediam
// font-weight 700 com font-family de display, e a família só trazia 400 e 600.
// O navegador cobria a lacuna SINTETIZANDO o negrito — engrossa o traço por
// software, borra as serifas e é um dos sinais mais reconhecíveis de tipografia
// mal montada. Agora o peso existe de verdade.
//
// Em compensação, a Inter 700 saiu: fora dos títulos, o 700 era usado só em
// rótulos e etiquetas, que passam a 600 — peso que já estava sendo baixado.
// Saldo de rede: praticamente neutro.
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-serif-4/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
// URLs com hash dos arquivos de fonte, para a pré-carga no <head>.
import serif600 from '@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/ui.css';
import '@/styles/prose.css';
import '@/styles/content-editorial.css';
import '@/styles/content-index.css';
import '@/styles/areas-hero.css';
import '@/styles/institucional.css';
import '@/styles/first-fold.css';
import SEO from '@/components/SEO.astro';
import Analytics from '@/components/Analytics.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { site } from '@/lib/site.config';
import type { PageHead } from '@/lib/institucional';

interface Props {
  head?: PageHead;
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  noCanonical?: boolean;
  /** Rodada 3 (A5): oculta a faixa de CTA do rodapé onde a página já termina em contato. */
  footerCta?: boolean;
}
const { head, title, description, canonical, noindex, noCanonical, footerCta = true } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <!-- Marca que o JavaScript está vivo ANTES da primeira pintura. O estado
         escondido da animação de entrada (.js [data-reveal]) depende desta
         classe: sem ela, o conteúdo aparece normalmente em vez de ficar
         invisível esperando um script que pode nunca rodar. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    {site.analytics.searchConsoleVerification && (
      <meta name="google-site-verification" content={site.analytics.searchConsoleVerification} />
    )}

    <SEO
      head={head}
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      noCanonical={noCanonical}
    />

    {/* Tipografia — Manrope + Inter auto-hospedadas (import no topo, sem
        requisição externa ao Google Fonts). font-display: swap embutido. */}

    {/* Favicons e manifest (martelo verde) — ?v= força atualização de cache */}
    {/*
      Pré-carga das duas faces que a primeira tela usa: a serifa 600 do h1 e a
      Inter 400 do corpo. Sem isto o navegador só descobre as fontes depois de
      baixar e interpretar o CSS, e o texto pisca na troca da fonte de sistema
      pela definitiva. As demais faces continuam em carga normal.
    */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={serif600} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={inter400} />

    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16x16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Conteúdos — Corrêa Lima Advocacia" href="/rss.xml" />

    {/* Dados estruturados por página */}
    <slot name="jsonld" />

    <Analytics />
  </head>
  <body>
    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <slot />
    <Footer showCta={footerCta} />
    <aside aria-label="WhatsApp do escritório"><FloatingWhatsApp /></aside>
    <ConsentBanner />
    <script>
      // Revelação sutil ao rolar — aplica-se a [data-reveal] e, de forma
      // automática, aos cartões/itens repetidos usados em todo o site
      // (áreas, guias, blog, FAQ etc.), sem exigir alteração de cada página.
      // Sem dependências externas; respeita prefers-reduced-motion (base.css).
      const AUTO_SELECTOR = [
        '.ncard', '.destaque', '.conteudo', '.dif', '.problem-grid li',
        '.faq-item', '.rel a', '.risk-grid li', '.card',
        '.p-hero-card', '.tl-step',
      ].join(',');

      document.querySelectorAll(AUTO_SELECTOR).forEach((el) => {
        if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', '');
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${Math.min(i % 6, 5) * 60}ms`;
        io.observe(el);
      });
    </script>
  </body>
</html>
