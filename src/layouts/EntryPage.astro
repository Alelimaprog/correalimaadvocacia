---
/**
 * EntryPage — layout das páginas-filhas (áreas, artigos e guias).
 *
 * Antes, o corpo renderizado do Markdown caía numa coluna estreita colada à
 * esquerda, deixando metade da tela vazia em 1440 e sem nenhuma abertura: a
 * página começava direto no H1, dentro da prosa. Agora há uma faixa de
 * abertura (trilha + rótulo + título + lead), uma coluna de leitura centrada e
 * um sumário lateral construído a partir dos próprios H2 do conteúdo — que só
 * aparece quando há seções suficientes para justificá-lo.
 *
 * O H1 e o primeiro parágrafo saem do Markdown e sobem para a abertura: é o
 * mesmo texto, lido uma vez só, no lugar onde a página efetivamente começa.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { PageHead } from '@/lib/institucional';
import type { Crumb } from '@/components/Breadcrumb.astro';

interface Props {
  head: PageHead;
  jsonld: Record<string, unknown>[];
  crumbs: Crumb[];
  /** Rótulo curto acima do título (a banda ou a seção de origem). */
  eyebrow?: string;
  /** Título e lead da abertura — quando ausentes, o Markdown os fornece. */
  titulo?: string;
  lead?: string;
  /** Data e tempo de leitura, nos artigos. */
  meta?: string;
}
const { head, jsonld, crumbs, eyebrow, titulo, lead, meta } = Astro.props;
---

<BaseLayout head={head}>
  <Fragment slot="jsonld">
    {jsonld.map((schema) => <JsonLd schema={schema} />)}
  </Fragment>

  <main id="conteudo-principal" class="entry">
    <header class="entry-topo">
      <div class="entry-wrap">
        {crumbs.length > 0 && <Breadcrumb items={crumbs} class="entry-crumb" />}
        {eyebrow && <p class="entry-eyebrow">{eyebrow}</p>}
        {titulo && <h1 class="entry-h1">{titulo}</h1>}
        {lead && <p class="entry-lead">{lead}</p>}
        {meta && <p class="entry-meta">{meta}</p>}
      </div>
    </header>

    <div class="entry-corpo">
      <div class="entry-wrap entry-grid">
        <nav class="entry-sumario" aria-labelledby="sumario-t" data-sumario hidden>
          <p class="entry-sumario-t" id="sumario-t">Nesta página</p>
          <ol></ol>
        </nav>

        <article class="prose" data-conteudo>
          <slot />
        </article>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .entry-wrap {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  /* ── Abertura ─────────────────────────────────────────────────────── */
  .entry-topo {
    padding-block: var(--section-y-sm) var(--section-y-sm);
    border-bottom: 1px solid var(--color-border);
  }
  :global(.entry-crumb) { margin-bottom: var(--space-8); }
  .entry-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-subtle);
  }
  .entry-h1 {
    margin-top: var(--space-4);
    font-size: var(--text-5xl);
    color: var(--color-ink);
    max-width: 20ch;
  }
  .entry-lead {
    margin-top: var(--space-6);
    max-width: 54ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }
  .entry-meta {
    margin-top: var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* ── Corpo ────────────────────────────────────────────────────────── */
  .entry-corpo { padding-block: var(--section-y); }
  /* `minmax(0, 1fr)` e não `1fr`: um item de grade tem `min-width: auto` por
     omissão, e por isso uma tabela larga empurrava a coluna de leitura para
     além da tela em vez de rolar dentro do próprio contêiner. */
  .entry-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-10); }
  /* O sumário só ganha coluna própria onde cabe sem apertar a leitura. */
  @media (min-width: 1100px) {
    .entry-grid { grid-template-columns: 15rem minmax(0, 1fr); gap: var(--space-16); }
  }

  .entry-sumario { align-self: start; }
  @media (min-width: 1100px) {
    .entry-sumario { position: sticky; top: calc(var(--altura-cabecalho) + var(--space-8)); }
  }
  .entry-sumario-t {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-subtle);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .entry-sumario ol {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
  }
  .entry-sumario :global(a) {
    display: block;
    padding: 0.4rem 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    text-decoration: none;
    border-left: 1px solid transparent;
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .entry-sumario :global(a:hover) { color: var(--color-ink); }
  .entry-sumario :global(a.is-ativo) { color: var(--color-ink); border-left-color: var(--color-accent); }
</style>

<script>
  // Sumário montado a partir dos H2 do próprio conteúdo. Sem seções suficientes
  // para orientar a leitura, o bloco não aparece — um sumário de dois itens
  // ocupa coluna sem resolver nada.
  const MINIMO = 3;
  const sumario = document.querySelector('[data-sumario]') as HTMLElement | null;
  const conteudo = document.querySelector('[data-conteudo]');
  if (sumario && conteudo) {
    const titulos = Array.from(conteudo.querySelectorAll('h2'));
    if (titulos.length >= MINIMO) {
      const lista = sumario.querySelector('ol')!;
      titulos.forEach((h, i) => {
        if (!h.id) {
          const base = (h.textContent || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
          h.id = base || `secao-${i + 1}`;
        }
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        li.append(a);
        lista.append(li);
      });
      sumario.hidden = false;

      // Marca a seção em leitura. rootMargin recorta a faixa superior da tela
      // para que o título ativo seja o que está sendo lido, não o que acabou
      // de sair por cima.
      const links = new Map(
        Array.from(lista.querySelectorAll('a')).map((a) => [a.getAttribute('href')!.slice(1), a]),
      );
      const io = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              links.forEach((a) => a.classList.remove('is-ativo'));
              links.get(e.target.id)?.classList.add('is-ativo');
            }
          }
        },
        { rootMargin: '-20% 0px -70% 0px' },
      );
      titulos.forEach((h) => io.observe(h));
    }
  }
</script>
